FREE_MEMORY_WAIT_S = 15


def free_memory(launch_dir, app_id, wait=FREE_MEMORY_WAIT_S, poll=0.1):
    """Asks the app (SessionService, FreeMemory) to close other apps' background processes before the game starts and
    waits for its answer, which starts with the request's token."""
    if not launch_dir or not os.path.isdir(launch_dir):
        return "no launch directory"
    token = "%s-%s" % (re.sub(r"[^A-Za-z0-9_]", "", str(app_id))[:40] or "game", os.urandom(8).hex())
    done = os.path.join(launch_dir, "free-memory-done")
    staged = os.path.join(launch_dir, "free-memory.tmp")
    try:
        with open(staged, "w", encoding="utf-8") as out:
            out.write(token + "\n")
        os.replace(staged, os.path.join(launch_dir, "free-memory"))
    except OSError as error:
        return "not asked (%s)" % error
    deadline = time.monotonic() + wait
    while True:
        try:
            with open(done, encoding="utf-8") as source:
                answer = source.read().strip()
        except OSError:
            answer = ""
        mine, _, summary = answer.partition(" ")
        if mine == token:
            try:
                os.unlink(done)
            except OSError:
                pass
            return summary or "done"
        if time.monotonic() >= deadline:
            return "no answer in %d s" % wait
        time.sleep(poll)


def experiment_name(experiment):
    return "DROIDDECK_EXP_" + experiment.upper().replace("-", "_")


def experiment(env, name):
    return (env or {}).get(experiment_name(name)) == "1"


def experiments(env):
    return [name for name in EXPERIMENTS if experiment(env, name)]


def without_experiments(env):
    return {k: v for k, v in env.items() if not k.startswith("DROIDDECK_EXP_")}


# Their effect is fixed when the session starts (the app, droiddeck-session and Steam's scripts); memory is split:
# its game part follows the saved switches and its app part the session's.
SESSION_EXPERIMENTS = ("all", "compat-quiet", "adpf-all", "two-frames", "layer-fence", "quick-tap",
                       "hybris-index-session", "composite-timing")


def experiments_line(saved, session):
    """The switches in effect for this launch: game-level ones from the saved config, session-level ones from the
    Steam session's environment, then the session-level ones saved differently, which need a new session."""
    on, pending = [], []
    for name in EXPERIMENTS:
        game, app = name in saved, name in session
        if name == "memory":
            if game or app:
                on.append("memory" if game and app else "memory(game)" if game else "memory(app)")
            if game != app:
                pending.append("memory(app) " + ("on" if game else "off"))
        elif name in SESSION_EXPERIMENTS:
            if app:
                on.append(name)
            if game != app:
                pending.append(name + (" on" if game else " off"))
        elif game:
            on.append(name)
    line = "experiments: " + (",".join(on) or "none")
    if pending:
        line += "; saved but needs a new session: " + ", ".join(pending)
    return line


def dotnet_fex(env):
    for name, values, described in DOTNET_FEX_EXPERIMENTS:
        if experiment(env, name):
            return dict(DOTNET_FEX, **values), ".NET runtime: FEX with TSO, %s (experiment %s)" % (described, name)
    return DOTNET_FEX, ".NET runtime: FEX with full TSO"


def game_files(exe):
    names = set()
    folder = os.path.dirname(exe)
    try:
        with os.scandir(folder) as top:
            for entry in top:
                names.add(entry.name.lower())
                if entry.is_dir(follow_symlinks=False):
                    try:
                        with os.scandir(entry.path) as inner:
                            names.update(e.name.lower() for e in inner)
                    except OSError:
                        pass
    except OSError:
        pass
    return names


class Game:

    def __init__(self, exe, args, env=None):
        self.exe = exe
        self.args = args
        self.env = env or {}
        self.stem = os.path.splitext(os.path.basename(exe))[0].lower()
        self.files = game_files(exe)
        self._godot = None

    def has_arg(self, name):
        return any(a == name or a.startswith(name + "=") for a in self.args)

    def godot(self):
        """Version and project settings read from the game's Godot data pack; empty when unreadable."""
        if self._godot is None:
            if self.exe not in GODOT_PROJECTS:
                try:
                    GODOT_PROJECTS[self.exe] = godot_project(self.exe) or {}
                except (OSError, ValueError, struct.error):
                    GODOT_PROJECTS[self.exe] = {}
            self._godot = GODOT_PROJECTS[self.exe]
        return self._godot


GODOT_PROJECTS = {}


PCK_MAGIC = 0x43504447
GODOT_SETTINGS = {
    "application/config/name", "application/config/use_custom_user_dir", "application/config/custom_user_dir_name",
    "rendering/renderer/rendering_method", "rendering/rendering_device/driver", "rendering/rendering_device/driver.windows",
    "debug/file_logging/log_path",
}


def godot_pack_start(source):
    """Offset of a Godot pack header: at the start of a .pck, or the pack appended to an executable."""
    source.seek(0)
    if source.read(4) == struct.pack("<I", PCK_MAGIC):
        return 0
    end = source.seek(0, 2)
    if end < 16:
        return None
    source.seek(end - 12)
    size, magic = struct.unpack("<QI", source.read(12))
    start = end - 12 - size
    if magic != PCK_MAGIC or start < 0:
        return None
    source.seek(start)
    return start if source.read(4) == struct.pack("<I", PCK_MAGIC) else None


def godot_variant(data):
    """The bool, int and string Variants of Godot's binary encoding (core/io/marshalls.cpp)."""
    if len(data) < 8:
        return None
    header, = struct.unpack_from("<I", data)
    kind = header & 0xFF
    if kind == 1:
        return bool(struct.unpack_from("<I", data, 4)[0])
    if kind == 2:
        return struct.unpack_from("<q" if header & 1 << 16 else "<i", data, 4)[0]
    if kind == 4:
        length, = struct.unpack_from("<I", data, 4)
        return data[8:8 + length].decode("utf-8", "replace")
    return None


def godot_settings(data):
    """Selected entries of an exported project.binary ("ECFG", count, then key and Variant pairs)."""
    if data[:4] != b"ECFG":
        return {}
    count, = struct.unpack_from("<I", data, 4)
    position, settings = 8, {}
    for _ in range(min(count, 1 << 20)):
        length, = struct.unpack_from("<I", data, position)
        key = data[position + 4:position + 4 + length].decode("utf-8", "replace")
        position += 4 + length
        length, = struct.unpack_from("<I", data, position)
        if key in GODOT_SETTINGS:
            settings[key] = godot_variant(data[position + 4:position + 4 + length])
        position += 4 + length
    return settings


def godot_project(exe):
    """Engine version and settings of a Godot 4 game, read as core/io/file_access_pack.cpp opens its pack:
    the pack inside the executable first, then <exe stem>.pck beside it."""
    folder, name = os.path.split(exe)
    candidates = [exe]
    stem = os.path.splitext(name)[0].lower()
    try:
        with os.scandir(folder or ".") as entries:
            candidates += sorted(e.path for e in entries if e.name.lower() in (stem + ".pck", name.lower() + ".pck"))
    except OSError:
        pass
    for path in candidates:
        try:
            with open(path, "rb") as source:
                start = godot_pack_start(source)
                if start is None:
                    continue
                return godot_pack_project(source, start, path)
        except OSError:
            continue
    return None


def godot_pack_project(source, start, path):
    source.seek(start + 4)
    version, major, minor, patch, flags, file_base = struct.unpack("<5IQ", source.read(28))
    project = {"version": (major, minor, patch), "pack": path}
    if version not in (2, 3) or flags & 1:
        return project
    if version == 3 or flags & 2:
        file_base += start
    if version == 3:
        source.seek(start + struct.unpack("<Q", source.read(8))[0])
    else:
        source.seek(64, 1)
    count, = struct.unpack("<I", source.read(4))
    for _ in range(min(count, 1 << 21)):
        length, = struct.unpack("<I", source.read(4))
        if length > 4096:
            break
        name = source.read(length).rstrip(b"\0")
        offset, size, _, _, entry_flags = struct.unpack("<QQ8s8sI", source.read(36))
        if name in (b"res://project.binary", b"project.binary"):
            if not entry_flags & 3 and size <= 1 << 22:
                source.seek(file_base + offset)
                project["settings"] = godot_settings(source.read(size))
            break
    return project


FIXES = []


def fix(function):
    FIXES.append(function)
    return function


def is_godot(game):
    return game.stem + ".pck" in game.files or "godotsharp.dll" in game.files


@fix
def dotnet_memory_ordering(game):
    if "coreclr.dll" in game.files:
        values, note = dotnet_fex(game.env)
        return values, [], note


# docs/research/dotnet-runtime.md. Workstation GC sizes gen0 from the largest CPU cache Windows reports
# (GetLogicalProcessorInformation, which Wine fills from sysfs) and caps it at 6 MB while background GC is on,
# so a game may collect every few MB; each collection suspends every managed thread through Wine.
# 64 MB cut the phone's ~50 gen1 collections a minute to one every minute or two, but each then compacted
# 20-34 MB of survivors in one 120-170 ms pause (a7526bd, Nov 14); at about 5-10 ms per surviving MB, 8 MB
# should keep each pause near the old p99 (~30 ms) while dropping most of the per-collection overhead.
DOTNET_GEN0_BYTES = 8 << 20


@fix
def dotnet_runtime_experiments(game):
    if "coreclr.dll" not in game.files:
        return None
    values, said = {}, []
    if experiment(game.env, "dotnet-gen0"):
        values["DOTNET_GCgen0size"] = "%x" % DOTNET_GEN0_BYTES
        said.append("gen0 budget %d MB (dotnet-gen0)" % (DOTNET_GEN0_BYTES >> 20))
    if experiment(game.env, "dotnet-gc-stock"):
        values.update({"DOTNET_gcConcurrent": "1", "DOTNET_GCConserveMemory": "0"})
        said.append("stock GC: background GC on, no conserve-memory compaction (dotnet-gc-stock)")
    if values:
        return values, [], ".NET runtime: " + "; ".join(said)
    return None


@fix
def unity_memory_ordering(game):
    if {"unityplayer.so", "gameassembly.so", "unityplayer.dll"} & game.files:
        return {"FEX_TSOENABLED": "1"}, [], "Unity: FEX with TSO"


GODOT_RENDERER = "DROIDDECK_GODOT_RENDERER"
GODOT_RENDERERS = ("auto", "mobile", "forward_plus", "vulkan", "off")
GODOT_RD_METHODS = ("forward_plus", "mobile")


def powervr(env):
    return env.get("HYBRIS_VULKAN_HAL", "").endswith("/vulkan.powervr.so")


def godot_renderer_choice(game):
    choice = game.env.get(GODOT_RENDERER, "").strip().lower() or "auto"
    return choice if choice in GODOT_RENDERERS else "auto"


@fix
def godot_vulkan(game):
    """Godot 4 draws through Vulkan straight to the device's driver. Its D3D12 driver, which some games
    (Slay the Spire 2) pick on Windows, needs vkd3d-proton and shows a black window there."""
    if not is_godot(game):
        return None
    if not experiment(game.env, "godot-render"):
        if not game.has_arg("--rendering-driver"):
            return {}, ["--rendering-driver", "vulkan"], "Godot: Vulkan renderer"
        return None
    choice = godot_renderer_choice(game)
    project = game.godot()
    version = project.get("version")
    if choice == "off" or (version and version[0] != 4):
        return None
    settings = project.get("settings", {})
    own_method = settings.get("rendering/renderer/rendering_method", "forward_plus" if "settings" in project else None)
    own_driver = settings.get("rendering/rendering_device/driver.windows",
                              settings.get("rendering/rendering_device/driver", "vulkan" if "settings" in project else None))
    described = "Godot %s" % ".".join(map(str, version)) if version else "Godot"
    if own_method:
        described += " (project: %s on %s)" % (own_method, own_driver if own_method in GODOT_RD_METHODS else "OpenGL")
    extra = []
    if game.has_arg("--rendering-driver"):
        return {}, [], described + ": renderer left to the launch options"
    shown = None
    if game.has_arg("--rendering-method"):
        shown = next((game.args[i + 1] for i, a in enumerate(game.args[:-1]) if a == "--rendering-method"), "")
        if shown not in GODOT_RD_METHODS:
            return {}, [], described + ": renderer left to the launch options"
        target = None
    elif choice in GODOT_RD_METHODS:
        target = choice
    elif choice == "auto" and own_method in GODOT_RD_METHODS:
        # Mobile keeps 2D back-buffer copies and blurs in raster passes, the path Godot built for tiled GPUs;
        # Forward+ runs them as compute dispatches between raster passes.
        target = "mobile" if powervr(game.env) else own_method
    else:
        target = None
    if target:
        extra += ["--rendering-method", target]
    extra += ["--rendering-driver", "vulkan"]
    # Without --rendering-method, Godot's main.cpp picks forward_plus for any RenderingDevice driver.
    shown = target or shown or "forward_plus"
    return {}, extra, "%s: %s on Vulkan (%s=%s)" % (described, shown, GODOT_RENDERER, choice)


@fix
def godot_sentry(game):
    sentry = sorted(n[:-4] for n in game.files if n.startswith("libsentry.windows.") and n.endswith(".dll"))
    if is_godot(game) and sentry and ("coreclr.dll" in game.files or "godotsharp.dll" in game.files):
        return {"WINEDLLOVERRIDES": ";".join(n + "=d" for n in sentry)}, [], "Godot: Sentry crash handler off"


def pe_imports(path):
    """Lower-case DLL names in a PE file's import and delay-import tables."""
    with open(path, "rb") as source:
        def read(offset, size):
            source.seek(offset)
            data = source.read(size)
            if len(data) < size:
                raise ValueError("truncated PE file")
            return data

        if read(0, 2) != b"MZ":
            return set()
        pe, = struct.unpack("<I", read(0x3C, 4))
        if read(pe, 4) != b"PE\0\0":
            return set()
        count, optional_size = struct.unpack("<2xH12xH2x", read(pe + 4, 20))
        optional = pe + 24
        magic, = struct.unpack("<H", read(optional, 2))
        if magic not in (0x10B, 0x20B):
            return set()
        directories = optional + (96 if magic == 0x10B else 112)
        listed, = struct.unpack("<I", read(directories - 4, 4))
        sections = [struct.unpack("<8xIIII", read(optional + optional_size + 40 * i, 24)) for i in range(min(count, 96))]

        def offset(rva):
            for virtual_size, address, raw_size, raw in sections:
                if address <= rva < address + max(virtual_size, raw_size):
                    return raw + rva - address
            raise ValueError("address outside the PE sections")

        names = set()
        # Import descriptors are 20 bytes with the name at 12; delay-load descriptors are 32 bytes with it at 4.
        for index, size, field in ((1, 20, 12), (13, 32, 4)):
            if index >= min(listed, 16):
                continue
            rva, = struct.unpack("<I", read(directories + 8 * index, 4))
            if not rva:
                continue
            start = offset(rva)
            for number in range(4096):
                name, = struct.unpack_from("<I", read(start + size * number, size), field)
                if not name:
                    break
                source.seek(offset(name))
                names.add(source.read(260).split(b"\0", 1)[0].decode("ascii", "replace").lower())
        return names


def accesskit_source(game):
    """Where a Godot 4.5+ Windows build gets AccessKit: linked in (the executable then imports UIAutomationCore.dll,
    platform/windows/detect.py) or accesskit[.<arch>].dll beside it (drivers/accesskit/accessibility_driver_accesskit.cpp)."""
    folder = os.path.dirname(game.exe)
    for name in ("accesskit.x86_64.dll", "accesskit.dll"):
        if os.path.isfile(os.path.join(folder, name)):
            return name
    try:
        imports = pe_imports(game.exe)
    except (OSError, ValueError, struct.error):
        return None
    return "%s imports UIAutomationCore.dll" % os.path.basename(game.exe) if "uiautomationcore.dll" in imports else None


@fix
def godot_accessibility(game):
    """Proton's explorer.exe starts tabtip.exe in every prefix, and tabtip follows focus through UI Automation. Its first
    WM_GETOBJECT makes AccessKit hand it the window's provider, and its calls then run inside the game over COM, where
    Slay the Spire 2 faults and exits. --accessibility disabled keeps AccessKit off the window and tabtip.exe=d keeps tabtip
    from starting; tabtip only opens Steam's keyboard when SteamDeck=1, and nothing here reads UI Automation."""
    if not is_godot(game):
        return None
    source = accesskit_source(game)
    if not source:
        return None
    if game.has_arg("--accessibility"):
        mode = next((game.args[i + 1] for i, a in enumerate(game.args[:-1]) if a == "--accessibility"), "")
        return ({"WINEDLLOVERRIDES": "tabtip.exe=d"}, [],
                "godot accessibility: %s from the launch options, tabtip.exe=d (AccessKit: %s)" % (mode or "set", source))
    return ({"WINEDLLOVERRIDES": "tabtip.exe=d"}, ["--accessibility", "disabled"],
            "godot accessibility: off (--accessibility disabled, tabtip.exe=d; AccessKit: %s)" % source)


@fix
def slay_the_spire_2_pacing(game):
    if game.stem == "slaythespire2" and is_godot(game) and experiment(game.env, "sched"):
        return ({"DROIDDECK_GAME_CPU_BUDGET": "big", "DROIDDECK_FPS_CAP": "60"}, [],
                "Slay the Spire 2: game threads kept off the little cores, 60 fps cap "
                "(DROIDDECK_GAME_CPU_BUDGET=all or DROIDDECK_FPS_CAP=0 in the game's environment undoes them)")



    "FEX_X87REDUCEDPRECISION": "0",
}
# The four memory-ordering experiments for .NET games; the app lets at most one be on.
DOTNET_FEX_EXPERIMENTS = (
    ("fex-memcpy-tso", {"FEX_MEMCPYSETTSOENABLED": "0"}, "memcpy/memset TSO off"),
    ("fex-vector-tso", {"FEX_VECTORTSOENABLED": "0"}, "vector TSO off"),
    ("fex-tso", {"FEX_VECTORTSOENABLED": "0", "FEX_MEMCPYSETTSOENABLED": "0"}, "vector and memcpy/memset TSO off"),
    ("fex-fast", {"FEX_VECTORTSOENABLED": "0", "FEX_MEMCPYSETTSOENABLED": "0", "DOTNET_gcConcurrent": "0"},
     "vector and memcpy/memset TSO off, background GC off"),
)

# Settings > Advanced > Experiments, one DROIDDECK_EXP_<NAME>=1 each. The game-level parts follow the
# saved settings at each launch; the Steam-side parts follow the values the Steam session started with.
EXPERIMENTS = ("godot-render", "warmup", "all", "compat-quiet", "memory", "adpf-all", "two-frames", "layer-fence",

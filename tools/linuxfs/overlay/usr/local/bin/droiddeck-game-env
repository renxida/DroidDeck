def fex_memory_model(command, env):
    try:
        module = runpy.run_path(str(Path(__file__).resolve().parent / "droiddeck-fex-memory"))
        env, notes = module["launch"](command, env)
    except (OSError, ValueError, KeyError) as error:
        return env, ["FEX memory model not checked (%s)" % error]
    return env, notes


def skip_red_launcher(command):
    if len(command) > 2 and os.path.basename(command[2]).lower() == "redprelauncher.exe":
        game = os.path.join(os.path.dirname(command[2]), "bin", "x64", "Cyberpunk2077.exe")
        if os.path.isfile(game):
            print("droiddeck-game-env: REDlauncher skipped", file=sys.stderr)
            return command[:2] + [game] + command[3:]
    return command


UBISOFT_LAUNCHER = "drive_c/Program Files (x86)/Ubisoft/Ubisoft Game Launcher"
UBISOFT_SETTINGS = "drive_c/users/steamuser/AppData/Local/Ubisoft Game Launcher/settings.yaml"


def overlay_off(text):
    lines = text.splitlines()
    try:
        start = next(i for i, line in enumerate(lines) if re.fullmatch(r"overlay:\s*(#.*)?", line))
    except StopIteration:
        if lines and not lines[-1].strip():
            lines.pop()
        return "\n".join(lines + ["overlay:", "  enabled: false", "  warning_enabled: false"]) + "\n"
    end = start + 1
    for index in range(start + 1, len(lines)):
        if lines[index].strip() and not lines[index].startswith("  "):
            break
        if lines[index].strip():
            end = index + 1
    block = lines[start + 1:end]
    for key in ("enabled", "warning_enabled"):
        entry = "  %s: false" % key
        found = [i for i, line in enumerate(block) if line.split(":", 1)[0] == "  " + key]
        if found:
            block[found[0]] = entry
        else:
            block.append(entry)
    return "\n".join(lines[:start + 1] + block + lines[end:]) + "\n"


def ubisoft_overlay_off(env):
    prefix = Path(env.get("STEAM_COMPAT_DATA_PATH", "/nonexistent")) / "pfx"
    if not (prefix / UBISOFT_LAUNCHER).is_dir():
        return
    settings = prefix / UBISOFT_SETTINGS
    try:
        text = settings.read_text(encoding="utf-8") if settings.exists() else ""
        updated = overlay_off(text)
        if updated == text:
            return
        settings.parent.mkdir(parents=True, exist_ok=True)
        handle, staged = tempfile.mkstemp(prefix=".settings-", dir=settings.parent)
        try:
            with os.fdopen(handle, "w", encoding="utf-8") as target:
                target.write(updated)
            if settings.exists():
                os.chmod(staged, settings.stat().st_mode & 0o7777)
            os.replace(staged, settings)
        except BaseException:
            os.unlink(staged)
            raise
        print("droiddeck-game-env: Ubisoft Connect overlay turned off", file=sys.stderr)
    except (OSError, UnicodeDecodeError) as error:
        print("droiddeck-game-env: Ubisoft Connect overlay left as is (%s)" % error, file=sys.stderr)


def ubisoft_composition_off(proton, env):
    prefix = Path(env.get("STEAM_COMPAT_DATA_PATH", "/nonexistent")) / "pfx"
    if not (prefix / UBISOFT_LAUNCHER).is_dir() or not (prefix / "user.reg").is_file():
        return
    try:
        for program in ("upc.exe", "UplayWebCore.exe"):
            key = r"HKCU\Software\Wine\AppDefaults\%s\DllOverrides" % program
            subprocess.run([proton, "runinprefix", "reg.exe", "add", key,
                            "/v", "dcomp", "/t", "REG_SZ", "/d", "", "/f"], env=env, check=True)
        print("droiddeck-game-env: Ubisoft Connect uses CEF without DirectComposition", file=sys.stderr)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print("droiddeck-game-env: Ubisoft Connect composition configuration failed (%s)" % error, file=sys.stderr)


PZ_JVM_FLAGS = ("-XX:+UseG1GC", "-XX:TieredStopAtLevel=1")


def zomboid_vm_args(args):
    updated = [arg for arg in args if not re.fullmatch(r"-XX:\+Use\w*GC", arg) or arg == "-XX:+UseG1GC"]
    for flag in PZ_JVM_FLAGS:
        if flag not in updated:
            updated.append(flag)
    return updated


def zomboid_rewrite(node):
    changed = False
    if isinstance(node, dict):
        for key, value in node.items():
            if key == "vmArgs" and isinstance(value, list) and all(isinstance(arg, str) for arg in value):
                updated = zomboid_vm_args(value)
                if updated != value:
                    node[key] = updated
                    changed = True
            elif isinstance(value, dict):
                changed |= zomboid_rewrite(value)
    return changed


def project_zomboid_jvm(command):
    if len(command) <= 2:
        return
    exe = Path(command[2])
    if not exe.stem.lower().startswith("projectzomboid"):
        return
    settings = exe.with_suffix(".json")
    try:
        with settings.open(encoding="utf-8-sig") as source:
            data = json.load(source)
        if not zomboid_rewrite(data):
            return
        handle, staged = tempfile.mkstemp(prefix=".droiddeck-", dir=settings.parent)
        try:
            with os.fdopen(handle, "w", encoding="utf-8") as target:
                json.dump(data, target, indent=4)
                target.write("\n")
            os.chmod(staged, settings.stat().st_mode & 0o7777)
            os.replace(staged, settings)
        except BaseException:
            os.unlink(staged)
            raise
        print("droiddeck-game-env: Project Zomboid: G1 garbage collector and C1 JIT only (ZGC overheats and stalls here)",
              file=sys.stderr)
    except (OSError, ValueError, AttributeError) as error:
        print("droiddeck-game-env: Project Zomboid JVM settings left as is (%s)" % error, file=sys.stderr)


def offline_without_anticheat(command, env):
    if (env.get("DROIDDECK_ANTICHEAT_OFFLINE") != "1" or len(command) <= 2
            or command[1] != "waitforexitandrun"
            or not re.fullmatch(r"start_protected_game(?:_?x64|_?64)?\.exe",
                                os.path.basename(command[2]), re.IGNORECASE)):
        return command
    folder = os.path.dirname(command[2])
    try:
        with open(os.path.join(folder, "EasyAntiCheat", "settings.json"), encoding="utf-8-sig") as source:
            executable = json.load(source).get("executable")
    except (OSError, ValueError, AttributeError):
        return command
    if not isinstance(executable, str) or not executable:
        return command
    relative = os.path.normpath(executable.replace("\\", "/"))
    game = os.path.join(folder, relative)
    if os.path.isabs(relative) or relative.startswith("..") or not os.path.isfile(game):
        return command
    root = os.path.realpath(folder)
    if os.path.commonpath((root, os.path.realpath(game))) != root:
        return command
    if os.path.normcase(os.path.abspath(game)) == os.path.normcase(os.path.abspath(command[2])):
        return command
    print("droiddeck-game-env: started without Easy Anti-Cheat (offline only)", file=sys.stderr)
    return command[:2] + [game] + command[3:]


def keep_caller_env(inherited, env):
    """Names listed in DROIDDECK_KEEP_ENV keep the caller's values over game fixes and saved settings
    (the memory-ordering test sets the FEX TSO switches itself)."""
    names = [n for n in inherited.get("DROIDDECK_KEEP_ENV", "").split() if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", n)]
    if not names:
        return env, None
    result = dict(env)
    for name in names:
        if name in inherited:
            result[name] = inherited[name]
        else:
            result.pop(name, None)
    return result, "kept the caller's " + " ".join("%s=%s" % (n, inherited.get(n, "unset")) for n in names)


FEX_TSO_NAMES = ("FEX_TSOENABLED", "FEX_VECTORTSOENABLED", "FEX_MEMCPYSETTSOENABLED", "FEX_HALFBARRIERTSOENABLED", "DOTNET_gcConcurrent")


def fex_tso_settings(env):
    return "FEX TSO for this game: " + " ".join("%s=%s" % (name, env.get(name, "unset")) for name in FEX_TSO_NAMES)


def engine_fixes(exe, args, env=None):
    game = Game(exe, args, env)
    env, extra, notes = {}, [], []
    for check in FIXES:
        found = check(game)
        if found:
            for name, value in found[0].items():
                if name == "WINEDLLOVERRIDES" and env.get(name):
                    value = env[name] + ";" + value
                env[name] = value
            extra += found[1]
            notes.append(found[2])
    return env, extra, notes


def with_args(command, extra):
    """Engine arguments go before a `--` or `++`, after which Godot hands arguments to the game's scripts."""
    for index in range(3, len(command)):
        if command[index] in ("--", "++"):
            return command[:index] + extra + command[index:]
    return command + extra


GODOT_OVERRIDE = (
    "; Written by DroidDeck: Godot saves its Vulkan pipeline cache in small steps, so pipelines compiled\n"
    "; before the game is closed without quitting are kept. DROIDDECK_GODOT_RENDERER=off removes this file.\n"
    "config_version=5\n\n[rendering]\n\nrendering_device/pipeline_cache/save_chunk_size_mb=0.5\n"
)


def godot_override(game):
    """override.cfg beside the executable, read after the pack's own settings (core/config/project_settings.cpp).
    Godot otherwise saves the pipeline cache only after each 3 MiB of growth and on a clean exit."""
    folder = os.path.dirname(game.exe)
    try:
        with os.scandir(folder) as entries:
            found = [e.path for e in entries if e.name.lower() == "override.cfg"]
    except OSError:
        return None
    path = found[0] if found else os.path.join(folder, "override.cfg")
    text = None
    if found:
        try:
            with open(path, encoding="utf-8", errors="replace") as source:
                text = source.read(1 << 16)
        except OSError as error:
            return "Godot: override.cfg unreadable (%s); left as is" % error
    ours = text is not None and text.startswith(GODOT_OVERRIDE.split("\n", 1)[0])
    if not experiment(game.env, "godot-render"):
        version = None
    else:
        version = game.godot().get("version")
    if godot_renderer_choice(game) == "off" or not version or version[0] != 4:
        if ours:
            try:
                os.remove(path)
                return "Godot: DroidDeck's override.cfg removed"
            except OSError as error:
                return "Godot: DroidDeck's override.cfg not removed (%s)" % error
        return None
    if text is not None and not ours:
        return "Godot: the game's own override.cfg left as is; pipeline cache saved at Godot's 3 MiB steps"
    if text != GODOT_OVERRIDE:
        staged = None
        try:
            with tempfile.NamedTemporaryFile("w", dir=folder, prefix=".override.cfg.", delete=False, encoding="utf-8") as out:
                staged = out.name
                out.write(GODOT_OVERRIDE)
            os.replace(staged, path)
        except OSError as error:
            if staged:
                try:
                    os.remove(staged)
                except OSError:
                    pass
            return "Godot: override.cfg not written (%s); pipeline cache saved at Godot's 3 MiB steps" % error
    return "Godot: pipeline cache saved every 0.5 MiB (override.cfg)"


def godot_safe_name(name, paths=False):
    name = name.replace("\\", "/").replace("//", "/").strip() if paths else name.strip()
    for bad in [":", "*", "?", '"', "<", ">", "|"] + ([".."] if paths else ["/", "\\"]):
        name = name.replace(bad, "-")
    return name.rstrip(".")


def godot_user_dir(game):
    """user:// of a Windows Godot game in its Proton prefix, as core/os/os.cpp get_user_data_dir() builds it."""
    settings = game.godot().get("settings")
    prefix = game.env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    if settings is None or not prefix:
        return None
    roaming = Path(prefix) / "pfx/drive_c/users/steamuser/AppData/Roaming"
    name = godot_safe_name(str(settings.get("application/config/name") or ""))
    if not name:
        return roaming / "Godot/app_userdata/[unnamed project]"
    if settings.get("application/config/use_custom_user_dir"):
        return roaming / (godot_safe_name(str(settings.get("application/config/custom_user_dir_name") or ""), True) or name)
    return roaming / "Godot/app_userdata" / name


GODOT_HEADER = re.compile(r"^(?:Vulkan|D3D12|Metal|OpenGL API) \S+ - .+ - Using Device.*$", re.M)


def godot_files(game):
    """The pipeline cache Godot keeps in user://vulkan and the renderer its last run reported in its log."""
    notes = [note for note in (godot_override(game),) if note]
    folder = godot_user_dir(game)
    if folder is None:
        return notes
    try:
        caches = sorted((folder / "vulkan").glob("pipelines.*.cache"))
        sizes = ", ".join("%s %.2f MiB" % (p.name, p.stat().st_size / 2**20) for p in caches)
    except OSError:
        sizes = ""
    notes.append("Godot pipeline cache in %s: %s" % (folder, sizes or "none yet"))
    log = str(game.godot().get("settings", {}).get("debug/file_logging/log_path") or "user://logs/godot.log")
    if log.startswith("user://"):
        try:
            with open(folder / log[len("user://"):], encoding="utf-8", errors="replace") as source:
                found = GODOT_HEADER.search(source.read(1 << 16))
            if found:
                notes.append("Godot last run: " + found.group(0).strip())
        except OSError:
            pass
    return notes


def win_components(compat, app_id, proton=None, env=None):
    if not compat:
        return ""
    try:
        module = runpy.run_path(str(Path(__file__).resolve().parent / "droiddeck-wincomponents"))
        names, notes = module["apply"](compat.rstrip("/"), app_id, proton=proton, env=env or os.environ)
        for note in notes:
            print("droiddeck-game-env: " + note, file=sys.stderr)
        return module["overrides_value"](names)
    except Exception as error:
        print("droiddeck-game-env: Windows components not applied (%s)" % error, file=sys.stderr)
        return ""


def chromium_app(folder):
    root = os.path.realpath(folder)
    for top, dirs, files in os.walk(root):
        if CHROMIUM_FILES.intersection(files) or CHROMIUM_FILES.intersection(dirs):
            return True
        if os.path.relpath(top, root).count(os.sep) >= 2:
            dirs[:] = []
    return False


def game_gpu(env, keep=False):
    if GAME_TU_DEBUG not in env:
        return env
    result = env.copy()
    value = result.pop(GAME_TU_DEBUG)
    if keep:
        return result
    if value:
        result["TU_DEBUG"] = value
    else:
        result.pop("TU_DEBUG", None)
    return result


def vram_cap(env):
    value = env.get("BL_VRAM_MB", "")
    if not re.fullmatch(r"[1-9][0-9]{0,6}", value):
        return env
    result = env.copy()
    cap = "dxgi.maxDeviceMemory = {0}".format(int(value))
    if int(value) < D3D9_DEFAULT_MEMORY_MB:
        cap += "; d3d9.maxAvailableMemory = {0}".format(int(value))
    own = result.get("DXVK_CONFIG", "").strip().strip(";").strip()
    result["DXVK_CONFIG"] = cap + "; " + own if own else cap
    result["DROIDDECK_VRAM_CAP"] = "1"
    result["DROIDDECK_VRAM_CAP_MB"] = value
    return result


# Default GC conserve level per game (docs/research/memory-footprint.md). Slay the Spire 2 is a
# turn-based Godot/CoreCLR game, so the blocking gen2 compactions this asks for cost little.
DOTNET_CONSERVE_GAMES = {"2868840": "5"}
DOTNET_HEAP_LIMIT_MB = (256, 16384)


def dotnet_set(env, name):
    return any(prefix + name in env for prefix in ("DOTNET_", "COMPlus_"))


def dotnet_heap(env, app_id):
    """(env, log line or None): DROIDDECK_DOTNET_CONSERVE (0-9) and DROIDDECK_DOTNET_HEAP_LIMIT_MB
    become DOTNET_GCConserveMemory and DOTNET_GCHeapHardLimit (CLR config values are hex)."""
    result = env.copy()
    if dotnet_set(env, "GCConserveMemory"):
        conserve, source = env.get("DOTNET_GCConserveMemory", env.get("COMPlus_GCConserveMemory")), "env"
    elif re.fullmatch(r"[0-9]", env.get("DROIDDECK_DOTNET_CONSERVE", "")):
        conserve, source = env["DROIDDECK_DOTNET_CONSERVE"], "setting"
    else:
        conserve, source = DOTNET_CONSERVE_GAMES.get(app_id, "0"), "default"
    if source != "env" and conserve != "0":
        result["DOTNET_GCConserveMemory"] = conserve
    limit = env.get("DROIDDECK_DOTNET_HEAP_LIMIT_MB", "")
    if dotnet_set(env, "GCHeapHardLimit") or dotnet_set(env, "GCHeapHardLimitPercent"):
        limit_mb = "env"
    elif re.fullmatch(r"[1-9][0-9]{0,5}", limit) and DOTNET_HEAP_LIMIT_MB[0] <= int(limit) <= DOTNET_HEAP_LIMIT_MB[1]:
        result["DOTNET_GCHeapHardLimit"] = "%x" % (int(limit) << 20)
        limit_mb = limit
    elif limit:
        limit_mb = "ignored"
    else:
        limit_mb = "-"
    if conserve == "0" and limit_mb == "-":
        return result, None
    return result, "DROIDDECK_DOTNET_HEAP app=%s conserve=%s limit_mb=%s source=%s" % (app_id, conserve, limit_mb, source)


def parse_cores(text):
    cores = set()
    for part in text.replace(" ", "").split(","):
        match = re.fullmatch(r"(\d{1,3})(?:-(\d{1,3}))?", part)
        if not match:
            return None
        first, last = int(match.group(1)), int(match.group(2) or match.group(1))
        if last < first:
            return None
        cores.update(range(first, last + 1))
    return cores or None


def online_cores():
    try:
        with open("/sys/devices/system/cpu/online") as f:
            cores = parse_cores(f.read().strip())
    except OSError:
        cores = None
    return cores or os.sched_getaffinity(0) | set(range(os.cpu_count() or 0))


def game_cores(env):
    text = env.get("DROIDDECK_GAME_CORES", "").strip()
    if not text:
        return
    cores = parse_cores(text)
    chosen = cores & online_cores() if cores else None
    if not chosen:
        print("droiddeck-game-env: ignoring game cores %r" % text, file=sys.stderr)
        return
    try:
        os.sched_setaffinity(0, chosen)
        print("droiddeck-game-env: game cores %s" % ",".join(map(str, sorted(chosen))), file=sys.stderr)
    except OSError as error:
        print("droiddeck-game-env: could not use game cores %r (%s)" % (text, error), file=sys.stderr)


def core_speeds(cores, root="/sys/devices/system/cpu"):
    for name in ("cpu_capacity", "cpufreq/cpuinfo_max_freq"):
        speeds = {}
        for core in cores:
            try:
                with open("%s/cpu%d/%s" % (root, core, name)) as f:
                    speeds[core] = int(f.read().strip())
            except (OSError, ValueError):
                break
        else:
            return speeds
    return None


def fastest_first(cores):
    cores = sorted(cores)
    speeds = core_speeds(cores)
    return sorted(cores, key=lambda core: -speeds[core]) if speeds else cores


def slow_cores(speeds):
    """The cores a big budget leaves out: cpu_capacity is IPC-weighted (little cores sit near a quarter of the
    prime core); cpufreq is not."""
    capacity = all(speed <= 1024 for speed in speeds.values())
    top = max(speeds.values())
    floor = top / 2 if capacity else top * 0.7
    return {core for core, speed in speeds.items() if speed < floor}


def thread_budget(budget, cores):
    """Wine confines every game thread to the host cores in WINE_CPU_TOPOLOGY, and Godot's worker pool
    and .NET's processor count follow the cores Windows sees."""
    speeds = core_speeds(cores)
    if budget == "big":
        if not speeds:
            print("droiddeck-game-env: thread budget big: core speeds unreadable; all %d cores kept" % len(cores),
                  file=sys.stderr)
            return cores
        slow = slow_cores(speeds)
        kept = [core for core in cores if core not in slow]
    elif re.fullmatch(r"[1-9][0-9]{0,2}", budget):
        kept = cores[:int(budget)]
    else:
        print("droiddeck-game-env: thread budget %r not understood (big, all or a core count); all cores kept" % budget,
              file=sys.stderr)
        return cores
    if len(kept) < 2 and len(cores) >= 2:
        kept = cores[:2]
    left = sorted(set(cores) - set(kept))
    if left:
        print("droiddeck-game-env: thread budget %s: game threads on %d of %d cores (%s), left out %s" % (
            budget, len(kept), len(cores), ",".join(map(str, kept)), ",".join(map(str, left))), file=sys.stderr)
    else:
        print("droiddeck-game-env: thread budget %s: all %d cores kept" % (budget, len(cores)), file=sys.stderr)
    return kept


FPS_CAP = re.compile(r"[1-9][0-9]{0,2}")
GAME_IMAGES = "8"
CAPPED_IMAGES = "3"


def frame_cap(command, env):
    """One limiter per game. Godot sleeps for --max-fps at the end of its main loop, so the next frame reads input
    right after the wait; DXVK's and VKD3D's limiters sleep in present, after the frame's input was read, and
    another limiter at the same rate drifts against Godot's and adds a queued frame each time it falls behind.
    DXVK and VKD3D limit only games that are not Godot."""
    value = env.get("DROIDDECK_FPS_CAP", "").strip()
    if not value or value == "0":
        return command, None
    if not FPS_CAP.fullmatch(value):
        return command, "frame cap %r not understood (a number of frames per second, or 0 for none)" % value
    fps = value
    ways = []
    if len(command) > 2 and is_godot(Game(command[2], command[3:])):
        args = command[3:]
        if any(arg == "--max-fps" for arg in args):
            ways.append("Godot --max-fps from the launch options kept")
        else:
            cut = next((i for i, arg in enumerate(args) if arg in ("--", "++")), len(args))
            extra = ["--max-fps", fps]
            # Godot's vsync is a second limiter at the panel rate: its FIFO swapchain fills whenever the timer runs
            # ahead of the screen. Xwayland and gamescope never tear, so without it the cap is the only pacing.
            if experiment(env, "one-limiter") and "--disable-vsync" not in args[:cut]:
                extra.append("--disable-vsync")
            command = command[:3] + args[:cut] + extra + args[cut:]
            ways.append("Godot --max-fps" + (", vsync off" if len(extra) > 2 else ""))
    else:
        own = env.get("DXVK_CONFIG", "").strip().rstrip(";").strip()
        if not re.search(r"(?:^|;)\s*dxvk\.maxFrameRate\s*=", own):
            env["DXVK_CONFIG"] = own + "; dxvk.maxFrameRate = " + fps if own else "dxvk.maxFrameRate = " + fps
            ways.append("DXVK")
        if not env.get("VKD3D_FRAME_RATE"):
            env["VKD3D_FRAME_RATE"] = fps
            ways.append("VKD3D")
    # With gamescope's WSI layer a FIFO game gets GAMESCOPE_WSI_MIN_IMAGE_COUNT images and gamescope queues every
    # one of them: a capped game running a little ahead of the screen keeps seven frames waiting. Three is the
    # layer's own default (one shown, one queued, one drawing).
    if env.get("GAMESCOPE_WSI_MIN_IMAGE_COUNT") == GAME_IMAGES:
        env["GAMESCOPE_WSI_MIN_IMAGE_COUNT"] = CAPPED_IMAGES
        ways.append("%s swapchain images" % CAPPED_IMAGES)
    return command, "frame cap %s fps (%s)" % (fps, ", ".join(ways) or "already set")


PACING_SWITCHES = (("adpf", "DROIDDECK_PACING_ADPF"), ("display", "DROIDDECK_PACING_DISPLAY"),
                   ("governor", "DROIDDECK_FPS_GOVERNOR"))


def pacing_line(env, app_id):
    """The line the app reads from session.log to pace the launch's frame cap: the ADPF target, the
    display vote and the thermal governor, each on unless its variable is 0. Experiment native-hz turns the
    display vote off unless the game's profile sets it: a 60 Hz panel doubles every wait for a refresh between
    the game and the screen."""
    fps = env.get("DROIDDECK_FPS_CAP", "").strip()
    if not app_id or not FPS_CAP.fullmatch(fps):
        return None
    defaults = {"DROIDDECK_PACING_DISPLAY": "0" if experiment(env, "native-hz") else "1"}
    switches = " ".join("%s=%d" % (key, env.get(name, defaults.get(name, "1")).strip().lower()
                                   not in ("0", "off", "false", "no"))
                        for key, name in PACING_SWITCHES)
    return "DROIDDECK_PACING app_id=%s cap=%s %s" % (app_id, fps, switches)


THREAD_CHECK = "--droiddeck-thread-check"
THREAD_CHECK_AFTER = (60, 180)
THREAD_CHECK_POLL = 2


def thread_placement(name, proc=Path("/proc")):
    comm = name[:15]
    found = []
    for entry in proc.iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if (entry / "comm").read_text().strip() != comm:
                continue
            tasks = list((entry / "task").iterdir())
        except OSError:
            continue
        allowed, ran = {}, {}
        for task in tasks:
            try:
                status = (task / "status").read_text()
                stat = (task / "stat").read_text()
            except OSError:
                continue
            match = re.search(r"^Cpus_allowed_list:\s*(\S+)", status, re.M)
            if match:
                allowed[match.group(1)] = allowed.get(match.group(1), 0) + 1
            fields = stat[stat.rfind(")") + 2:].split()
            if len(fields) > 36 and fields[36].isdigit():
                cpu = int(fields[36])
                ran[cpu] = ran.get(cpu, 0) + int(fields[11]) + int(fields[12])
        found.append("pid %s, %d threads, allowed %s, cpu ticks by last core %s" % (
            entry.name, len(tasks),
            " ".join("%s (%d)" % (cpus, count) for cpus, count in sorted(allowed.items(), key=lambda item: -item[1])) or "?",
            " ".join("%d:%d" % (cpu, ticks) for cpu, ticks in sorted(ran.items())) or "?"))
    if not found:
        return "thread placement: %s not running" % name
    return "thread placement: %s %s" % (name, "; ".join(found))


def start_thread_check(command, env):
    if not env.get("WINE_CPU_TOPOLOGY") or not env.get("DROIDDECK_GAME_CPU_BUDGET") or len(command) < 3:
        return
    name = command[2].replace("\\", "/").rsplit("/", 1)[-1]
    try:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), THREAD_CHECK, name],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, start_new_session=True)
    except OSError as error:
        print("droiddeck-game-env: thread placement not checked (%s)" % error, file=sys.stderr)


def thread_check(name, sleep=None, parent=None):
    import time
    sleep = sleep or time.sleep
    parent = parent or os.getppid
    launcher = parent()
    waited = 0
    for after in THREAD_CHECK_AFTER:
        # Steam's reaper counts this as part of the game: stop as soon as the launch is gone.
        while waited < after:
            sleep(THREAD_CHECK_POLL)
            waited += THREAD_CHECK_POLL
            if parent() != launcher:
                return 0
        print("droiddeck-game-env: %s after %d s" % (thread_placement(name), after), file=sys.stderr, flush=True)
    return 0


def proton_cpu_limit(command, env):
    app_id = env.get("SteamGameId", "")
    if not command or not app_id.isdigit():
        return None
    try:
        if os.path.getsize(command[0]) > 4 * 1024 * 1024:
            return None
        with open(command[0], encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return None
    table = re.search(r"^default_cpu_limit = \{(.*?)^\}", text, re.M | re.S)
    match = table and re.search(r'^\s*"%s"\s*:\s*"?(\w+)' % app_id, table.group(1), re.M)
    if not match:
        return None
    value = match.group(1)
    return int(value) if value.isdigit() else value


def cpu_topology(env, command=()):
    """Sets WINE_CPU_TOPOLOGY to the cores the game runs on. Returns the plan CoreWatch keeps them with when it
    chose them itself and the budget was not turned off (all or 0, or DROIDDECK_GAME_REPIN=0), else None."""
    if "PROTON_CPU_TOPOLOGY" in env:
        return
    if "WINE_CPU_TOPOLOGY" in env:
        if env["WINE_CPU_TOPOLOGY"]:
            env["PROTON_CPU_TOPOLOGY"] = env["WINE_CPU_TOPOLOGY"]
        return
    picked = bool(env.get("DROIDDECK_GAME_CORES", "").strip() or env.get("BL_GAME_CPUS", "").strip())
    budget = env.get("DROIDDECK_GAME_CPU_BUDGET", "").strip().lower()
    if budget in ("all", "0"):
        budget = ""
    fastest = bool(env.get("DROIDDECK_FASTEST_CORES", "").strip() != "0" or budget) and game_id(env) is not None
    if not (picked or fastest):
        return
    try:
        cores = sorted(os.sched_getaffinity(0))
    except OSError:
        return
    online = online_cores()
    if not cores or cores[-1] >= len(online):
        return
    picked = picked and not set(cores) >= online
    base = set(cores) if picked else None
    if fastest:
        limit = None if picked else proton_cpu_limit(command, env)
        if isinstance(limit, str):
            return
        cores = fastest_first(cores)[:limit or None]
        if budget:
            cores = thread_budget(budget, cores)
    elif set(cores) >= online:
        return
    if cores == sorted(online):
        return
    env["WINE_CPU_TOPOLOGY"] = env["PROTON_CPU_TOPOLOGY"] = "%d:%s" % (len(cores), ",".join(map(str, cores)))
    print("droiddeck-game-env: Windows sees %d cores (%s)" % (len(cores), env["WINE_CPU_TOPOLOGY"]), file=sys.stderr)
    if env.get("DROIDDECK_GAME_CPU_BUDGET", "").strip().lower() in ("all", "0") or \
            env.get("DROIDDECK_GAME_REPIN", "").strip() == "0":
        return None
    return {"cores": list(cores), "budget": budget, "base": base}


REPIN_POLL_S = 5
REPIN_MAX_POLL_S = 80
REPIN_CALM_S = 300
REPIN_EARLY_POLLS = 12
REPIN_RESCAN_POLLS = 6
REPIN_FLAP_WINDOW_S = 120
REPIN_FLAP_COUNT = 3
REPIN_FAILED_ROUNDS = 3
# Native helpers Wine starts without ntdll, which never get WINE_CPU_TOPOLOGY's cores at launch.
REPIN_SKIP = frozenset({"wineserver"})


def format_cores(cores):
    runs, cores = [], sorted(cores)
    for core in cores:
        if runs and core == runs[-1][1] + 1:
            runs[-1][1] = core
        else:
            runs.append([core, core])
    return ",".join("%d" % a if a == b else "%d-%d" % (a, b) for a, b in runs) or "-"


class CoreWatch:
    """Keeps the game on the cores cpu_topology chose. Wine pins each of its processes to WINE_CPU_TOPOLOGY's
    cores as it starts, but when Android moves the app to another cpuset (thermal, or top-app to foreground) the
    kernel resets every task's affinity to the new cpuset and the pin is gone: the game then runs on the little
    cores. Every few seconds this reads the affinity of the main thread of each Wine process in the launch's tree
    that carried the pin; when one has cores outside the pin, it works the cores out again the way the launch did,
    from that new allowed set, and pins every thread of those processes there. It never widens past the allowed
    set, leaves the kernel's mask alone when only little cores are left, and polls less often when the mask flaps
    or a pin fails, stopping after REPIN_FAILED_ROUNDS failed rounds in a row."""

    def __init__(self, plan, app_id="", root=None, proc="/proc", setaffinity=None, online=None, speeds=None,
                 clock=time.monotonic, wall=time.time):
        self.cores = set(plan["cores"])
        self.size = len(plan["cores"])
        self.budget = plan.get("budget") or ""
        self.base = set(plan["base"]) if plan.get("base") else None
        self.app_id = app_id or "-"
        self.root = root if root is not None else os.getpid()
        self.proc = proc
        self.setaffinity = setaffinity or os.sched_setaffinity
        self.online = online or online_cores
        self.speeds = speeds or core_speeds
        self.clock, self.wall = clock, wall
        self.budgeted = {}
        self.left_alone = None
        self.interval = REPIN_POLL_S
        self.repins = []
        self.changed = clock()
        self.failed_rounds = 0
        self.polls = 0
        self.done = threading.Event()
        self.thread = None

    def start(self):
        self.thread = threading.Thread(target=self.run, name="core-watch", daemon=True)
        self.thread.start()
        return self

    def stop(self):
        self.done.set()

    def run(self):
        while not self.done.wait(self.interval):
            try:
                self.poll()
            except Exception as error:  # the watch must never take the launch down
                print("droiddeck-game-env: core watch stopped (%s)" % error, file=sys.stderr, flush=True)
                return

    def read(self, path):
        try:
            with open(path, "rb") as f:
                return f.read().decode("ascii", "replace")
        except OSError:
            return None

    def mask(self, path):
        text = self.read(path + "/status")
        match = text and re.search(r"^Cpus_allowed_list:\s*(\S+)", text, re.M)
        return parse_cores(match.group(1)) if match else None

    def started(self, pid):
        text = self.read("%s/%d/stat" % (self.proc, pid))
        fields = text[text.rfind(")") + 2:].split() if text else []
        return fields[19] if len(fields) > 19 else None

    def rescan(self):
        tree = set(descendants(self.root, self.proc))
        for pid in list(self.budgeted):
            if pid not in tree:
                del self.budgeted[pid]
        for pid in tree:
            if pid in self.budgeted:
                continue
            comm = (self.read("%s/%d/comm" % (self.proc, pid)) or "").strip()
            if not comm or comm in REPIN_SKIP:
                continue
            mask = self.mask("%s/%d" % (self.proc, pid))
            if mask and mask <= self.cores:
                started = self.started(pid)
                if started:
                    self.budgeted[pid] = started

    def target(self, allowed):
        """The launch's choice made again from the allowed cores: the fastest first, at most as many as the
        launch kept, without the little cores on a big budget unless fewer than two others are left (None)."""
        online = set(self.online())
        allowed = allowed & online & (self.base or online)
        if not allowed:
            return None
        speeds = self.speeds(sorted(online))
        order = sorted(allowed, key=lambda core: (-speeds[core], core)) if speeds else sorted(allowed)
        if self.budget == "big" and speeds:
            slow = slow_cores(speeds)
            order = [core for core in order if core not in slow]
            if len(order) < 2:
                return None
        kept = order[:max(self.size, 2)]
        return set(kept)

    def log(self, seen, to, action, extra=""):
        print("DROIDDECK_TIMELINE event=game_cores_reset app_id=%s from=%s to=%s action=%s%s next_s=%d wall_ms=%d" % (
            self.app_id, format_cores(seen), format_cores(to), action, extra, self.interval, int(self.wall() * 1000)),
            file=sys.stderr, flush=True)

    def pin(self, target):
        """Pins every thread of the budgeted processes that has a core outside target; (pinned, failed, error)."""
        pinned = failed = 0
        error = None
        for pid, started in list(self.budgeted.items()):
            if self.started(pid) != started:
                del self.budgeted[pid]
                continue
            try:
                tasks = os.listdir("%s/%d/task" % (self.proc, pid))
            except OSError:
                continue
            for tid in tasks:
                if not tid.isdigit():
                    continue
                mask = self.mask("%s/%d/task/%s" % (self.proc, pid, tid))
                if mask is None or mask <= target:
                    continue
                try:
                    self.setaffinity(int(tid), target)
                    pinned += 1
                except OSError as e:
                    if e.errno == errno.ESRCH:
                        continue
                    failed += 1
                    error = errno.errorcode.get(e.errno, str(e.errno))
        return pinned, failed, error

    def poll(self):
        self.polls += 1
        now = self.clock()
        if self.polls <= REPIN_EARLY_POLLS or self.polls % REPIN_RESCAN_POLLS == 0 or not self.budgeted:
            self.rescan()
        seen = set()
        for pid in list(self.budgeted):
            mask = self.mask("%s/%d" % (self.proc, pid))
            if mask is None:
                del self.budgeted[pid]
            elif not mask <= self.cores:
                seen |= mask
        if not seen:
            self.left_alone = None
            if self.interval > REPIN_POLL_S and now - self.changed >= REPIN_CALM_S:
                self.interval = REPIN_POLL_S
                self.changed = now
            return
        if seen == self.left_alone:
            return
        target = self.target(seen)
        if target is None:
            self.left_alone = seen
            self.log(seen, seen, "kept")
            return
        self.left_alone = None
        pinned, failed, error = self.pin(target)
        if not self.budgeted:
            return
        self.changed = now
        if failed and not pinned:
            self.failed_rounds += 1
            self.interval = min(self.interval * 2, REPIN_MAX_POLL_S)
            stop = self.failed_rounds >= REPIN_FAILED_ROUNDS
            self.log(seen, target, "stopped" if stop else "failed", " error=%s threads=%d" % (error, failed))
            if stop:
                self.done.set()
            return
        self.failed_rounds = 0
        self.cores = target
        self.repins = [t for t in self.repins if now - t < REPIN_FLAP_WINDOW_S] + [now]
        if len(self.repins) >= REPIN_FLAP_COUNT:
            self.interval = min(self.interval * 2, REPIN_MAX_POLL_S)
            self.repins = []
        self.log(seen, target, "repin", " threads=%d%s" % (pinned, " failed=%d error=%s" % (failed, error) if failed else ""))


def gl_vsync(env):
    if "vblank_mode" in env or game_id(env) is None:
        return False
    env["vblank_mode"] = "0"
    return True


def game_images(env):
    if game_id(env) is None:
        return False
    env.setdefault("GAMESCOPE_WSI_MIN_IMAGE_COUNT", GAME_IMAGES)
    env.setdefault("GAMESCOPE_WSI_ENSURE_MIN_IMAGE_COUNT", "1")
    return True


def apply_config(env, config, app_id, fixes=None):
    if config.get("version") != 1:
        raise ValueError("unsupported environment configuration")
    result = env.copy()
    entries = dict(config.get("shared", {}))
    for name, value in (fixes or {}).items():
        if name == "WINEDLLOVERRIDES" and entries.get(name, env.get(name)):
            value = entries.get(name, env.get(name)) + ";" + value
        entries[name] = value
    entries.update(config.get("games", {}).get(app_id, {}))
    for name, value in entries.items():
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
            raise ValueError("invalid environment name")
        if value is None:
            result.pop(name, None)
        elif isinstance(value, str) and "\0" not in value and len(value) <= 8192:
            result[name] = value
        else:
            raise ValueError("invalid environment value")
    game_dxvk = config.get("dxvkConfigGames", {})
    if not isinstance(game_dxvk, dict):
        raise ValueError("invalid game dxvk configuration")
    dxvk = game_dxvk.get(app_id, config.get("dxvkConfig"))
    if dxvk is not None:
        if not isinstance(dxvk, str) or "\0" in dxvk or len(dxvk) > 8192:
            raise ValueError("invalid dxvk configuration")
        if dxvk:
            own = result.get("DXVK_CONFIG", "").strip().rstrip(";").strip()
            result["DXVK_CONFIG"] = own + "; " + dxvk if own else dxvk
    # An open driver pair (PanVK, RADV) on a GPU that is not an Adreno: vkd3d-proton reports the
    # driver's own feature level and shader model. The app-wide 12_2 / 6_9 over-promised what PanVK
    # has, and an Unreal DX12 game took paths that crashed. A game's own setting still wins.
    if env.get("BL_OPEN_DRIVER") == "1":
        game = config.get("games", {}).get(app_id, {}) or {}
        for name in ("VKD3D_FEATURE_LEVEL", "VKD3D_SHADER_MODEL"):
            if name not in game and name in result:
                result.pop(name)
                result["DROIDDECK_VKD3D_CAPS"] = "driver"
    return result


def render_path_defaults(command, env):
    if len(command) < 3 or command[1] != "waitforexitandrun" or Path(command[2]).name.lower() != "spintires.exe":
        return None
    own = env.get("DXVK_CONFIG", "")
    if re.search(r"(?:^|;)\s*dxvk\.tilerMode\s*=", own) or env.get("DXVK_CONFIG_FILE"):
        return None
    if Path("dxvk.conf").is_file() or Path(command[2]).with_name("dxvk.conf").is_file():
        return None
    driver = env.get("VK_DRIVER_FILES", env.get("VK_ICD_FILENAMES", ""))
    if Path(driver).parent.name != "DD-Turnip_v0.4.0":
        return None
    try:
        if Path("/sys/class/kgsl/kgsl-3d0/gpu_model").read_text().strip() != "Adreno722":
            return None
        with open(driver, encoding="utf-8") as source:
            library = json.load(source)["ICD"]["library_path"]
        if Path(library).name != "libvulkan_freedreno.so":
            return None
    except (OSError, ValueError, KeyError, TypeError):
        return None
    own = own.strip().rstrip(";").strip()
    env["DXVK_CONFIG"] = own + "; dxvk.tilerMode = False" if own else "dxvk.tilerMode = False"
    return "Spintires: DXVK tiler heuristics off on Adreno 722"


def bridge_feature_level(env):
    if env.get("BL_VKBRIDGE") != "1" or env.get("VKD3D_FEATURE_LEVEL") not in ("12_1", "12_2"):
        return None
    was = env["VKD3D_FEATURE_LEVEL"]
    env["VKD3D_FEATURE_LEVEL"] = "12_0"
    return "Mali bridge: VKD3D_FEATURE_LEVEL %s capped at 12_0 (no ray tracing or mesh shaders)" % was


GAME_DEBUG_CHANNELS = (
    "timestamp", "pid", "tid", "seh", "unwind", "threadname", "debugstr", "loaddll", "mscoree",
)
WINE_DEBUG_SELECTOR = re.compile(r"(?:(trace|warn|err|fixme))?([+-])([A-Za-z_][A-Za-z0-9_]*)")


def game_debug_channels(*values):
    selectors = {}
    for value in values:
        if not isinstance(value, str) or "\0" in value or len(value) > 8192:
            continue
        for part in value.split(","):
            part = part.strip()
            match = WINE_DEBUG_SELECTOR.fullmatch(part)
            if match is None:
                continue
            key = (match[1] or "", match[3])
            selectors.pop(key, None)
            selectors[key] = part
    for channel in GAME_DEBUG_CHANNELS:
        key = ("", channel)
        selectors.pop(key, None)
        selectors[key] = "+" + channel
    formatted = ",".join(selectors.values())
    if len(formatted) > 8192:
        formatted = ",".join("+" + channel for channel in GAME_DEBUG_CHANNELS)
    return formatted


def apply_game_debug_logs(env, config, debug_dir):
    if not isinstance(config, dict) or config.get("version") != 1 or config.get("gameDebugLogs") is not True:
        return env
    if (not isinstance(debug_dir, str) or "\0" in debug_dir or len(debug_dir) > 8192
            or not os.path.isabs(debug_dir) or not os.path.isdir(debug_dir)):
        print("droiddeck-game-env: game debug logs skipped; session log directory unavailable", file=sys.stderr)
        return env
    result = dict(env)
    result.update({
        "PROTON_LOG": "1",
        "PROTON_LOG_DIR": debug_dir,
        "PROTON_CRASH_REPORT_DIR": debug_dir,
        "DXVK_LOG_PATH": debug_dir,
        "DXVK_LOG_LEVEL": "debug",
        "VKD3D_DEBUG": "info",
        "WINEDEBUG": game_debug_channels(env.get("WINEDEBUG"), env.get("PROTON_LOG")),
    })
    return result


def sync_config(config, app_id):
    games = config.get("games", {})
    return {
        "version": config.get("version"),
        "shared": {name: value for name, value in config.get("shared", {}).items() if name in SYNC_KEYS},
        "games": {app_id: {name: value for name, value in games.get(app_id, {}).items() if name in SYNC_KEYS}},
    }


def load_sync():
    try:
        return runpy.run_path(str(Path(__file__).resolve().parent / "droiddeck-esync"))
    except Exception as error:
        print("droiddeck-game-env: sync selection failed (%s); stock launch" % error, file=sys.stderr)
        return None


def select_sync(command, env, sync=None):
    try:
        sync = sync if sync is not None else load_sync()
        if sync is None:
            return command, env
        chosen, chosen_env = sync["select"](command, env)
        if chosen and all(isinstance(value, str) for value in chosen) and isinstance(chosen_env, dict):
            return list(chosen), dict(chosen_env)
    except Exception as error:
        print("droiddeck-game-env: sync selection failed (%s); stock launch" % error, file=sys.stderr)
    return command, env


def record_stock(sync, command, env):
    try:
        if sync is not None and "record" in sync:
            sync["record"](command, env)
    except Exception as error:
        print("droiddeck-game-env: stock launch not recorded (%s)" % error, file=sys.stderr)


def without_pack(chosen_env, env):
    result = dict(chosen_env)
    for name in PACK_KEYS:
        if name in env:
            result[name] = env[name]
        else:
            result.pop(name, None)
    return result


SSBS_LIB = "/usr/local/lib/libssbs.so"


def force_ssbs(command, env):
    if env.get("DROIDDECK_FORCE_SSBS", "").lower() not in ("1", "on", "true", "yes"):
        return env
    proton = os.path.dirname(command[0]) if command else ""
    if not os.path.isdir(os.path.join(proton, "files/lib/wine/aarch64-unix")):
        print("droiddeck-game-env: force SSBS asked for, but this Proton is not an ARM64 one; left off", file=sys.stderr)
        return env
    if not os.path.isfile(SSBS_LIB):
        print("droiddeck-game-env: force SSBS asked for, but %s is missing; left off" % SSBS_LIB, file=sys.stderr)
        return env
    parts = [p for p in re.split(r"[:\s]+", env.get("LD_PRELOAD", "")) if p]
    if SSBS_LIB not in parts:
        env = dict(env, LD_PRELOAD=":".join(parts + [SSBS_LIB]))
        print("droiddeck-game-env: force SSBS on (libssbs.so preloaded)", file=sys.stderr)
    return env


EVALUATOR_SCRIPT = re.compile(r"(?:^|[\\/])evaluatorscript_[0-9]+\.vdf$", re.IGNORECASE)


def mark_install_scripts(command, env):
    if not any(arg.lower().replace("\\", "/").endswith("iscriptevaluator.exe") for arg in command):
        return []
    root = env.get("BL_X64_STEAM_ROOT") or env.get("STEAM_COMPAT_CLIENT_INSTALL_PATH") or str(Path.home() / ".local/share/Steam")
    scripts = [str(Path(root) / arg.replace("\\", "/")) for arg in command if EVALUATOR_SCRIPT.search(arg)]
    scripts = [path for path in scripts if os.path.isfile(path)]
    if not scripts:
        return []
    try:
        subprocess.run([SEED_REDISTS, root], env=dict(env, DROIDDECK_SEED_SCRIPTS="\n".join(scripts)),
                       stdout=sys.stderr, timeout=60, check=False)
    except (OSError, subprocess.SubprocessError) as error:
        print("droiddeck-game-env: install scripts not marked (%s)" % error, file=sys.stderr)
    return scripts


INSTALL_STAMP = ".droiddeck-install-scripts"
VDF_TOKEN = re.compile(r'"((?:[^"\\]|\\.)*)"|([{}])')


def read_vdf(text):
    tokens = iter(VDF_TOKEN.findall(text))

    def block():
        items = []
        for word, brace in tokens:
            if brace == "}":
                return items
            if brace:
                raise ValueError("a block without a name")
            value, opens = next(tokens, ("", "}"))
            if opens == "}":
                raise ValueError("a name without a value")
            items.append((re.sub(r"\\(.)", r"\1", word), block() if opens else re.sub(r"\\(.)", r"\1", value)))
        return items

    return block()


def run_keys(items, appid=""):
    appid = next((value for name, value in items if name.lower() == "appid" and isinstance(value, str)), appid)
    found = set()
    for name, value in items:
        if not isinstance(value, list):
            continue
        if any(isinstance(v, str) and re.fullmatch(r"process [0-9]+", n.lower()) for n, v in value):
            key = next((v for n, v in value if n.lower() == "hasrunkey" and isinstance(v, str)),
                       "HKEY_LOCAL_MACHINE\\Software\\Valve\\Steam\\Apps\\" + appid)
            found.add((key.lower(), name.lower()))
        found |= run_keys(value, appid)
    return found


def registry_values(path):
    found, section = set(), None
    with open(path, encoding="utf-8", errors="replace") as reg:
        for line in reg:
            if line.startswith("["):
                section = line[1:line.find("]")].replace("\\\\", "\\").lower() if "]" in line else None
            elif section and line.startswith('"') and '"=' in line:
                found.add((section, line[1:line.index('"=')].replace("\\\\", "\\").lower()))
    return found


def has_run(key, value, values):
    path = key[len("hkey_local_machine\\"):] if key.startswith("hkey_local_machine\\") else None
    if path is None:
        return False
    views = [path]
    if path.startswith("software\\"):
        views.append("software\\wow6432node\\" + path[len("software\\"):])
    return any((view, value) in values for view in views)


def scripts_digest(scripts):
    digest = hashlib.sha256()
    for path in sorted(scripts):
        digest.update(os.path.basename(path).encode() + b"\0")
        digest.update(Path(path).read_bytes())
    return digest.hexdigest()


def install_scripts_done(scripts, env):
    prefix = Path(env.get("STEAM_COMPAT_DATA_PATH", "/nonexistent")) / "pfx"
    try:
        if (prefix / INSTALL_STAMP).read_text().strip() != scripts_digest(scripts):
            return False
        keys = set()
        for path in scripts:
            keys |= run_keys(read_vdf(Path(path).read_text(encoding="utf-8", errors="replace")))
        values = registry_values(prefix / "system.reg")
    except (OSError, ValueError):
        return False
    return bool(keys) and all(has_run(key, value, values) for key, value in keys)


def record_install_scripts(digest, env):
    prefix = Path(env.get("STEAM_COMPAT_DATA_PATH", "/nonexistent")) / "pfx"
    try:
        if prefix.is_dir():
            staged = prefix / (INSTALL_STAMP + ".tmp")
            staged.write_text(digest + "\n")
            staged.replace(prefix / INSTALL_STAMP)
    except OSError as error:
        print("droiddeck-game-env: install scripts not recorded (%s)" % error, file=sys.stderr)


def directaudio_settings(env):
    if "directaudio" not in env.get("WINE_AUDIO_DRIVER", "").split(","):
        return env
    for name, value in list(env.items()):
        if name.startswith("AUDIO_DIRECT_"):
            env["BANNER_" + name] = value
    return env


DIRT_GAMES = {"dirt3_game": "dirt3", "showdown": "dirtshowdown", "showdown_avx": "dirtshowdown"}
DIRT_WS2 = "/usr/local/lib/droiddeck-dirt/ws2_32.dll"
DIRT_MARKER = b"droiddeck-dirt-ws2_32"
DIRT_FIXED = "showdown_avx.exe".encode("utf-16-le")
DIRT_SAVED = ".droiddeck-original"


def dirt_telemetry_on(prefix, game):
    try:
        folders = [f for f in (Path(prefix) / "pfx/drive_c/users/steamuser/Documents/My Games").iterdir()
                   if f.name.lower().replace(" ", "") == game]
    except OSError:
        return False
    for folder in folders:
        try:
            text = (folder / "hardwaresettings/hardware_settings_config.xml").read_text(encoding="latin-1")
        except OSError:
            continue
        for tag in ("udp", "motion"):
            element = re.search(r"<%s\s[^>]*>" % tag, text)
            if element:
                attrs = dict(re.findall(r'\s(\w+)="([^"]*)"', element.group(0)))
                return attrs.get("enabled") == "true" and attrs.get("ip", "").lower() not in ("", "dbox")
    return False


def proton_ws2(proton):
    return Path(proton).parent / "files/lib/wine/i386-windows/ws2_32.dll"


def proton_has_dirt_fix(proton):
    try:
        return DIRT_FIXED in proton_ws2(proton).read_bytes()
    except OSError:
        return False


WINE_DLL_DIRS = ("/lib/wine/i386-windows", "/lib/wine/x86_64-windows", "/lib/wine/aarch64-windows", "/lib/wine",
                 "/lib/wine/fakedlls", "/lib64/wine", "/lib64/wine/fakedlls", "/lib64/wine/x86_64-windows")


FOREIGN_SUFFIX = ".foreign-arch"
PE = runpy.run_path(str(Path(__file__).resolve().parent / "droiddeck-wine-pe"))
pe_machine = PE["pe_machine"]


def repair_foreign_system_dlls(prefix, proton, env=None):
    dist = Path(proton).parent / "files/lib/wine"
    windows = Path(prefix) / "pfx/drive_c/windows"
    machines_by_folder = PE["proton_pe_machines"](proton, env or {})
    if machines_by_folder is None:
        return []
    repaired = []
    for folder, (libdir, machines) in machines_by_folder.items():
        builtins = dist / libdir
        try:
            builtin_names = {name.lower(): name for name in os.listdir(builtins)}
        except OSError:
            continue
        try:
            names = sorted(os.listdir(windows / folder))
        except OSError:
            continue
        for name in names:
            path = windows / folder / name
            builtin_name = builtin_names.get(name.lower())
            source = builtins / builtin_name if builtin_name else builtins / name
            if path.is_symlink() or not name.lower().endswith(".dll") or not source.is_file() or not path.is_file():
                continue
            machine = pe_machine(path)
            if machine is None or PE["machine_compatible"](path, machines, machine):
                continue
            link = windows / folder / (name + ".bl-new")
            backup = windows / folder / (name + FOREIGN_SUFFIX)
            serial = 1
            while os.path.lexists(backup):
                backup = windows / folder / (name + FOREIGN_SUFFIX + ".%d" % serial)
                serial += 1
            try:
                os.symlink(os.path.relpath(source, path.parent), link)
                os.replace(path, backup)
                try:
                    os.replace(link, path)
                except OSError:
                    if not os.path.lexists(path) and os.path.lexists(backup):
                        os.replace(backup, path)
                    raise
            except OSError:
                if link.is_symlink():
                    link.unlink()
                continue
            repaired.append("%s/%s (machine 0x%x)" % (folder, name, machine))
    return repaired


def is_wine_dll_link(path):
    try:
        return os.path.islink(path) and os.path.dirname(os.readlink(path)).endswith(WINE_DLL_DIRS)
    except OSError:
        return False


def prefix_ws2(prefix):
    return Path(prefix) / "pfx/drive_c/windows/syswow64/ws2_32.dll"


def is_dirt_stand_in(path):
    try:
        return not path.is_symlink() and DIRT_MARKER in path.read_bytes()
    except OSError:
        return False


def dirt_ws2_wanted(command, env):
    prefix = env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    if len(command) < 3 or not prefix or not os.path.isfile(DIRT_WS2):
        return None
    game = DIRT_GAMES.get(os.path.splitext(os.path.basename(command[2]))[0].lower())
    if not game or not dirt_telemetry_on(prefix, game) or proton_has_dirt_fix(command[0]):
        return None
    return prefix if os.path.lexists(prefix_ws2(prefix)) else None


def swap_dirt_ws2(prefix):
    target = prefix_ws2(prefix)
    saved = target.with_name(target.name + DIRT_SAVED)
    data = Path(DIRT_WS2).read_bytes()
    if not is_dirt_stand_in(target):
        if os.path.lexists(saved):
            os.unlink(saved)
        os.replace(target, saved)
    staged = target.with_name(target.name + ".droiddeck-tmp")
    staged.write_bytes(data)
    os.replace(staged, target)


def restore_dirt_ws2(prefix, proton):
    target = prefix_ws2(prefix)
    saved = target.with_name(target.name + DIRT_SAVED)
    own = proton_ws2(proton)
    had_saved = os.path.lexists(saved)
    if had_saved:
        if os.path.lexists(target) and not is_dirt_stand_in(target):
            os.unlink(saved)
            return False
        if not own.is_file() or not is_wine_dll_link(saved) or os.path.realpath(saved) == os.path.realpath(own):
            os.replace(saved, target)
            return True
        os.unlink(saved)
    if own.is_file() and (is_dirt_stand_in(target) or (had_saved and not os.path.lexists(target))):
        link = target.with_name(target.name + ".droiddeck-tmp")
        if os.path.lexists(link):
            os.unlink(link)
        os.symlink(own, link)
        os.replace(link, target)
        return True
    return False


EGO_RESTRICTIONS = "system/hardware_settings_restrictions.xml"
EGO_CORE_RULE = re.compile(r'[ \t]*<restrict_if name="cores" op="(int_[a-z]+)" value="(\d+)">.*?</restrict_if>[ \t]*\r?\n', re.S)
EGO_OPS = {"int_eq": int.__eq__, "int_ne": int.__ne__, "int_ge": int.__ge__, "int_gt": int.__gt__,
           "int_le": int.__le__, "int_lt": int.__lt__}


def windows_core_count(env):
    count = (env.get("WINE_CPU_TOPOLOGY") or "").split(":", 1)[0]
    return int(count) if count.isascii() and count.isdigit() and int(count) > 0 else None


def ego_core_plan(command, env):
    count = windows_core_count(env)
    if not count or len(command) < 3:
        return None
    folder = Path(command[2]).parent
    path = folder / EGO_RESTRICTIONS
    try:
        raw = path.read_bytes()
    except OSError:
        return None
    text = raw.decode("latin-1")
    start, end = text.find("<cpu>"), text.find("</cpu>")
    if start < 0 or end < start:
        return None
    rules = list(EGO_CORE_RULE.finditer(text, start, end))
    if not rules or any(EGO_OPS.get(rule.group(1), lambda a, b: True)(count, int(rule.group(2))) for rule in rules):
        return None
    smaller = [rule for rule in rules if rule.group(1) == "int_eq" and int(rule.group(2)) < count]
    if not smaller:
        return None
    source = max(smaller, key=lambda rule: int(rule.group(2)))
    worker_map = re.search(r'workerMapFile="([^"]+)"', source.group(0))
    if worker_map and not (folder / worker_map.group(1)).is_file():
        return None
    plan = source.group(0).replace('value="%s"' % source.group(2), 'value="%d"' % count, 1)
    saved = path.with_name(path.name + DIRT_SAVED)
    if not os.path.lexists(saved):
        saved.write_bytes(raw)
    handle, staged = tempfile.mkstemp(prefix=path.name + ".", suffix=".droiddeck-tmp", dir=str(path.parent))
    try:
        with os.fdopen(handle, "wb") as out:
            out.write((text[:source.end()] + plan + text[source.end():]).encode("latin-1"))
        os.replace(staged, path)
    except BaseException:
        if os.path.lexists(staged):
            os.unlink(staged)
        raise
    return "%s had no thread plan for %d cores; added a copy of its %s-core plan" % (EGO_RESTRICTIONS, count, source.group(2))


def wait_forwarding_signals_raw(process):
    def forward(signum, frame):
        try:
            process.send_signal(signum)
        except OSError:
            pass

    previous = {signum: signal.signal(signum, forward) for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}
    try:
        code = process.wait()
    finally:
        for signum, handler in previous.items():
            signal.signal(signum, handler)
    return code


def wait_forwarding_signals(process):
    code = wait_forwarding_signals_raw(process)
    return 128 - code if code < 0 else code


def diagnostic_game_event(event, app_id, values=None):
    fields = ["event=" + event, "app_id=" + app_id]
    fields.extend("%s=%s" % item for item in (values or {}).items())
    print("DROIDDECK_DIAGNOSTICS " + " ".join(fields), file=sys.stderr, flush=True)


def diagnostic_game_exit(app_id, raw_code):
    normalized = 128 - raw_code if raw_code < 0 else raw_code
    diagnostic_game_event("game_exit", app_id, {
        "raw_status": raw_code,
        "normalized_status": normalized,
        "wrapper_status": normalized,
        "signal": -raw_code if raw_code < 0 else 0,
    })


# Low byte of the NTSTATUS a Windows process ended with: Wine's ntdll exits with
# get_unix_exit_code(status), the status truncated to 8 bits. A program's own exit(n)
# can collide, so these are likely causes, not proof.
WINE_EXIT_BYTES = {
    0x05: ("access_violation", "0xC0000005 access violation"),
    0x06: ("dotnet_internal_error", "0x80131506 .NET internal runtime error (or 0xC0000006 in-page error)"),
    0x09: ("fail_fast", "0xC0000409 fail-fast: a /GS check or .NET Environment.FailFast"),
    0x0E: ("out_of_memory", "0x8007000E E_OUTOFMEMORY, e.g. the .NET runtime could not reserve its heap"),
    0x17: ("out_of_memory", "0xC0000017 no memory"),
    0x1D: ("illegal_instruction", "0xC000001D illegal instruction (an x86 instruction the emulator did not run)"),
    0x52: ("dotnet_unhandled_exception", "0xE0434352 unhandled .NET exception"),
    0x94: ("divide_by_zero", "0xC0000094 integer divide by zero"),
    0x96: ("privileged_instruction", "0xC0000096 privileged instruction"),
    0xFD: ("stack_overflow", "0xC00000FD stack overflow"),
}
EXIT_SIGNALS = (4, 6, 7, 8, 9, 11, 15)


def signal_name(number):
    try:
        return signal.Signals(number).name
    except ValueError:
        return "signal %d" % number


def classify_game_exit(raw_code, seconds):
    """(class, detail) for the exit status of Proton's waitforexitandrun run."""
    if raw_code < 0:
        return "signal", "the Proton wrapper was ended by %s" % signal_name(-raw_code)
    if raw_code == 0:
        if seconds < 30:
            return "clean_early", "exit 0 after %d s: a quick quit, or the game's process was killed " \
                "(Wine records a Windows process killed from outside as exit 0)" % seconds
        return "clean", "exit 0 (also what Wine records when the game's process is killed from outside)"
    if 256 - raw_code in EXIT_SIGNALS:
        return "wine_signal", "Wine's steam.exe process was ended by %s (Proton exits with 256 - signal)" % \
            signal_name(256 - raw_code)
    if raw_code in WINE_EXIT_BYTES:
        name, text = WINE_EXIT_BYTES[raw_code]
        return name, "likely " + text
    return "exit_code", "exit code %d" % raw_code


# Games whose launches wait for Proton by default, so the exit status reaches the log
# (docs/research/crash-catalogue.md, C5 and I3): Slay the Spire 2.
EXIT_WATCH_GAMES = frozenset({"2868840"})


def exit_watch(app_id, env, pacing=False):
    """Wait for Proton instead of exec'ing it: DROIDDECK_GAME_EXIT_WATCH=1 or 0, else the per-game default,
    or when a pacing line was printed, whose cap the app ends at the game_exit line."""
    setting = env.get("DROIDDECK_GAME_EXIT_WATCH", "")
    if setting in ("0", "1"):
        return setting == "1"
    return app_id in EXIT_WATCH_GAMES or pacing


def report_game_exit(app_id, raw_code, seconds):
    kind, detail = classify_game_exit(raw_code, seconds)
    print('DROIDDECK_GAME_EXIT app=%s status=%d class=%s seconds=%d detail="%s"' %
          (app_id, raw_code, kind, seconds, detail.replace('"', "'")), file=sys.stderr, flush=True)


def timeline_game_exit(app_id, raw_code, started):
    print("DROIDDECK_TIMELINE event=game_exit app_id=%s status=%d signal=%d run_ms=%d wall_ms=%d" % (
        app_id, 128 - raw_code if raw_code < 0 else raw_code, -raw_code if raw_code < 0 else 0,
        int((time.monotonic() - started) * 1000), int(time.time() * 1000)), file=sys.stderr, flush=True)


# win32u/driver.c load_desktop_driver: the default driver_load_error, which nodrv_CreateWindow prints on
# err:winediag when the desktop never registered a graphics driver. That process then waits in user32 for
# ever without a window.
EXPLORER_FAILED = b"The explorer process failed to start."
EXPLORER_WINDOW_S = 300
EXPLORER_POLL_S = 1.0
EXPLORER_KILL_WAIT_S = 15
EXPLORER_DRAIN_S = 5
PIPE_BUF = 4096


def proton_log_path(env):
    """Where Proton sends Wine's output instead of stderr (its setup_logging), or None."""
    value = env.get("PROTON_LOG", "")
    if not value or value == "0" or not env.get("SteamGameId"):
        return None
    return (env.get("PROTON_LOG_DIR") or env.get("HOME", "")) + "/steam-" + env["SteamGameId"] + ".log"


def explorer_watch_wanted(launch, env):
    return env.get("DROIDDECK_EXPLORER_WATCHDOG") != "0" and "waitforexitandrun" in launch[1:]


def with_winediag(env):
    """Proton's default WINEDEBUG=-all hides err:winediag, the channel the explorer failure is printed on."""
    debug = env.get("WINEDEBUG", "")
    if debug:
        return env if debug.rsplit(",", 1)[-1] == "err+winediag" else dict(env, WINEDEBUG=debug + ",err+winediag")
    return env if proton_log_path(env) else dict(env, WINEDEBUG="-all,err+winediag")


def wineserver_for(launch, env):
    candidates = [env.get("WINESERVER", "")]
    if "waitforexitandrun" in launch[1:]:
        proton = os.path.dirname(launch[launch.index("waitforexitandrun", 1) - 1])
        candidates += [os.path.join(proton, sub, "wineserver") for sub in ("files/bin-arm64", "files/bin", "files/bin-wow64")]
    candidates.append(shutil.which("wineserver", path=env.get("PATH", os.defpath)) or "")
    return next((path for path in candidates if path and os.path.isfile(path) and os.access(path, os.X_OK)), None)


def descendants(pid, proc="/proc"):
    children = {}
    try:
        entries = os.listdir(proc)
    except OSError:
        return []
    for entry in entries:
        if not entry.isdigit():
            continue
        try:
            with open("%s/%s/stat" % (proc, entry), "rb") as f:
                parent = int(f.read().rsplit(b")", 1)[1].split()[1])
        except (OSError, IndexError, ValueError):
            continue
        children.setdefault(parent, []).append(int(entry))
    found, queue = [], [pid]
    while queue:
        for child in children.get(queue.pop(), ()):
            if child not in found:
                found.append(child)
                queue.append(child)
    return found


def file_identity(path):
    try:
        st = os.stat(path)
        return (st.st_dev, st.st_ino), st.st_size
    except OSError:
        return None, 0


class StderrRelay:
    """Copies a child's stderr to ours in whole lines, each write at most PIPE_BUF so it stays as atomic as
    the child's own, and shows every chunk to a scanner. It keeps reading after ours fails, so the child
    never blocks on a full pipe."""

    def __init__(self, fd, scan, out=2):
        self.fd, self.scan, self.out = fd, scan, out
        self.broken = False
        self.thread = threading.Thread(target=self.run, name="stderr-relay", daemon=True)
        self.thread.start()

    def write(self, data):
        while data and not self.broken:
            try:
                data = data[os.write(self.out, data):]
            except InterruptedError:
                continue
            except OSError:
                self.broken = True

    def write_lines(self, data):
        while data:
            cut = len(data) if len(data) <= PIPE_BUF else \
                (data.rfind(b"\n", 0, PIPE_BUF) + 1 or data.find(b"\n") + 1 or len(data))
            self.write(data[:cut])
            data = data[cut:]

    def run(self):
        pending = b""
        try:
            while True:
                if pending and not select.select([self.fd], [], [], 0.5)[0]:
                    self.write(pending)
                    pending = b""
                    continue
                try:
                    data = os.read(self.fd, 65536)
                except OSError:
                    break
                if not data:
                    break
                text = pending + data
                cut = text.rfind(b"\n") + 1
                self.write_lines(text[:cut])
                pending = text[cut:]
                self.scan(data)
                if len(pending) >= PIPE_BUF:
                    self.write(pending)
                    pending = b""
        finally:
            self.write(pending)
            os.close(self.fd)


class ExplorerGuard:
    """One launch attempt, watched for Wine's explorer failure during its first EXPLORER_WINDOW_S. On the
    first attempt the failure ends that attempt's Wine (wineserver -k for the prefix, then the Proton process
    tree) so the caller can start the game once more; on a later attempt it is only reported."""

    def __init__(self, launch, env, app_id, attempt=1, signalled=lambda: False):
        self.launch, self.env, self.app_id, self.attempt = launch, env, app_id, attempt
        self.signalled = signalled
        self.log = proton_log_path(env)
        self.lock = threading.Lock()
        self.exited = threading.Event()
        self.closed = self.fired = self.ended = False
        self.process = self.killer = self.relay = None
        self.tail = b""
        self.how = ""
        self.started = self.deadline = 0.0

    def spawn(self):
        self.started = time.monotonic()
        self.deadline = self.started + EXPLORER_WINDOW_S
        if self.log:
            before = file_identity(self.log)
            self.process = subprocess.Popen(self.launch, env=self.env)
            threading.Thread(target=self.follow, args=(before,), name="explorer-log", daemon=True).start()
        else:
            self.process = subprocess.Popen(self.launch, env=self.env, stderr=subprocess.PIPE)
            fd = os.dup(self.process.stderr.fileno())
            self.process.stderr.close()
            self.process.stderr = None
            self.relay = StderrRelay(fd, self.scan)
        return self.process

    def scan(self, data):
        if self.fired or self.closed or time.monotonic() > self.deadline:
            return
        text = self.tail + data
        if EXPLORER_FAILED in text:
            self.fire()
        else:
            self.tail = text[1 - len(EXPLORER_FAILED):]

    def follow(self, before):
        """With PROTON_LOG on, Proton deletes the old log and writes Wine's output to a new one."""
        identity, offset = before
        while not self.exited.wait(EXPLORER_POLL_S) and not self.fired and time.monotonic() <= self.deadline:
            current, size = file_identity(self.log)
            if current is None:
                continue
            if current != identity or size < offset:
                identity, offset = current, 0
            try:
                with open(self.log, "rb") as f:
                    f.seek(offset)
                    while not self.fired:
                        data = f.read(1 << 20)
                        if not data:
                            break
                        offset += len(data)
                        self.scan(data)
            except OSError:
                continue

    def fire(self):
        with self.lock:
            if self.fired or self.closed or self.exited.is_set():
                return
            self.fired = True
            self.killer = threading.Thread(target=self.end, name="explorer-end", daemon=True)
            self.killer.start()

    def end(self):
        retry = self.attempt == 1 and not self.signalled()
        print("droiddeck-game-env: Wine reports its desktop (explorer.exe) never started, so the game cannot open a "
              "window; %s" % ("ending this launch's Wine and starting the game once more" if retry else
                              "the launch is left as it is (end the game from Steam)"), file=sys.stderr, flush=True)
        print("DROIDDECK_TIMELINE event=game_explorer_failed app_id=%s attempt=%d action=%s run_ms=%d wall_ms=%d" % (
            self.app_id, self.attempt, "relaunch" if retry else "none", int((time.monotonic() - self.started) * 1000),
            int(time.time() * 1000)), file=sys.stderr, flush=True)
        if not retry:
            return
        self.ended = True
        server = wineserver_for(self.launch, self.env)
        killed = False
        if server:
            prefix = os.path.join(self.env.get("STEAM_COMPAT_DATA_PATH", ""), "pfx")
            try:
                killed = subprocess.run([server, "-k"], env=dict(self.env, WINEPREFIX=prefix), stdin=subprocess.DEVNULL,
                                        stdout=subprocess.DEVNULL, timeout=EXPLORER_KILL_WAIT_S).returncode == 0
            except (OSError, subprocess.SubprocessError):
                pass
        self.how = "wineserver" if killed else ""
        if killed and self.exited.wait(EXPLORER_KILL_WAIT_S):
            return
        if not self.exited.is_set():
            for pid in descendants(self.process.pid)[::-1] + [self.process.pid]:
                try:
                    os.kill(pid, signal.SIGKILL)
                except OSError:
                    pass
            self.how = (self.how + "+" if self.how else "") + "tree"

    def finished(self):
        with self.lock:
            self.closed = True
            killer = self.killer
        self.exited.set()
        if killer:
            killer.join()

    def keep_log(self):
        """The next attempt's Proton deletes the log this attempt wrote."""
        if self.log and os.path.isfile(self.log):
            try:
                os.replace(self.log, self.log[:-len(".log")] + "-explorer-failed.log")
            except OSError:
                pass


def run_watched(guard):
    """Waits for the first attempt's Proton with SIGTERM, SIGINT and SIGHUP forwarded as
    wait_forwarding_signals_raw does, and starts it once more when Wine's desktop never came up on it and no
    signal asked the launch to stop. Returns the raw status and start time of the attempt that ended the
    launch, and a drain that waits a little for the relayed stderr to close."""
    state = {"process": guard.process, "signalled": False}
    guard.signalled = lambda: state["signalled"]

    def forward(signum, frame):
        state["signalled"] = True
        if state["process"] is not None:
            try:
                state["process"].send_signal(signum)
            except OSError:
                pass

    relays = []
    previous = {signum: signal.signal(signum, forward) for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}
    retry_env = None
    try:
        attempt = 1
        while True:
            if attempt > 1:
                again = ExplorerGuard(guard.launch, retry_env or guard.env, guard.app_id, attempt,
                                      lambda: state["signalled"])
                try:
                    state["process"] = again.spawn()
                except OSError as error:
                    print("droiddeck-game-env: the game could not be started again (%s)" % error, file=sys.stderr, flush=True)
                    break
                guard = again
                if state["signalled"]:
                    guard.process.terminate()
            if guard.relay:
                relays.append(guard.relay)
            raw_code = guard.process.wait()
            guard.finished()
            state["process"] = None
            if not guard.ended or state["signalled"] or attempt > 1:
                break
            guard.keep_log()
            attempt += 1
            retry_env = without_wayland_present(guard.env)
            print("DROIDDECK_TIMELINE event=game_relaunch app_id=%s attempt=%d reason=explorer_failed ended_by=%s "
                  "display=%s wall_ms=%d" % (guard.app_id, attempt, guard.how or "none", "x11" if retry_env else "same",
                                             int(time.time() * 1000)), file=sys.stderr, flush=True)
            if retry_env:
                print("droiddeck-game-env: wayland-present taken back out for the second start; Wine uses Xwayland",
                      file=sys.stderr, flush=True)
    finally:
        for signum, handler in previous.items():
            signal.signal(signum, handler)

    def drain():
        end = time.monotonic() + EXPLORER_DRAIN_S
        for relay in relays:
            relay.thread.join(max(0.0, end - time.monotonic()))
    return raw_code, guard.started, drain


def start(launch, launch_env, digest, after=None, diagnostic_app_id=None, timeline_app_id=None, watch=False, cores=None):
    if len(launch) > 1 and launch[1] == "waitforexitandrun":
        ubisoft_composition_off(launch[0], launch_env)
    launch, launch_env = system_graphics_launch(launch, launch_env)
    waited = bool(after or diagnostic_app_id is not None or watch)
    explorer = bool(waited and timeline_app_id and explorer_watch_wanted(launch, launch_env))
    if explorer:
        launch_env = with_winediag(launch_env)
    record_final_env(launch, launch_env)
    started = time.monotonic()
    if waited:
        if explorer:
            guard = ExplorerGuard(launch, launch_env, timeline_app_id)
            process = guard.spawn()
        else:
            process = subprocess.Popen(launch, env=launch_env)
        if diagnostic_app_id is not None:
            diagnostic_game_event("game_start", diagnostic_app_id)
        drain = None
        core_watch = CoreWatch(cores, timeline_app_id).start() if cores else None
        try:
            if explorer:
                raw_code, started, drain = run_watched(guard)
            else:
                raw_code = wait_forwarding_signals_raw(process)
        finally:
            if core_watch:
                core_watch.stop()
            if after:
                try:
                    after()
                except OSError as error:
                    print("droiddeck-game-env: DiRT telemetry fix: prefix ws2_32 not put back (%s); the next launch does it" % error,
                          file=sys.stderr)
        code = 128 - raw_code if raw_code < 0 else raw_code
        if digest and after is None and code == 0:
            record_install_scripts(digest, launch_env)
        if diagnostic_app_id is not None:
            diagnostic_game_exit(diagnostic_app_id, raw_code)
        if timeline_app_id:
            timeline_game_exit(timeline_app_id, raw_code, started)
            report_game_exit(timeline_app_id, raw_code, int(time.monotonic() - started))
        if drain:
            drain()
        return code
    if digest:
        code = subprocess.run(launch, env=launch_env, check=False).returncode
        if timeline_app_id:
            timeline_game_exit(timeline_app_id, code, started)
            report_game_exit(timeline_app_id, code, int(time.monotonic() - started))
        if code == 0:
            record_install_scripts(digest, launch_env)
        return code
    return os.execvpe(launch[0], launch, launch_env)


class SystemGraphicsError(ValueError):
    pass


def system_graphics_launch(command, env):
    """Use the APK's PowerVR compatibility files only for actual Proton game launches."""
    runtime = env.get("DROIDDECK_POWERVR_RUNTIME")
    if not runtime or not game_id(env) or len(command) < 3 or command[1] != "waitforexitandrun":
        return command, env
    directory = Path(runtime)
    if not directory.is_absolute():
        raise SystemGraphicsError("system Vulkan runtime path is not absolute")
    # run-proton.py picks the same payload by name; Xclipse needs a DXVK within 128 bytes of push data.
    payload = env.get("DROIDDECK_HYBRIS_DXVK") or "dxvk"
    if not payload.startswith("dxvk") or "/" in payload:
        raise SystemGraphicsError("invalid DXVK payload name: %s" % payload)
    required = (
        "run-proton.py", "wsi/libVkLayer_window_system_integration.so",
        "wsi/VkLayer_window_system_integration.json", "lib/libVkLayer_hybris_compat.so",
        *("%s/%s/%s.dll" % (payload, arch, name) for arch in ("x32", "x64")
          for name in ("d3d8", "d3d9", "d3d10core", "d3d11", "dxgi")),
    )
    try:
        for name in required:
            path = directory / name
            if not path.is_file() or not path.stat().st_size:
                raise SystemGraphicsError("missing system Vulkan component: %s" % name)
        wrapper = directory / "run-proton.py"
        if not os.access(wrapper, os.X_OK):
            raise SystemGraphicsError("system Vulkan Proton wrapper is not executable")
    except OSError as error:
        raise SystemGraphicsError("system Vulkan component is unreadable: %s" % error) from error
    result = dict(env)
    layers = "VK_LAYER_window_system_integration:" + env.get("DROIDDECK_HYBRIS_LAYERS", "VK_LAYER_HYBRIS_compat")
    result.update({
        "HYBRIS_BC_TEXTURES": "dxvk",
        "VK_LAYER_PATH": ":".join(filter(None, (str(directory / "wsi"), str(directory / "lib"),
                                                env.get("DROIDDECK_HYBRIS_LAYER_PATH")))),
        "VK_INSTANCE_LAYERS": layers,
        "ENABLE_GAMESCOPE_WSI": "0",
        "VK_LOADER_LAYERS_DISABLE": "*gamescope*",
        "DISABLE_VK_LAYER_VALVE_steam_fossilize_1": "1",
    })
    for name in ("DISABLE_WSI_LAYER", "PROTON_USE_WINED3D", "ENABLE_VK_LAYER_VALVE_steam_fossilize_1"):
        result.pop(name, None)
    for note in (wayland_present(directory, result), hybris_index(result), vk_count(result),
                 dxvk_arm64ec(directory, result)):
        if note:
            print("droiddeck-game-env: " + note, file=sys.stderr)
    return [str(wrapper), *command], result


VKCOUNT_DIR = "/usr/local/lib/droiddeck-vkcount"
DXVK_ARM64EC = "dxvk-arm64ec"
DXVK_NAMES = ("d3d8", "d3d9", "d3d10core", "d3d11", "dxgi")


def dxvk_arm64ec(directory, env):
    """Experiment dxvk-arm64ec: a 64-bit Direct3D game gets the runtime's dxvk-arm64ec payload in place of the
    default x86-64 one, so DXVK runs as native ARM64EC code instead of through FEX. Same DXVK source and patches
    (tools/dxvk/build_arm64ec.sh); 32-bit games keep a translated i686 build. Vulkan-native games (Slay the Spire 2)
    only load its dxgi.dll to list adapters, so they should not change. Independent of two-frames and
    layer-fence. Only the default payload is replaced, never Xclipse's."""
    if not experiment(env, DXVK_ARM64EC):
        return None
    if (env.get("DROIDDECK_HYBRIS_DXVK") or "dxvk") != "dxvk":
        return "dxvk-arm64ec: kept the %s payload" % env["DROIDDECK_HYBRIS_DXVK"]
    for arch in ("x32", "x64"):
        for name in DXVK_NAMES:
            path = Path(directory) / DXVK_ARM64EC / arch / (name + ".dll")
            if not path.is_file() or not path.stat().st_size:
                return "dxvk-arm64ec: payload not in this runtime (%s)" % path
    env["DROIDDECK_HYBRIS_DXVK"] = DXVK_ARM64EC
    return "dxvk-arm64ec: 64-bit DXVK runs as native ARM64EC"
HYBRIS_COMPAT_DIR = "/usr/local/lib/droiddeck-hybris-compat"


def hybris_index(env, layer_dir=HYBRIS_COMPAT_DIR):
    """Experiment hybris-index: the game gets VK_LAYER_DROIDDECK_hybris_compat in place of the runtime's
    VK_LAYER_HYBRIS_compat. It is the same libhybris source and patches plus tools/hybris/compat-layer's, which
    index the per-call lookups (command buffers, images, pipeline layouts, entry points) that otherwise walk every
    live object on each bind, push and barrier."""
    if not experiment(env, "hybris-index"):
        return None
    layers = env.get("VK_INSTANCE_LAYERS", "").split(":")
    if "VK_LAYER_DROIDDECK_hybris_compat" in layers:
        return "hybris-index: already indexed for the whole session (hybris-index-session)"
    if "VK_LAYER_HYBRIS_compat" not in layers:
        return "hybris-index: the game has no hybris compat layer to replace"
    if not os.path.isfile(os.path.join(layer_dir, "libVkLayer_droiddeck_hybris_compat.so")):
        return "hybris-index: layer not installed at %s" % layer_dir
    env["VK_INSTANCE_LAYERS"] = ":".join(
        "VK_LAYER_DROIDDECK_hybris_compat" if layer == "VK_LAYER_HYBRIS_compat" else layer for layer in layers)
    env["VK_LAYER_PATH"] = layer_dir + ":" + env["VK_LAYER_PATH"]
    return "hybris-index: indexed hybris compat layer"


def vk_count(env, layer_dir=VKCOUNT_DIR):
    """Experiment vk-count: VK_LAYER_DROIDDECK_vkcount goes first in the game's layers and prints per-frame Vulkan
    call counts and blocking-call times to stderr every 10 s ("droiddeck-vkcount:" lines in the game's log)."""
    if not experiment(env, "vk-count"):
        return None
    if not os.path.isfile(os.path.join(layer_dir, "libVkLayer_droiddeck_vkcount.so")):
        return "vk-count: layer not installed at %s" % layer_dir
    env["VK_INSTANCE_LAYERS"] = "VK_LAYER_DROIDDECK_vkcount:" + env["VK_INSTANCE_LAYERS"]
    env["VK_LAYER_PATH"] = layer_dir + ":" + env["VK_LAYER_PATH"]
    return "vk-count: counting Vulkan calls per frame"


# winewayland.drv's wayland_process_init gives up, and the driver unloads, unless the compositor offers all of
# these. Wine then has no display driver, and explorer.exe never starts (seen on gamescope, Nov 13: no
# wl_subcompositor).
WINE_WAYLAND_GLOBALS = ("wl_compositor", "wl_subcompositor", "xdg_wm_base", "wl_shm")
WAYLAND_PROBE_S = 2.0


def wayland_globals(socket, env, timeout=WAYLAND_PROBE_S):
    """The interface names a Wayland server advertises, read over the wire protocol (wl_display.get_registry,
    then wl_display.sync, collecting wl_registry.global until the sync's done), or None when it cannot be read."""
    import socket as sockets
    path = socket if socket.startswith("/") else \
        os.path.join(env.get("XDG_RUNTIME_DIR") or os.environ.get("XDG_RUNTIME_DIR", ""), socket)
    names = set()
    try:
        with sockets.socket(sockets.AF_UNIX, sockets.SOCK_STREAM) as conn:
            conn.settimeout(timeout)
            conn.connect(path)
            conn.sendall(struct.pack("=IIIIII", 1, (12 << 16) | 1, 2, 1, (12 << 16) | 0, 3))
            data, end = b"", time.monotonic() + timeout
            while time.monotonic() < end:
                chunk = conn.recv(65536)
                if not chunk:
                    return None
                data += chunk
                while len(data) >= 8:
                    obj, word = struct.unpack_from("=II", data)
                    size, opcode = word >> 16, word & 0xFFFF
                    if size < 8 or len(data) < size:
                        if size < 8:
                            return None
                        break
                    body, data = data[8:size], data[size:]
                    if obj == 3 and opcode == 0:
                        return names
                    if obj == 1 and opcode == 0:
                        return None
                    if obj == 2 and opcode == 0 and len(body) >= 8:
                        length = struct.unpack_from("=I", body, 4)[0]
                        names.add(body[8:8 + max(0, length - 1)].decode("ascii", "replace"))
    except (OSError, struct.error):
        return None
    return None


def without_wayland_present(env):
    """The launch environment with wayland-present taken back out, so Wine falls back to its X11 driver on
    Xwayland; None when wayland-present never went in."""
    if env.get("PROTON_ENABLE_WAYLAND") != "1" or not experiment(env, "wayland-present"):
        return None
    env = dict(env, WAYLAND_DISPLAY="")
    for key in ("PROTON_ENABLE_WAYLAND", "DISABLE_WINE_WAYLAND_STEAM_OVERLAY_LAYER"):
        env.pop(key, None)
    return env


def wayland_present(directory, env):
    """Experiment wayland-present: Wine's Wayland driver hands the game's frames to gamescope's own Wayland
    socket, so the game's Xwayland and its DRI3 Present round trip drop out of every frame. The session sets
    WAYLAND_DISPLAY empty for Steam, and libwayland connects to an empty name as no socket at all (it falls back to
    wayland-0 only when the variable is unset), so the socket is named explicitly. Needs a WSI layer built with
    VK_KHR_wayland_surface. That layer connects to nothing itself: it only uses the wl_display a Wayland surface
    hands it. Proton's Wayland Steam-overlay layer stays out of the game's Vulkan chain."""
    if not experiment(env, "wayland-present"):
        return None
    socket = env.get("GAMESCOPE_WAYLAND_DISPLAY", "").strip()
    if not socket:
        return "wayland-present: no gamescope Wayland socket; the game stays on Xwayland"
    try:
        manifest = (directory / "wsi" / "VkLayer_window_system_integration.json").read_text(encoding="utf-8")
    except OSError as error:
        return "wayland-present: WSI layer manifest unreadable (%s); the game stays on Xwayland" % error
    if "VK_KHR_wayland_surface" not in manifest:
        return "wayland-present: this WSI layer has no Wayland surface; the game stays on Xwayland"
    globals_seen = wayland_globals(socket, env)
    if globals_seen is None:
        return "wayland-present: gamescope's Wayland socket did not answer; the game stays on Xwayland"
    missing = [name for name in WINE_WAYLAND_GLOBALS if name not in globals_seen]
    if missing:
        return "wayland-present: gamescope's Wayland socket lacks %s, which Wine's Wayland driver needs; the game " \
               "stays on Xwayland" % ",".join(missing)
    env["WAYLAND_DISPLAY"] = socket
    env["PROTON_ENABLE_WAYLAND"] = "1"
    # With Steam's overlay preloaded, Proton would add GE's Wayland Steam-overlay Vulkan layer to the game's
    # chain. It is untested on the PowerVR path and only bridges the in-game overlay's input.
    env["DISABLE_WINE_WAYLAND_STEAM_OVERLAY_LAYER"] = "1"
    return "wayland-present: Wine's Wayland driver presents to gamescope (%s), skipping the game's Xwayland" % socket


# PROTON_LOG=1 alone makes Proton default WINEDEBUG to +seh,+unwind,... (proton_10.0 `proton` 1618-1619):
# every caught .NET exception then writes hundreds of unwind lines from the thread that threw it.
GAME_LOG_WINEDEBUG = "+timestamp,+pid,+tid,+threadname,+loaddll"
FINAL_ENV_PREFIXES = ("VK_", "WINE", "DOTNET_", "DXVK_", "VKD3D", "PROTON_", "FEX_", "HYBRIS_", "MESA_", "GODOT", "SteamGameId", "WAYLAND")


def game_logs(command, env, app_id, now=None):
    """Detailed graphics logs for one game launch, in the session's log folder: Proton's own log,
    DXVK's and vkd3d-proton's, and the Vulkan driver's startup messages. The app turns this on
    (BL_GAME_LOGS=1) on a GPU that is not an Adreno, or with Setup's "Detailed graphics logs"."""
    if env.get("BL_GAME_LOGS") != "1" or not env.get("BL_DEBUG_DIR") or len(command) < 3 \
            or command[1] != "waitforexitandrun":
        return env
    import time
    stamp = time.strftime("%Y%m%d-%H%M%S", time.localtime(now))
    name = app_id or re.sub(r"[^A-Za-z0-9._-]+", "_", Path(command[2]).stem)[:40] or "game"
    parent = Path(env["BL_DEBUG_DIR"]) / "games"
    try:
        parent.mkdir(parents=True, exist_ok=True)
        folder = Path(tempfile.mkdtemp(prefix=stamp + "-", suffix="-" + name, dir=parent))
    except OSError as error:
        print("droiddeck-game-env: no game log folder (%s)" % error, file=sys.stderr)
        return env
    result = dict(env)
    if not env.get("WINEDEBUG"):
        result["WINEDEBUG"] = GAME_LOG_WINEDEBUG
        print("droiddeck-game-env: game log Wine channels %s (Proton's +seh,+unwind default stays off)" % GAME_LOG_WINEDEBUG,
              file=sys.stderr)
    result.update({
        "DROIDDECK_GAME_LOG_DIR": str(folder),
        "PROTON_LOG": "1",
        "PROTON_LOG_DIR": str(folder),
        "DXVK_LOG_PATH": str(folder),
        "DXVK_LOG_LEVEL": env.get("DXVK_LOG_LEVEL", "info"),
        "VKD3D_LOG_FILE": str(folder / "vkd3d.log"),
        "VKD3D_DEBUG": env.get("VKD3D_DEBUG", "warn"),
        "VKD3D_SHADER_DEBUG": env.get("VKD3D_SHADER_DEBUG", "none"),
        "MESA_LOG_FILE": str(folder / "mesa.log"),
        "PANVK_DEBUG": env.get("PANVK_DEBUG", "startup"),
    })
    try:
        (folder / "launch.txt").write_text("\n".join([
            "app: %s" % (app_id or "-"),
            "exe: %s" % command[2],
            "proton: %s" % command[0],
            "started: %s" % time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(now)),
        ] + ["%s=%s" % (key, env[key]) for key in sorted(env)
             if key.startswith(("VK_", "BL_VK", "BL_DRM", "BL_OPEN", "MESA_", "PANVK", "DXVK_", "VKD3D", "ZINK", "TU_", "DROIDDECK_VKD3D"))]) + "\n")
    except OSError:
        pass
    # Whether the game's sound reaches PulseAudio: the streams 20 s and 60 s in, without waiting.
    try:
        subprocess.Popen(["sh", "-c", 'for t in 20 40; do sleep $t; { echo "== $(date +%T)"; '
                          'pactl list sink-inputs 2>&1 | head -80; } >> "$1/audio-streams.txt"; done', "audio", str(folder)],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        pass
    return result


DOTNET_TRACE = "/usr/local/bin/droiddeck-dotnet-trace"
# GC (0x1), JIT (0x10, verbose for method names) and GC heap-history (0x400000000) events, plus runtime counters.
DOTNET_TRACE_PROVIDERS = ("Microsoft-Windows-DotNETRuntime:0x400000011:5,"
                          "System.Runtime:0:4:EventCounterIntervalSec=1")
DOTNET_TRACE_EVERY_S = 60


def windows_path(path):
    return "Z:" + str(path).replace("/", "\\")


def dotnet_trace(command, env, popen=subprocess.Popen):
    """(env, note): under dotnet-trace, a .NET game writes its GC events and System.Runtime counters as an
    EventPipe trace into its log folder, and droiddeck-dotnet-trace turns the trace into dotnet-gc.txt,
    dotnet-counters.txt and dotnet-summary.txt there every minute and at the game's exit."""
    if not experiment(env, "dotnet-trace") or len(command) < 3 or "coreclr.dll" not in game_files(command[2]):
        return env, None
    folder = env.get("DROIDDECK_GAME_LOG_DIR")
    if not folder:
        return env, "dotnet-trace: no game log folder (detailed graphics logs off), so no trace"
    if any(name in env for name in ("DOTNET_EnableEventPipe", "COMPlus_EnableEventPipe")):
        return env, "dotnet-trace: EventPipe already set in the environment; left as it is"
    result = dict(env, DOTNET_EnableEventPipe="1", DOTNET_EventPipeOutputStreaming="1", DOTNET_EventPipeRundown="0",
                  DOTNET_EventPipeOutputPath=windows_path(Path(folder) / "dotnet-{pid}.nettrace"),
                  DOTNET_EventPipeConfig=DOTNET_TRACE_PROVIDERS)
    try:
        popen([sys.executable, DOTNET_TRACE, folder, "--watch", str(DOTNET_TRACE_EVERY_S), "--pid", str(os.getpid())],
              stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as error:
        return result, "dotnet-trace: trace on, summary not started (%s)" % error
    return result, "dotnet-trace: GC events and runtime counters to %s, summarised every %d s" % (
        folder, DOTNET_TRACE_EVERY_S)


DOTNET_R2R = "/usr/local/bin/droiddeck-dotnet-r2r"
DOTNET_R2R_MANIFEST = os.path.expanduser("~/.cache/droiddeck-r2r/manifest.json")
DOTNET_R2R_APPLY_S = 120


def dotnet_folder(exe):
    """The folder that holds a .NET game's coreclr.dll: the exe's own or one level below it, or None."""
    folder = os.path.dirname(os.path.abspath(exe))
    if os.path.exists(os.path.join(folder, "coreclr.dll")):
        return folder
    try:
        with os.scandir(folder) as top:
            for entry in sorted(top, key=lambda e: e.name):
                if entry.is_dir(follow_symlinks=False) and os.path.exists(os.path.join(entry.path, "coreclr.dll")):
                    return entry.path
    except OSError:
        pass
    return None


def dotnet_r2r(command, env, run=subprocess.run, popen=subprocess.Popen):
    """Notes for the session log. For a .NET game, droiddeck-dotnet-r2r writes to dotnet-r2r.txt in the log
    folder which of its assemblies ship precompiled. Under dotnet-r2r, the game's own IL-only assemblies are
    swapped for x64 ReadyToRun images compiled on the phone before the game starts, and what is not compiled
    yet is compiled in the background for the next launch. With the switch off, every swapped file is put
    back. dotnet-r2r-bubble does the same with one version bubble over the game and the framework copy it
    ships, so the framework's generics over the game's types are precompiled as well."""
    if len(command) < 3 or command[1] != "waitforexitandrun":
        return []
    folder = dotnet_folder(command[2])
    if not folder:
        return []
    log_dir = env.get("DROIDDECK_GAME_LOG_DIR")
    log = ["--log", str(Path(log_dir) / "dotnet-r2r.txt")] if log_dir else []
    tool = [sys.executable, DOTNET_R2R]
    notes = []
    bubble = experiment(env, "dotnet-r2r-bubble")
    on = bubble or experiment(env, "dotnet-r2r")
    mode = ["--bubble"] if bubble else []
    if on or os.path.exists(DOTNET_R2R_MANIFEST):
        try:
            result = run(tool + ["apply", folder, "--on" if on else "--off"] + mode + log, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=DOTNET_R2R_APPLY_S)
            lines = (result.stderr or b"").decode(errors="replace").strip().splitlines()
            notes.append("dotnet-r2r: " + (lines[-1] if lines else "apply exit %s" % result.returncode))
        except (OSError, subprocess.TimeoutExpired) as error:
            notes.append("dotnet-r2r: apply failed (%s)" % error)
    background = ["status", folder] + log if not on else ["compile", folder] + mode + log
    if on or log_dir:
        try:
            popen(["nice", "-n", "19"] + tool + background, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                  stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError as error:
            notes.append("dotnet-r2r: %s not started (%s)" % (background[0], error))
    return notes


NATIVE_INVENTORY = "/usr/local/bin/droiddeck-native-inventory"


def native_inventory(exe, env, popen=subprocess.Popen):
    """Under native-inventory, a Godot game's folder is inventoried in the background (names, counts and
    sizes only) for the native-engine work; the result goes to the session log and the telemetry bundle."""
    if not experiment(env, "native-inventory"):
        return []
    try:
        popen(["nice", "-n", "19", sys.executable, NATIVE_INVENTORY, "--game-dir", os.path.dirname(os.path.abspath(exe))],
              stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=None, start_new_session=True)
    except OSError as error:
        return ["native-inventory: not started (%s)" % error]
    return ["native-inventory: started for %s" % os.path.basename(os.path.dirname(os.path.abspath(exe)))]


NATIVE_GODOT = "/usr/local/bin/droiddeck-native-godot"
# A native run that ends sooner than this with an error is taken as "did not start"; the game then starts on Proton.
NATIVE_START_S = 60
# droiddeck-native-godot's own exit when the engine drew no first frame (none within its timeout, or it ended before
# one): the game never started natively, however long that took, so it starts on Proton.
NATIVE_NO_FIRST_FRAME = 86


def native_engine(command, env, run=subprocess.run, clock=time.monotonic):
    """Under native-engine, a Godot C# game (a data_*_windows_x86_64 folder next to the exe) runs on Kestrel's
    own linux-arm64 engine. Returns the exit code to end with, or None to go on to Proton."""
    if not experiment(env, "native-engine") or len(command) < 3:
        return None, []
    exe = os.path.abspath(command[2])
    folder = os.path.dirname(exe)
    try:
        managed = [n for n in os.listdir(folder) if n.startswith("data_") and n.endswith("_windows_x86_64")]
    except OSError:
        managed = []
    if len(managed) != 1:
        return None, ["native-engine: not a Godot C# game; Proton"]
    out = os.path.join(os.path.expanduser("~"), ".cache", "droiddeck", "native", "launch", game_id(env) or "game")
    args = [sys.executable, NATIVE_GODOT, "run", "--fetch", "--game-dir", folder, "--exe", os.path.basename(exe),
            "--out", out, "--"] + list(command[3:])
    log_dir = env.get("DROIDDECK_GAME_LOG_DIR") or env.get("BL_DEBUG_DIR")
    path = os.path.join(log_dir, "native-engine.log") if log_dir else None
    log = None
    if path:
        try:
            log = open(path, "a", encoding="utf-8")
        except OSError:
            log, path = None, None
    began = clock()
    try:
        rc = run(args, env=env, stdin=subprocess.DEVNULL, stdout=log or None, stderr=subprocess.STDOUT if log else None).returncode
    except OSError as error:
        return None, ["native-engine: could not start (%s); Proton" % error]
    finally:
        if log:
            log.close()
    took = clock() - began
    notes = []
    if rc != 0 and path:
        try:
            with open(path, encoding="utf-8", errors="replace") as f:
                notes = ["native-engine log: " + line.rstrip() for line in f.readlines()[-30:]]
        except OSError:
            pass
    if rc == NATIVE_NO_FIRST_FRAME:
        return None, notes + ["native-engine: no first frame after %.0f s; starting on Proton" % took]
    if rc != 0 and took < NATIVE_START_S:
        return None, notes + ["native-engine: exited with %d after %.0f s; starting on Proton" % (rc, took)]
    return rc, notes + ["native-engine: ran %.0f s natively, exit %d" % (took, rc)]


def load_warmup():
    try:
        return runpy.run_path(str(Path(__file__).resolve().parent / "droiddeck-warmup"))
    except Exception as error:  # optional settings: a fault here must not stop the game
        print("droiddeck-game-env: warmup: settings skipped (%s)" % error, file=sys.stderr)
        return None


def warmup_launch(command, env, app_id, phases):
    """FEX disk cache, .NET tiering profile and launch-prep timing (droiddeck-warmup)."""
    warmup = load_warmup()
    if warmup is None:
        return env
    timer = warmup["Timer"]()
    timer.phases = list(phases)
    prefix = env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    try:
        env = timer.time("warmup", warmup["apply"], command, env, app_id, prefix, game_files(command[2]))
    except Exception as error:  # optional settings: a fault here must not stop the game
        print("droiddeck-game-env: warmup: settings skipped (%s)" % error, file=sys.stderr)
    timer.report(app_id)
    return env


def record_final_env(launch, env):
    """Appends what the game is really started with to launch.txt: the launch above is written
    before later steps change the Vulkan layers, WINEDEBUG and the .NET settings."""
    folder = env.get("DROIDDECK_GAME_LOG_DIR")
    if not folder:
        return
    lines = ["== final environment (%s)" % " ".join(launch[:2])]
    lines += ["%s=%s" % (key, env[key]) for key in sorted(env) if key.startswith(FINAL_ENV_PREFIXES)]
    try:
        with open(os.path.join(folder, "launch.txt"), "a", encoding="utf-8") as out:
            out.write("\n".join(lines) + "\n")
    except OSError:
        pass


def exec_proton(command, env):
    # Synchronization selection has already picked the actual Proton executable.
    command, env = system_graphics_launch(command, env)
    os.execvpe(command[0], command, env)


def main():
    command = sys.argv[1:]
    if not command:
        return 2
    if command[0] == THREAD_CHECK and len(command) == 2:
        return thread_check(command[1])
    env = game_gpu(os.environ.copy())
    steam_experiments = experiments(env)
    env = without_experiments(env)
    mic_enabled = env.get("BL_MIC_ENABLED")
    debug_dir = env.get("BL_DEBUG_DIR", "")
    prefix_path = env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    app_id = game_id(env)
    components = ""
    waiting = bool(app_id and len(command) > 1 and command[1] == "waitforexitandrun")
    config = {}
    launch_config = None
    launch_config_valid = True
    effective_env = env
    if waiting:
        path = Path.home() / ".config/droiddeck/game-environment.json"
        try:
            with path.open(encoding="utf-8") as source:
                config = json.load(source)
            launch_config = config
        except FileNotFoundError:
            launch_config = {"version": 1}
        except (OSError, ValueError, TypeError, AttributeError):
            launch_config_valid = False
        if launch_config_valid:
            try:
                effective_env = apply_config(env, launch_config, app_id)
            except (OSError, ValueError, TypeError, AttributeError):
                launch_config_valid = False
        if not launch_config_valid:
            print("droiddeck-game-env: invalid configuration; using inherited environment", file=sys.stderr)
        print("droiddeck-game-env: " + experiments_line(experiments(effective_env), steam_experiments),
              file=sys.stderr, flush=True)
    phases = []
    if waiting:
        began = time.monotonic()
        components = win_components(prefix_path, app_id, command[0], effective_env)
        phases.append(("components", int((time.monotonic() - began) * 1000)))
    if prefix_path and command:
        began = time.monotonic()
        try:
            fixed = repair_foreign_system_dlls(prefix_path, command[0], effective_env)
        except OSError as error:
            fixed = []
            print("droiddeck-game-env: prefix system DLL check skipped (%s)" % error, file=sys.stderr)
        phases.append(("prefix DLL check", int((time.monotonic() - began) * 1000)))
        if fixed:
            print("droiddeck-game-env: replaced foreign-architecture system DLLs with this Proton's own: %s" % ", ".join(fixed),
                  file=sys.stderr)
    scripts = mark_install_scripts(command, env)
    if scripts and install_scripts_done(scripts, env):
        print("droiddeck-game-env: install scripts already run in this prefix; evaluator skipped", file=sys.stderr)
        return 0
    if scripts and not env.get("DBUS_SESSION_BUS_ADDRESS"):
        # libdbus would autolaunch a session bus under the evaluator's reaper, which then waits for it
        # forever: Steam keeps seeing the app as running and cannot move or update it
        env["DBUS_SESSION_BUS_ADDRESS"] = "disabled:"
    try:
        digest = scripts_digest(scripts) if scripts else None
    except OSError:
        digest = None
    diagnostic_app_id = app_id if waiting and os.environ.get("DROIDDECK_ENHANCED_DIAGNOSTICS") == "1" else None
    dirt_prefix = None
    if app_id:
        gl_default = gl_vsync(env)
        if waiting:
            game_images(env)
        fixes = {}
        if waiting:
            command = skip_red_launcher(command)
            ubisoft_overlay_off(env)
            project_zomboid_jvm(command)
            fixes, extra, notes = engine_fixes(command[2], command[3:], effective_env) if len(command) > 2 else ({}, [], [])
            if len(command) > 2:
                game = Game(command[2], command[3:], effective_env)
                if is_godot(game):
                    try:
                        if experiment(effective_env, "godot-render"):
                            notes += godot_files(game)
                        else:
                            notes += [note for note in (godot_override(game),) if note]
                    except (OSError, ValueError) as error:
                        notes.append("Godot: cache and log check skipped (%s)" % error)
                    notes += native_inventory(command[2], effective_env)
                    native_rc, native_notes = native_engine(command, effective_env)
                    for note in native_notes:
                        print("droiddeck-game-env: " + note, file=sys.stderr, flush=True)
                    if native_rc is not None:
                        return native_rc
            if not gl_default:
                fixes.pop("vblank_mode", None)
            for note in notes:
                print("droiddeck-game-env: " + note, file=sys.stderr)
            command = with_args(command, extra) if experiment(effective_env, "godot-render") else command + extra
            if components:
                own = fixes.get("WINEDLLOVERRIDES")
                fixes["WINEDLLOVERRIDES"] = components + ";" + own if own else components
            dirt_prefix = dirt_ws2_wanted(command, env)
            if dirt_prefix:
                own = fixes.get("WINEDLLOVERRIDES")
                fixes["WINEDLLOVERRIDES"] = own + ";ws2_32=n,b" if own else "ws2_32=n,b"
        if waiting:
            if launch_config_valid:
                if "vblank_mode" in config.get("shared", {}):
                    fixes.pop("vblank_mode", None)
                env = apply_config(env, launch_config, app_id, fixes)
        else:
            path = Path.home() / ".config/droiddeck/game-environment.json"
            try:
                with path.open(encoding="utf-8") as source:
                    config = json.load(source)
                env = apply_config(env, sync_config(config, app_id), app_id)
            except FileNotFoundError:
                pass
            except (OSError, ValueError, TypeError, AttributeError):
                print("droiddeck-game-env: invalid configuration; using inherited environment", file=sys.stderr)
        if waiting:
            before_debug = env
            env = apply_game_debug_logs(env, config, debug_dir)
            if env is not before_debug:
                print("droiddeck-game-env: game debug logs enabled for this launch", file=sys.stderr)
            print("droiddeck-game-env: " + fex_tso_settings(env), file=sys.stderr)
        if gl_default and env.get("vblank_mode") == "0":
            print("droiddeck-game-env: OpenGL does not wait for the screen refresh (vblank_mode=0)", file=sys.stderr)
    if app_id and len(command) > 1 and command[1] == "waitforexitandrun":
        command = offline_without_anticheat(command, env)
        if experiment(env, "fex-codegen"):
            env, notes = fex_memory_model(command, env)
            for note in notes:
                print("droiddeck-game-env: " + note, file=sys.stderr)
    if experiment(env, "fex-stats"):
        # FEX keeps per-thread JIT/SMC/SIGBUS counters in /dev/shm/fex-<pid>-stats; the app logs them to fex.csv.
        env = dict(env, FEX_PROFILESTATS="1")
    if experiment(env, "fex-l1"):
        # FEX's per-thread block lookup starts at 8k entries and grows only after seconds of misses, flushing on
        # every resize. A fixed table halved first-call time off-device. Kestrel's FEX (patch 0004) takes the size:
        # 256k entries (4 MB per thread) kept nearly all of the gain of the full 1M for well under half the memory.
        # Other FEX builds ignore FEX_L1CACHEENTRIES and use the full 1M (16 MB per thread, touched as used).
        env = dict(env, FEX_DYNAMICL1CACHE="0", FEX_L1CACHEENTRIES="262144")
    if experiment(env, "fex-code-buffer"):
        # FEX's code buffer starts at 16 MB; when it fills, every thread's translated code is thrown away and
        # retranslated into a buffer twice the size. Starting at 64 MB (Kestrel's FEX, patch 0006) avoided that
        # off-device: translation time warm -28%, first run -9 to -15%, no extra memory. Other builds ignore it.
        env = dict(env, FEX_INITIALCODEBUFFERMB="64")
    if experiment(env, "fex-sample"):
        # Kestrel's FEX (patch 0007) samples each emulated thread 250 times per second of its own CPU time and once a
        # minute writes the busiest thread's top 200 guest locations to /dev/shm/fex-<pid>-samples.csv; the app
        # copies them to fex-samples.csv. About 0.1% of a sampled thread. Other FEX builds ignore FEX_SAMPLEHZ.
        env = dict(env, FEX_SAMPLEHZ="250")
    env = game_logs(command, env, app_id)
    if mic_enabled == "0":
        env["AUDIO_DIRECT_MIC"] = "0"
    env = directaudio_settings(env)
    env = vram_cap(env)
    if app_id and len(command) > 1 and command[1] == "waitforexitandrun" and experiment(env, "memory"):
        env, note = dotnet_heap(env, app_id)
        if note:
            print(note, file=sys.stderr)
    if app_id and len(command) > 2 and command[1] == "waitforexitandrun":
        env, note = dotnet_trace(command, env)
        if note:
            print("droiddeck-game-env: " + note, file=sys.stderr)
        for note in dotnet_r2r(command, env):
            print("droiddeck-game-env: " + note, file=sys.stderr)
    note = render_path_defaults(command, env) if app_id else None
    if note:
        print("droiddeck-game-env: " + note, file=sys.stderr)
    note = bridge_feature_level(env)
    if note:
        print("droiddeck-game-env: " + note, file=sys.stderr)
    env = force_ssbs(command, env)
    game_cores(env)
    core_plan = cpu_topology(env, command)
    pacing = None
    if app_id and len(command) > 2 and command[1] == "waitforexitandrun":
        command, note = frame_cap(command, env)
        if note:
            print("droiddeck-game-env: " + note, file=sys.stderr)
        pacing = pacing_line(env, app_id)
        if pacing:
            print(pacing, file=sys.stderr, flush=True)
        start_thread_check(command, env)
        try:
            note = ego_core_plan(command, env)
        except OSError as error:
            note = "no thread plan added for this core count (%s)" % error
        if note:
            print("droiddeck-game-env: " + note, file=sys.stderr)
    after = None
    prefix = env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    if app_id and prefix and len(command) > 1 and command[1] == "waitforexitandrun":
        try:
            if dirt_prefix:
                after = lambda: restore_dirt_ws2(dirt_prefix, command[0])
                swap_dirt_ws2(dirt_prefix)
                print("droiddeck-game-env: DiRT telemetry fix: ws2_32 stand-in in the prefix until the game exits",
                      file=sys.stderr)
            elif restore_dirt_ws2(prefix, command[0]):
                print("droiddeck-game-env: DiRT telemetry fix: put the prefix's own ws2_32 back", file=sys.stderr)
        except OSError as error:
            print("droiddeck-game-env: DiRT telemetry fix not applied (%s)" % error, file=sys.stderr)
            if after:
                after = None
                try:
                    restore_dirt_ws2(dirt_prefix, command[0])
                except OSError as undo:
                    print("droiddeck-game-env: DiRT telemetry fix: prefix ws2_32 not put back (%s); Wine uses its own copy "
                          "and the next launch puts the file back" % undo, file=sys.stderr)
    if app_id and len(command) > 2 and command[1] == "waitforexitandrun" and experiment(env, "warmup"):
        env = warmup_launch(command, env, app_id, phases)
    env, note = keep_caller_env(os.environ, env)
    if note:
        print("droiddeck-game-env: " + note, file=sys.stderr)
    watch = bool(waiting and app_id and exit_watch(app_id, env, bool(pacing)))
    sync = load_sync()
    launch, launch_env = select_sync(command, env, sync)
    if waiting and experiment(env, "free-memory"):
        print("droiddeck-game-env: free memory: " + free_memory(os.environ.get("BL_LAUNCH_DIR"), app_id),
              file=sys.stderr, flush=True)
    if waiting:
        print("DROIDDECK_TIMELINE event=game_exec app_id=%s wall_ms=%d" % (app_id, int(time.time() * 1000)),
              file=sys.stderr, flush=True)
    core_plan = core_plan if waiting and app_id else None
    if launch[0] != command[0]:
        try:
            return start(launch, launch_env, digest, after, diagnostic_app_id, app_id if waiting else None, watch, core_plan)
        except OSError as error:
            print("droiddeck-game-env: %s could not start (%s); stock launch" % (launch[0], error), file=sys.stderr)
            launch, launch_env = command, without_pack(launch_env, env)
            record_stock(sync, launch, launch_env)
    try:
        return start(launch, launch_env, digest, after, diagnostic_app_id, app_id if waiting else None, watch, core_plan)
    except OSError:
        if after:
            try:
                after()
            except OSError as error:
                print("droiddeck-game-env: DiRT telemetry fix: prefix ws2_32 not put back (%s); the next launch does it" % error,
                      file=sys.stderr)
        raise


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemGraphicsError as error:
        print("droiddeck-game-env: PowerVR graphics runtime unavailable (%s)" % error, file=sys.stderr)
        sys.exit(1)

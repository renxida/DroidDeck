#!/usr/bin/env python3
"""Steam account and binary shortcuts.vdf helpers, loaded by droiddeck-proton-run."""
import os
import re
import struct


def account_dir(steam_root):
    users = os.path.join(steam_root, "config", "loginusers.vdf")
    recent, best = None, None
    try:
        with open(users, encoding="utf-8", errors="replace") as f:
            text = f.read()
        for block in re.finditer(r'"(\d{5,})"\s*\{([^}]*)\}', text):
            stamp = re.search(r'"timestamp"\s*"(\d+)"', block.group(2))
            rank = (bool(re.search(r'"MostRecent"\s*"1"', block.group(2))),
                    bool(re.search(r'"AutoLogin"\s*"1"', block.group(2))),
                    int(stamp.group(1)) if stamp else 0)
            if any(rank) and (best is None or rank >= best):
                recent, best = int(block.group(1)), rank
    except OSError:
        pass
    userdata = os.path.join(steam_root, "userdata")
    if recent is not None:
        acct = recent - 76561197960265728
        return os.path.join(userdata, str(acct))
    try:
        dirs = [d for d in os.listdir(userdata) if d.isdigit() and d != "0"]
    except OSError:
        dirs = []
    return os.path.join(userdata, dirs[0]) if len(dirs) == 1 else None


def parse(data):
    pos = [0]

    def cstr():
        end = data.index(b"\x00", pos[0])
        s = data[pos[0]:end].decode("utf-8", "replace")
        pos[0] = end + 1
        return s

    def node():
        out = {}
        while True:
            t = data[pos[0]]
            pos[0] += 1
            if t == 0x08:
                return out
            key = cstr()
            if t == 0x00:
                out[key] = node()
            elif t == 0x01:
                out[key] = cstr()
            elif t == 0x02:
                out[key] = struct.unpack_from("<i", data, pos[0])[0]
                pos[0] += 4
            else:
                raise ValueError("unknown vdf type 0x%02x" % t)

    t = data[pos[0]]
    pos[0] += 1
    key = cstr()
    return {key: node()}


def write(obj):
    out = bytearray()

    def emit(key, value):
        if isinstance(value, dict):
            out.append(0x00)
            out.extend(key.encode() + b"\x00")
            for k, v in value.items():
                emit(k, v)
            out.append(0x08)
        elif isinstance(value, int):
            out.append(0x02)
            out.extend(key.encode() + b"\x00" + struct.pack("<i", value))
        else:
            out.append(0x01)
            out.extend(key.encode() + b"\x00" + str(value).encode() + b"\x00")

    for k, v in obj.items():
        emit(k, v)
    out.append(0x08)
    return bytes(out)

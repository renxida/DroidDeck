#!/usr/bin/env python3
"""Ask the running native Steam client which of the given app IDs the account owns.

Usage: droiddeck-steam-games probe <steam_root> <appid>...
"""
import ctypes as C
import json
import os
from pathlib import Path
import sys
import time

BASE_ID = 76561197960265728


def method(obj, slot, result, *args):
    if not obj:
        raise RuntimeError("Steam interface unavailable")
    table = C.cast(obj, C.POINTER(C.POINTER(C.c_void_p))).contents
    return C.CFUNCTYPE(result, C.c_void_p, *args)(table[slot])


def probe(steam_root, ids):
    library = C.CDLL(os.environ.get("BL_STEAMCLIENT") or str(Path(steam_root) / "steamrtarm64/steamclient.so"))
    library.CreateInterface.argtypes = [C.c_char_p, C.c_void_p]
    library.CreateInterface.restype = C.c_void_p
    client = library.CreateInterface(b"SteamClient020", None)
    pipe = method(client, 0, C.c_int)(client)
    if not pipe:
        raise RuntimeError("Steam pipe unavailable")
    user = 0
    try:
        user = method(client, 2, C.c_int, C.c_int)(client, pipe)
        if not user:
            raise RuntimeError("No signed-in Steam user")
        get_interface = lambda slot, version: method(client, slot, C.c_void_p, C.c_int, C.c_int, C.c_char_p)(client, user, pipe, version)
        account = get_interface(5, b"SteamUser021")
        if not method(account, 1, C.c_bool)(account):
            raise RuntimeError("Steam is offline")
        steamid = method(account, 2, C.c_uint64)(account)
        apps = get_interface(15, b"STEAMAPPS_INTERFACE_VERSION008")
        subscribed = method(apps, 6, C.c_bool, C.c_uint32)
        return {"account": str(steamid - BASE_ID), "checked": time.time(),
                "owned": {str(appid): bool(subscribed(apps, appid)) for appid in ids}}
    finally:
        if user:
            method(client, 4, None, C.c_int, C.c_int)(client, pipe, user)
        method(client, 1, C.c_bool, C.c_int)(client, pipe)


if __name__ == "__main__":
    if len(sys.argv) < 4 or sys.argv[1] != "probe":
        sys.exit(2)
    try:
        print("DROIDDECK_OWNERSHIP=" + json.dumps(probe(sys.argv[2], [int(value) for value in sys.argv[3:]])), flush=True)
    except (OSError, RuntimeError, ValueError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)

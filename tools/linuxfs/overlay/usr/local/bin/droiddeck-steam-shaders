#!/usr/bin/python3
from pathlib import Path
import runpy
import sys


VDF = runpy.run_path(str(Path(__file__).with_name("droiddeck-steam-ui-scale")))
PATH = ("Software", "Valve", "Steam", "ShaderCacheManager", "DisableShaderCache")


def set_text(text, enabled):
    value = "0" if enabled else "1"
    updated, changed = VDF["seed_value"](text, PATH, value)
    if changed:
        return updated, True
    block = VDF["parse"](text).get("InstallConfigStore")
    for section in PATH[:-1]:
        block = block.get(section)
    current = block.get(PATH[-1])
    if isinstance(current, VDF["Block"]):
        raise ValueError("invalid DisableShaderCache setting")
    if current == value:
        return text, False
    at = block.offset(PATH[-1])
    end = VDF["TOKEN"].match(text, at).end()
    return text[:at] + f'"{value}"' + text[end:], True


def apply(steam_root, enabled):
    config = Path(steam_root) / "config/config.vdf"
    text = config.read_text() if config.exists() else '"InstallConfigStore"\n{\n}\n'
    updated, changed = set_text(text, enabled)
    if changed:
        VDF["atomic_write"](config, updated)
    return changed


def state(steam_root):
    """"off" when config.vdf disables pre-caching, "on" otherwise (the client's default), None without a config."""
    config = Path(steam_root) / "config/config.vdf"
    if not config.is_file():
        return None
    block = VDF["parse"](config.read_text()).get("InstallConfigStore")
    for section in PATH[:-1]:
        block = block.get(section) if isinstance(block, VDF["Block"]) else None
    value = block.get(PATH[-1]) if isinstance(block, VDF["Block"]) else None
    return "off" if value == "1" else "on"


def system_driver_default(choice_file, roots):
    """The phone's own Vulkan driver (through libhybris) keeps no pipeline cache that Steam's
    fossilize_replay could fill, so pre-caching only competes with the game for CPU and memory
    as it starts. Turned off unless DroidDeck's own switch last chose it on."""
    try:
        choice = Path(choice_file).read_text().strip()
    except OSError:
        choice = ""
    if choice == "1":
        print("== steam: shader pre-caching left on: chosen in DroidDeck")
        return 0
    status = 0
    for root in roots:
        if not Path(root).is_dir():
            continue
        try:
            if apply(root, False):
                print(f"DROIDDECK_SHADER_PRECACHE off reason=system-vulkan-driver root={root}")
        except (OSError, ValueError, RecursionError) as error:
            print(f"== steam: left shader pre-caching unchanged in {root}: {error}", file=sys.stderr)
            status = 1
    return status


if __name__ == "__main__":
    if len(sys.argv) >= 2 and sys.argv[1] == "--state":
        for root in sys.argv[2:]:
            try:
                value = state(root)
            except (OSError, ValueError, RecursionError, AttributeError) as error:
                value = "unreadable (%s)" % error
            if value is not None:
                print(f"== steam: shader pre-caching {value} in {root}")
        sys.exit(0)
    if len(sys.argv) >= 3 and sys.argv[1] == "--system-driver":
        sys.exit(system_driver_default(sys.argv[2], sys.argv[3:]))
    if len(sys.argv) < 3 or sys.argv[1] not in ("0", "1"):
        print("usage: droiddeck-steam-shaders <0|1|--system-driver CHOICE_FILE|--state> <steam root>...", file=sys.stderr)
        sys.exit(2)
    enabled = sys.argv[1] == "1"
    status = 0
    for root in sys.argv[2:]:
        if not Path(root).is_dir():
            continue
        try:
            if apply(root, enabled):
                print(f"== steam: shader pre-caching {'on' if enabled else 'off'} in {root}")
        except (OSError, ValueError, RecursionError) as error:
            print(f"== steam: left shader pre-caching unchanged in {root}: {error}", file=sys.stderr)
            status = 1
    sys.exit(status)

#!/usr/bin/env python3
"""Inventory of what a Godot game needs from native engine pieces, for the native-engine work.

droiddeck-game-env starts this in the background under the native-inventory experiment, for Godot games.
It reads the game's own files where they are installed and prints names, counts and sizes only, never
file contents: which GDExtensions the pack declares and what their config says, which Spine skeletons
the pack holds (format and version), which FMOD banks there are and how their audio is encoded, and
which Spine and FMOD names the game's managed code uses. The work is done once per game build and kept
under /var/tmp/droiddeck; every later session writes the kept result again so it reaches telemetry.

Output:
    stderr (the session log): DROIDDECK_NATIVE_INVENTORY_SUMMARY {json}, a short summary
    /var/tmp/droiddeck/native-inventory.txt: the full report as JSON, which the telemetry bundle picks up
    /var/tmp/droiddeck/native-samples.zip: a handful of the game's skeleton, atlas and sound bank files,
        and the few text scenes and resources that show how the game uses them
        (Cedar agreed on Nov 13 to send a few to the private telemetry repository so their formats can be
        decoded for the clean-room runtimes). At most SAMPLE_BUDGET bytes; never anything else.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import struct
import sys
import time
import zipfile

SCHEMA = 5  # 2: JSON lines, Vorbis setup ids, imported pairing, FSB5 slice; 3: Spine 4.2 binary survey;
           # 4: text scene and resource survey, compiled GDScript identifier and string tables
           # 5: the largest files, every font and its import source, and the game's mod, font and locale names
PREFIX = "DROIDDECK_NATIVE_INVENTORY"
MAX_LIST = 4000
MAX_GDEXT_BYTES = 8192
SCAN_HEAD = 4096
READ_CHUNK = 4 << 20
CACHE_DIR = Path("/var/tmp/droiddeck")
REPORT = CACHE_DIR / "native-inventory.txt"
SAMPLES = CACHE_DIR / "native-samples.zip"
SAMPLE_BUDGET = 3 << 20
SAMPLE_FILE_MAX = 1536 << 10
HEAD_MAX = 2 << 20
SAMPLES_VERSION = 5  # 2: bank metadata heads and skeletons with layouts the survey cannot read yet;
                     # 3: the smallest scenes using SpineSprite, the bone and slot nodes, and an FMOD emitter
                     # 4: also the smallest skeleton for each stage and kind of read error
                     # 5: the survey reads path and physics constraints, path attachments and timelines,
                     #    named skins and deform keys, so the read errors left are new ones
REPORT_LINE_MAX = 8000
FOURCC = re.compile(rb"^[A-Za-z0-9 _]{4}$")
VERSION_TEXT = re.compile(rb"(?<![0-9.])([34])\.(\d)\.(\d{1,3})(?![0-9])")
FMOD_PATH = re.compile(rb"(?:event|bus|vca|snapshot|bank|parameter):/[\x20-\x7e]{0,200}")
NAME_HINTS = ("spine", "fmod", "anim", "skin", "bone", "slot", "track", "event", "bank", "param", "bus", "vca",
              "sound", "audio", "music", "sfx", "attach", "skeleton", "mix", "loop", "volume", "pitch", "play",
              "stop", "emitter", "listener", "snapshot")
SNAKE = re.compile(r"^[a-z][a-z0-9_]{1,47}$")
BIG_FILES = 80
FONT_EXT = (".fontdata", ".ttf", ".otf", ".ttc", ".woff", ".woff2", ".fnt")
# Names in the game's assemblies that say how it loads mods (extra .pck files), fonts and locales.
LOADER_NAME = re.compile(r"Mod(?!ulat|el|ifie|e(?:[A-Z0-9_s]|$)|al(?![a-z]))|ResourcePack|Pck|pck|Font|font|Locale|locale|Language")
LOADER_LITERAL = re.compile(r"(?i)\.pck|\bmods?\b|mod_|manifest|font|locale|res://")
LOADER_MAX = 600
FSB_CODECS = {0: "none", 1: "pcm8", 2: "pcm16", 3: "pcm24", 4: "pcm32", 5: "pcmfloat", 6: "gcadpcm",
              7: "imaadpcm", 8: "vag", 9: "hevag", 10: "xma", 11: "mpeg", 12: "celt", 13: "at9", 14: "xwma",
              15: "vorbis", 16: "fadpcm", 17: "opus"}


def say(line):
    print(line, file=sys.stderr, flush=True)


# --- Godot pack (format from Godot's own MIT sources: core/io/file_access_pack) -----------------------------

def read_pack(path):
    """{"version", "godot", "flags", "files": [(name, offset, size, flags)]} or {"error"}."""
    with open(path, "rb") as f:
        head = f.read(8)
        start = 0
        if head[:4] != b"GDPC":
            # A pack embedded at the end of an executable: [.. pack ..][u64 pack size]["GDPC"].
            f.seek(-12, os.SEEK_END)
            tail = f.read(12)
            if tail[8:] != b"GDPC":
                return {"error": "no GDPC header"}
            size = struct.unpack("<Q", tail[:8])[0]
            start = f.seek(-12 - size, os.SEEK_END)
            head = f.read(8)
            if head[:4] != b"GDPC":
                return {"error": "embedded pack header not found"}
        version = struct.unpack("<I", head[4:8])[0]
        major, minor, patch, flags = struct.unpack("<4I", f.read(16))
        file_base = struct.unpack("<Q", f.read(8))[0]
        dir_offset = None
        if version >= 3:
            dir_offset = struct.unpack("<Q", f.read(8))[0]
        f.read(16 * 4)
        if flags & 2:
            file_base += start
        if flags & 1:
            return {"version": version, "godot": "%d.%d.%d" % (major, minor, patch), "flags": flags,
                    "error": "directory encrypted"}
        if dir_offset:
            f.seek(start + dir_offset)
        count = struct.unpack("<I", f.read(4))[0]
        if count > 2_000_000:
            return {"version": version, "error": "implausible file count %d" % count}
        files = []
        for _ in range(count):
            length = struct.unpack("<I", f.read(4))[0]
            if length > 4096:
                return {"version": version, "error": "bad entry after %d files" % len(files)}
            name = f.read(length).rstrip(b"\0").decode("utf-8", "replace")
            offset, size = struct.unpack("<QQ", f.read(16))
            f.read(16)
            entry_flags = struct.unpack("<I", f.read(4))[0]
            if name.startswith("res://"):
                name = name[6:]
            files.append((name, file_base + offset, size, entry_flags))
    return {"version": version, "godot": "%d.%d.%d" % (major, minor, patch), "flags": flags, "files": files}


class Source:
    """A file either loose on disk or inside the pack."""

    def __init__(self, name, path, offset, size, encrypted=False):
        self.name, self.path, self.offset, self.size, self.encrypted = name, path, offset, size, encrypted

    def read(self, start=0, length=None):
        length = self.size - start if length is None else min(length, self.size - start)
        if length <= 0:
            return b""
        with open(self.path, "rb") as f:
            f.seek(self.offset + start)
            return f.read(length)

    def chunks(self):
        done = 0
        with open(self.path, "rb") as f:
            f.seek(self.offset)
            while done < self.size:
                block = f.read(min(READ_CHUNK, self.size - done))
                if not block:
                    return
                yield done, block
                done += len(block)


def ext_of(name):
    base = name.rsplit("/", 1)[-1].lower()
    for double in (".skel.bytes", ".atlas.txt", ".strings.bank"):
        if base.endswith(double):
            return double
    return "." + base.rsplit(".", 1)[-1] if "." in base else ""


# --- Spine skeletons: format, version and, for JSON, which features appear -----------------------------------

def json_features(data):
    """Generic walk of a JSON skeleton: counts per top-level section, attachment types and every key seen
    under animations, so the feature set shows without knowing the format."""
    out = {"format": "json"}
    skeleton = data.get("skeleton") if isinstance(data, dict) else None
    if isinstance(skeleton, dict):
        out["version"] = skeleton.get("spine")
        out["skeleton_keys"] = sorted(skeleton)
    sections = {}
    for key, value in (data.items() if isinstance(data, dict) else ()):
        sections[key] = len(value) if isinstance(value, (list, dict)) else type(value).__name__
    out["sections"] = sections
    types, anim_keys, keys = {}, {}, {}

    def walk(node, in_anim, depth):
        if depth > 12:
            return
        if isinstance(node, dict):
            if isinstance(node.get("type"), str):
                types[node["type"]] = types.get(node["type"], 0) + 1
            for k, v in node.items():
                if in_anim:
                    anim_keys[k] = anim_keys.get(k, 0) + 1
                walk(v, in_anim, depth + 1)
        elif isinstance(node, list):
            for v in node[:2000]:
                walk(v, in_anim, depth + 1)

    for key in ("bones", "slots", "ik", "transform", "path", "physics", "skins", "events"):
        if isinstance(data, dict) and key in data:
            walk(data[key], False, 1)
            for item in data[key] if isinstance(data[key], list) else ():
                if isinstance(item, dict):
                    for k in item:
                        keys.setdefault(key, {})
                        keys[key][k] = keys[key].get(k, 0) + 1
    if isinstance(data, dict) and "animations" in data:
        walk(data["animations"], True, 1)
    out["attachment_types"] = types
    out["animation_keys"] = dict(sorted(anim_keys.items(), key=lambda kv: -kv[1])[:200])
    out["section_keys"] = keys
    return out


def skeleton_info(src):
    head = src.read(0, SCAN_HEAD)
    info = {"name": src.name, "size": src.size}
    stripped = head.lstrip()
    if stripped[:1] == b"{":
        try:
            info.update(json_features(json.loads(src.read().decode("utf-8", "replace"))))
        except ValueError as error:
            info["format"] = "json?"
            info["error"] = str(error)[:120]
        return info
    if head[:4] == b"RSRC":
        info["container"] = "godot-resource"
    match = VERSION_TEXT.search(head)
    if match:
        info["version"] = match.group(0).decode()
        info["version_at"] = match.start()
        info["format"] = "binary"
        if match.group(0).startswith(b"4.2.") and match.start() == 9 and src.size <= (64 << 20):
            info["survey"] = skel_survey(src.read())
        # Bytes before the version: lets the header layout be checked without copying any data.
        info["pre_version_bytes"] = match.start()
    else:
        info["format"] = "unknown"
    if b"{\"skeleton\"" in head or b"\"skeleton\":" in head:
        info["embedded_json"] = True
    return info


# --- Spine 4.2 binary skeletons: walk the whole file and count features (no data kept) ----------------------
# The layout is the one our own loader reads (native_compat/skel/skel_binary.cpp, checked byte for byte on
# three of the game's skeletons); this walk follows it step for step, with the same index and count checks,
# so a skeleton it cannot read is one the loader cannot read either. Walking every skeleton on the device
# says whether that layout holds for all of them, and which features the clean-room runtime needs, without
# sending any more files.

class SkelReader:
    def __init__(self, blob):
        self.b, self.p, self.strings = blob, 0, []

    def left(self):
        return len(self.b) - self.p

    def skip(self, n):
        if self.p + n > len(self.b):
            raise IndexError("past end")
        self.p += n

    def byte(self):
        self.skip(1)
        return self.b[self.p - 1]

    def flt(self):
        self.skip(4)
        return struct.unpack_from(">f", self.b, self.p - 4)[0]

    def i32(self):
        self.skip(4)
        return struct.unpack_from(">i", self.b, self.p - 4)[0]

    def varint(self):
        """7 bits a byte, low group first, at most 5 bytes, kept to 32 bits."""
        out = 0
        for shift in range(0, 35, 7):
            b = self.byte()
            out |= (b & 0x7F) << shift
            if not b & 0x80:
                return out & 0xFFFFFFFF
        raise ValueError("varint longer than 5 bytes")

    def count(self):
        """An element count: every element takes at least a byte, so a larger count means a misread."""
        n = self.varint()
        if n > self.left():
            raise ValueError("count %d over the %d bytes left" % (n, self.left()))
        return n

    def index(self, limit, what):
        i = self.varint()
        if i >= limit:
            raise ValueError("bad %s index %d of %d" % (what, i, limit))
        return i

    def string(self):
        n = self.varint()
        if n == 0:
            return None
        if n - 1 > self.left():
            raise IndexError("string past end")
        self.p += n - 1
        return self.b[self.p - n + 1:self.p].decode("utf-8", "replace")

    def ref(self):
        """A string-table reference: None for 0, otherwise the entry ("" for an empty or null one)."""
        i = self.varint()
        if i == 0:
            return None
        if i > len(self.strings):
            raise ValueError("string ref %d of %d" % (i, len(self.strings)))
        return self.strings[i - 1]


SKEL_BONE_CHANNELS = {0: 1, 1: 2, 2: 1, 3: 1, 4: 2, 5: 1, 6: 1, 7: 2, 8: 1, 9: 1}
SKEL_SLOT_BYTES = {1: 4, 2: 3, 3: 7, 4: 6, 5: 1}  # rgba, rgb, rgba+rgb, rgb+rgb, alpha
SKEL_SLOT_CHANNELS = {1: 4, 2: 3, 3: 7, 4: 6, 5: 1}


def skel_survey(blob):
    """Walk a Spine 4.2 binary skeleton; returns feature counts and whether the walk ended exactly at the
    end of the file (the check that the layout was read right)."""
    r, c = SkelReader(blob), {}

    def add(key, n=1):
        c[key] = c.get(key, 0) + n

    def segment(channels):
        # The curve from the previous frame to this one: 0 linear, 1 stepped, 2 bezier with 4 floats a channel.
        kind = r.byte()
        if kind == 2:
            r.skip(16 * channels)
            add("bezier_segments")
        elif kind == 1:
            add("stepped_segments")
        elif kind:
            raise ValueError("unknown curve kind %d" % kind)

    def curves(frames, channels, value_bytes):
        for f in range(frames):
            r.skip(4 + value_bytes)
            if f:
                segment(channels)

    def vertices(count, weighted):
        """Skips one attachment's vertices; returns how many floats a deform key of it holds."""
        if not weighted:
            r.skip(8 * count)
            return 2 * count
        influences = 0
        for _ in range(count):
            n = r.count()
            influences += n
            for _ in range(n):
                r.index(bones, "vertex bone")
                r.skip(12)
        return 2 * influences

    def constraint_bones():
        n = r.count()
        for _ in range(n):
            r.index(bones, "constraint bone")
        return n

    def attachment(key, slot, table):
        """Skips one attachment; records in [table] how many floats its deform keys hold."""
        flags = r.byte()
        kind = flags & 7
        add("attachment_%d" % kind)
        if kind == 7:
            raise ValueError("attachment type %d (layout unknown)" % kind)
        if kind in (0, 2, 3):  # region, mesh and linked mesh: 8 name, 16 path, 32 color, 64 sequence
            if flags & 8:
                r.ref()
            if flags & 16:
                r.ref()
            if flags & 32:
                r.skip(4)
            if flags & 64:
                add("sequences")
                for _ in range(4):
                    r.varint()
        length = 0
        if kind == 0:
            r.skip(4 * bool(flags & 128) + 24)
        elif kind == 1:  # bounding box: 16 weighted
            length = vertices(r.count(), flags & 16)
            r.skip(4 * nonessential)
        elif kind == 2:  # mesh: 128 weighted
            hull, count = r.varint(), r.count()
            length = vertices(count, flags & 128)
            r.skip(8 * count)
            tris = (2 * count - hull - 2) * 3
            if tris < 0 or tris > r.left():
                raise ValueError("mesh %s: bad triangle count" % key)
            for _ in range(tris):
                if r.varint() >= count:
                    raise ValueError("triangle index out of range")
            if nonessential:
                for _ in range(r.count()):
                    r.varint()
                r.skip(8)
        elif kind == 3:  # linked mesh: its skin (none means the default skin) and parent mesh
            skin, parent = r.ref(), r.ref() or ""
            r.skip(8 * nonessential)
            links.append((table, (slot, key), skin, parent))
        elif kind == 4:  # path: 16 closed, 32 constant speed, 64 weighted; one length per 3 vertices
            if flags & 8:
                raise ValueError("path attachment flag 8 (layout unknown)")
            count = r.count()
            length = vertices(count, flags & 64)
            r.skip(4 * (count // 3) + 4 * nonessential)
        elif kind == 5:  # point
            r.skip(12 + 4 * nonessential)
        else:  # 6, clipping: end slot, 16 weighted
            r.index(slots, "clipping end slot")
            length = vertices(r.count(), flags & 16)
            r.skip(4 * nonessential)
        table[(slot, key)] = length

    def skin_attachments(table):
        for _ in range(r.count()):
            slot = r.index(slots, "skin slot")
            for _ in range(r.count()):
                key = r.ref() or ""
                attachment(key, slot, table)

    stage = "header"
    try:
        r.skip(8)
        c["version"] = r.string()
        if not (c["version"] or "").startswith("4.2."):
            raise ValueError("version %r is not 4.2" % c["version"])
        r.skip(20)
        nonessential = r.byte() != 0
        if nonessential:
            c["nonessential"] = 1
            r.skip(4)
            r.string()
            r.string()
        r.strings = [r.string() or "" for _ in range(r.count())]
        stage = "bones"
        bones = r.count()
        c["bones"] = bones
        for i in range(bones):
            r.string()
            if i:
                r.index(i, "parent bone")
            r.skip(32)
            inherit = r.byte()
            if inherit:
                add("bone_inherit_%d" % inherit)
            if r.byte():
                add("bone_skin_required")
            if nonessential:
                r.skip(4)
                r.string()
                r.byte()
        stage = "slots"
        slots = r.count()
        c["slots"] = slots
        for _ in range(slots):
            r.string()
            r.index(bones, "slot bone")
            r.skip(4)
            if r.i32() != -1:
                add("slot_dark")
            r.ref()
            blend = r.varint()
            if blend:
                add("slot_blend_%d" % blend)
            if nonessential:
                r.byte()
        stage = "ik"
        iks = r.count()
        for _ in range(iks):
            add("ik")
            r.string()
            r.varint()
            n = constraint_bones()
            r.index(bones, "ik target")
            flags = r.byte()  # 64 mix follows, 128 softness follows
            r.skip(4 * bool(flags & 64) + 4 * bool(flags & 128))
            if not 1 <= n <= 2:
                raise ValueError("ik with %d bones" % n)
        stage = "transform"
        transforms = r.count()
        for _ in range(transforms):
            add("transform")
            r.string()
            r.varint()
            constraint_bones()
            r.index(bones, "transform target")
            f1 = r.byte()  # 2 local, 4 relative, 8..128 which of 5 offsets follow
            if f1 & 2:
                add("transform_local")
            if f1 & 4:
                add("transform_relative")
            r.skip(4 * bin(f1 & 0xF8).count("1"))
            f2 = r.byte()  # 1..64 which of shear offset and 6 mixes follow
            r.skip(4 * bin(f2 & 0x7F).count("1"))
        stage = "path"
        paths = r.count()
        for _ in range(paths):
            add("path_constraints")
            r.string()
            r.varint()
            if r.byte() & ~1:  # 1 skin required; other bits have not been seen
                return dict(c, ok=False, stage="path constraint flags (layout unknown)", at=r.p)
            constraint_bones()
            r.index(slots, "path target slot")
            modes = r.byte()  # 1 position mode, 6 spacing mode, 24 rotate mode
            if modes >> 5 or (modes >> 3) & 3 == 3:
                return dict(c, ok=False, stage="path constraint modes (layout unknown)", at=r.p)
            r.skip(20)  # position, spacing, rotate/x/y mixes
        stage = "physics"
        physics = r.count()
        for _ in range(physics):
            add("physics_constraints")
            r.string()
            r.varint()
            r.index(bones, "physics bone")
            flags = r.byte()  # 1 skin, 2..64 which of x, y, rotate, scale x, shear x, limit follow, 128 mass
            r.skip(4 * bin(flags & 0x7E).count("1"))
            r.skip(1 + 12 + 4 * bool(flags & 128) + 8)  # fps, inertia/strength/damping, mass, wind/gravity
            if r.byte() & 128:  # which values follow the global timelines; 128 mix follows
                r.skip(4)

        skin_names, skin_tables, links = ["default"], [{}], []
        stage = "default skin"
        skin_attachments(skin_tables[0])
        stage = "skins"
        n = r.count()
        c["skins"] = n + 1
        for _ in range(n):
            skin_names.append(r.string() or "")  # inline, not through the string table
            r.skip(4 * nonessential)
            for _ in range(r.count()):
                r.index(bones, "skin bone")
            for _ in range(4):  # ik, transform, path, physics constraints
                for _ in range(r.count()):
                    r.varint()
            skin_tables.append({})
            skin_attachments(skin_tables[-1])
        stage = "linked meshes"
        for table, at, skin, parent in links:
            # Resolved in file order, each taking its parent's vertices as they stand (as the loader does).
            source = skin_tables[0] if skin is None else next(
                (t for name, t in zip(skin_names, skin_tables) if name == skin), None)
            if source is None or (at[0], parent) not in source:
                raise ValueError("linked mesh %s: parent %s not found" % (at[1], parent))
            table[at] = source[(at[0], parent)]
        stage = "events"
        audio = []
        for _ in range(r.count()):
            add("events")
            r.string()
            r.varint()
            r.skip(4)
            r.string()
            path = r.string()
            if path is not None:
                r.skip(8)
            audio.append(bool(path))  # event keys carry volume and balance only for a non-empty audio path
        stage = "animations"
        n = r.count()
        c["animations"] = n
        for _ in range(n):
            stage = "animations"
            r.string()
            r.varint()
            stage = "animations: slot timelines"
            for _ in range(r.count()):
                r.index(slots, "slot")
                for _ in range(r.count()):
                    kind, frames = r.byte(), r.count()
                    if kind > 5:
                        raise ValueError("slot timeline type %d unknown" % kind)
                    add("slot_timeline_%d" % kind)
                    if kind == 0:
                        for _ in range(frames):
                            r.skip(4)
                            r.ref()
                        continue
                    r.varint()
                    curves(frames, SKEL_SLOT_CHANNELS[kind], SKEL_SLOT_BYTES[kind])
            stage = "animations: bone timelines"
            for _ in range(r.count()):
                r.index(bones, "bone")
                for _ in range(r.count()):
                    kind, frames = r.byte(), r.count()
                    if kind > 10:
                        raise ValueError("bone timeline type %d unknown" % kind)
                    add("bone_timeline_%d" % kind)
                    if kind == 10:
                        r.skip(5 * frames)
                        continue
                    r.varint()
                    ch = SKEL_BONE_CHANNELS[kind]
                    curves(frames, ch, 4 * ch)
            stage = "animations: ik timelines"
            for _ in range(r.count()):
                add("ik_timelines")
                r.index(iks, "ik")
                frames = r.count()
                r.varint()
                for f in range(frames):
                    # Flags first: 16 mix follows, 32 softness follows, then the curve to the next frame:
                    # 64 stepped, else 128 bezier (2 channels).
                    flags = r.byte()
                    r.skip(4 + 4 * bool(flags & 16) + 4 * bool(flags & 32))
                    if f + 1 < frames:
                        if flags & 64:
                            add("stepped_segments")
                        elif flags & 128:
                            r.skip(32)
                            add("bezier_segments")
            stage = "animations: transform timelines"
            for _ in range(r.count()):
                add("transform_timelines")
                r.index(transforms, "transform")
                frames = r.count()
                r.varint()
                curves(frames, 6, 24)
            stage = "animations: path timelines"
            for _ in range(r.count()):
                r.index(paths, "path")
                for _ in range(r.count()):
                    kind, frames = r.byte(), r.count()
                    if kind > 2:
                        raise ValueError("path timeline type %d unknown" % kind)
                    add("path_timelines")
                    r.varint()
                    ch = 3 if kind == 2 else 1  # position, spacing, mix (rotate, x, y)
                    curves(frames, ch, 4 * ch)
            stage = "animations: physics timelines"
            n = r.count()
            if n:
                c["physics_timelines"] = c.get("physics_timelines", 0) + n
                return dict(c, ok=False, stage="physics timelines (layout unknown)", at=r.p)
            stage = "animations: attachment timelines"
            for _ in range(r.count()):
                table = skin_tables[r.index(len(skin_tables), "skin")]
                for _ in range(r.count()):
                    slot = r.index(slots, "slot")
                    for _ in range(r.count()):
                        key = r.ref() or ""
                        kind, frames = r.byte(), r.count()
                        if (slot, key) not in table:
                            raise ValueError("timeline attachment %s not in its skin" % key)
                        if kind == 1:  # sequence: time, mode and start index, delay
                            add("sequence_timelines")
                            r.skip(12 * frames)
                            continue
                        if kind:
                            raise ValueError("attachment timeline %d (layout unknown)" % kind)
                        add("deform_timelines")
                        r.varint()
                        length = table[(slot, key)]
                        for f in range(frames):
                            # Time, then (after the first frame) the curve from the previous frame, then a
                            # count of floats and the offset of the first.
                            r.skip(4)
                            if f:
                                segment(1)
                            count = r.varint()
                            if count:
                                start = r.varint()
                                if start + count > length:
                                    raise ValueError("deform %d+%d past %d floats" % (start, count, length))
                                r.skip(4 * count)
            stage = "animations: draw order"
            n = r.count()
            if n:
                add("draw_order_timelines")
            for _ in range(n):
                r.skip(4)
                taken = set()
                for _ in range(r.count()):
                    s = r.index(slots, "draw order slot")
                    move = r.varint()
                    to = s + (move - (1 << 32) if move & 0x80000000 else move)
                    if not 0 <= to < slots or to in taken:
                        raise ValueError("bad draw order move")
                    taken.add(to)
            stage = "animations: event timelines"
            n = r.count()
            if n:
                add("event_timelines")
            for _ in range(n):
                r.skip(4)
                e = r.index(len(audio), "event")
                r.varint()
                r.skip(4)
                if r.byte():
                    r.string()
                if audio[e]:
                    r.skip(8)
        out = dict(c, ok=r.p == len(blob), stage="end", at=r.p, size=len(blob))
        if r.p != len(blob):
            out["error"] = "%d bytes left after the last animation" % (len(blob) - r.p)
        return out
    except (IndexError, ValueError, KeyError, struct.error) as error:
        return dict(c, ok=False, stage=stage, at=r.p, error="%s: %s" % (type(error).__name__, str(error)[:80]))


# --- FMOD banks: chunk layout and how the audio is encoded ---------------------------------------------------

def riff_chunks(blob, limit=400):
    """FourCC counts of a RIFF tree read from the bank's first bytes (no payloads)."""
    counts, order = {}, []
    if blob[:4] != b"RIFF":
        return counts, order

    def walk(start, end, depth):
        pos = start
        while pos + 8 <= end and len(order) < limit:
            cc = blob[pos:pos + 4]
            size = struct.unpack("<I", blob[pos + 4:pos + 8])[0]
            if not FOURCC.match(cc):
                return
            name = cc.decode()
            body = pos + 8
            if name in ("RIFF", "LIST") and body + 4 <= len(blob):
                name = name + ":" + blob[body:body + 4].decode("latin-1")
                if depth < 6:
                    walk(body + 4, min(body + size, len(blob)), depth + 1)
            counts[name] = counts.get(name, 0) + 1
            if len(order) < 60:
                order.append((name, size))
            pos = body + size + (size & 1)

    walk(0, len(blob), 0)
    return counts, order


FSB5_RATES = {1: 8000, 2: 11000, 3: 11025, 4: 16000, 5: 22050, 6: 24000, 7: 32000, 8: 44100, 9: 48000}
FSB5_CHANNELS = {0: 1, 1: 2, 2: 6, 3: 8}


def fsb5_header_size(version):
    return 0x3C if version >= 1 else 0x40


def fsb5_samples(table, count):
    """Per-sample facts from an FSB5 sample header table (public FSB5 notes): rate, channels, data offset,
    frame count, and for Vorbis the 32-bit id of the setup header the encoder used (FSB5 stores the id, not
    the header). Stops quietly at anything that does not parse."""
    out, pos = [], 0
    for _ in range(count):
        if pos + 8 > len(table):
            break
        mode = struct.unpack("<Q", table[pos:pos + 8])[0]
        pos += 8
        info = {"rate": FSB5_RATES.get((mode >> 1) & 0xF, 0), "channels": FSB5_CHANNELS[(mode >> 5) & 0x3],
                "offset": ((mode >> 7) & 0x7FFFFFF) * 32, "frames": mode >> 34}
        more = mode & 1
        while more:
            if pos + 4 > len(table):
                return out
            chunk = struct.unpack("<I", table[pos:pos + 4])[0]
            more, size, kind = chunk & 1, (chunk >> 1) & 0xFFFFFF, chunk >> 25
            body = table[pos + 4:pos + 4 + size]
            pos += 4 + size
            if kind == 1 and size >= 1:
                info["channels"] = body[0]
            elif kind == 2 and size >= 4:
                info["rate"] = struct.unpack("<I", body[:4])[0]
            elif kind == 11 and size >= 4:
                info["vorbis_setup"] = "%08x" % struct.unpack("<I", body[:4])[0]
        out.append(info)
    return out


def fsb5_headers(src, most=200):
    """Each FSB5 sound bank inside the file: version, sample count and codec (layout per the public FSB5
    notes used by vgmstream and others), and for Vorbis which setup ids it uses with which rate and channels."""
    found, carry, seen = [], b"", set()
    for start, block in src.chunks():
        data = carry + block
        base = start - len(carry)
        pos = data.find(b"FSB5")
        while pos >= 0:
            at = base + pos
            if at not in seen and pos + 28 <= len(data):
                seen.add(at)
                version, samples, sample_headers, names, data_size, mode = struct.unpack("<6I", data[pos + 4:pos + 28])
                entry = {"at": at, "version": version, "samples": samples, "codec": FSB_CODECS.get(mode, mode),
                         "data_size": data_size, "sample_headers": sample_headers, "name_table": names}
                if mode == 15 and 0 < sample_headers <= (8 << 20):
                    table = src.read(at + fsb5_header_size(version), sample_headers)
                    setups = {}
                    for s in fsb5_samples(table, samples):
                        key = "%s %d %d" % (s.get("vorbis_setup", "none"), s["rate"], s["channels"])
                        setups[key] = setups.get(key, 0) + 1
                    entry["vorbis_setups"] = setups
                found.append(entry)
            pos = data.find(b"FSB5", pos + 4)
        carry = data[-32:]
        if len(found) >= most:
            break
    return found


def strings_of(src, pattern, limit=MAX_LIST):
    out, carry = [], b""
    for _, block in src.chunks():
        data = carry + block
        for m in pattern.finditer(data):
            text = m.group(0).decode("latin-1")
            if text not in out:
                out.append(text)
                if len(out) >= limit:
                    return out
        carry = data[-256:]
    return out


def bank_info(src):
    info = {"name": src.name, "size": src.size}
    head = src.read(0, 1 << 20)
    counts, order = riff_chunks(head)
    info["riff_form"] = head[8:12].decode("latin-1") if head[:4] == b"RIFF" else None
    info["chunk_counts"] = counts
    info["chunk_order"] = order
    info["fsb5"] = fsb5_headers(src)
    if src.name.lower().endswith(".strings.bank") or src.size < (4 << 20):
        paths = strings_of(src, FMOD_PATH)
        if paths:
            info["paths"] = paths
    return info


# --- The game's managed code: names from the .NET metadata heaps (ECMA-335) --------------------------------

def dotnet_heaps(blob):
    """(#Strings, #US) heap bytes of a .NET PE file, or (None, None)."""
    if blob[:2] != b"MZ":
        return None, None
    pe = struct.unpack("<I", blob[0x3C:0x40])[0]
    if blob[pe:pe + 4] != b"PE\0\0":
        return None, None
    sections = struct.unpack("<H", blob[pe + 6:pe + 8])[0]
    opt_size = struct.unpack("<H", blob[pe + 20:pe + 22])[0]
    opt = pe + 24
    magic = struct.unpack("<H", blob[opt:opt + 2])[0]
    dirs = opt + (96 if magic == 0x10B else 112)
    cli_rva = struct.unpack("<I", blob[dirs + 14 * 8:dirs + 14 * 8 + 4])[0]
    table = opt + opt_size
    spans = []
    for i in range(sections):
        s = table + 40 * i
        vsize, rva, rsize, raw = struct.unpack("<IIII", blob[s + 8:s + 24])
        spans.append((rva, max(vsize, rsize), raw))

    def at(rva):
        for start, size, raw in spans:
            if start <= rva < start + size:
                return raw + rva - start
        return None

    cli = at(cli_rva) if cli_rva else None
    if cli is None:
        return None, None
    meta_rva = struct.unpack("<I", blob[cli + 8:cli + 12])[0]
    meta = at(meta_rva)
    if meta is None or blob[meta:meta + 4] != b"BSJB":
        return None, None
    vlen = struct.unpack("<I", blob[meta + 12:meta + 16])[0]
    pos = meta + 16 + vlen + 2
    streams = struct.unpack("<H", blob[pos:pos + 2])[0]
    pos += 2
    heaps = {}
    for _ in range(streams):
        offset, size = struct.unpack("<II", blob[pos:pos + 8])
        end = blob.index(b"\0", pos + 8)
        name = blob[pos + 8:end].decode("latin-1")
        pos = (end + 4) & ~3
        heaps[name] = blob[meta + offset:meta + offset + size]
    return heaps.get("#Strings"), heaps.get("#US")


def user_strings(heap):
    out, pos = [], 1
    while pos < len(heap):
        b = heap[pos]
        if b & 0x80 == 0:
            length, pos = b, pos + 1
        elif b & 0xC0 == 0x80:
            length, pos = ((b & 0x3F) << 8) | heap[pos + 1], pos + 2
        else:
            length, pos = ((b & 0x1F) << 24) | (heap[pos + 1] << 16) | (heap[pos + 2] << 8) | heap[pos + 3], pos + 4
        if length:
            out.append(heap[pos:pos + length - 1].decode("utf-16-le", "replace"))
        pos += length
    return out


def assembly_names(path):
    try:
        blob = Path(path).read_bytes()
    except OSError as error:
        return {"error": str(error)}
    strings, us = dotnet_heaps(blob)
    if strings is None:
        return {"error": "not a .NET assembly"}
    names = [s.decode("utf-8", "replace") for s in strings.split(b"\0") if s]
    picked = sorted({n for n in names if re.search(r"(?i)spine|fmod", n)})
    literals = user_strings(us or b"")
    fmod_paths = sorted({s for s in literals if FMOD_PATH.match(s.encode("latin-1", "replace"))})
    hinted = sorted({s for s in literals if SNAKE.match(s) and any(h in s for h in NAME_HINTS)})
    classes = sorted({s for s in literals if re.match(r"^(Spine|Fmod|FMOD)[A-Za-z0-9_]*$", s)})
    loader = sorted({n for n in names if LOADER_NAME.search(n) and len(n) <= 80})
    loader_literals = sorted({s for s in literals if len(s) <= 160 and LOADER_LITERAL.search(s)})
    return {"metadata_names": picked[:MAX_LIST], "class_literals": classes, "fmod_paths": fmod_paths[:MAX_LIST],
            "hinted_literals": hinted[:MAX_LIST], "literal_count": len(literals),
            "loader_names": loader[:LOADER_MAX], "loader_literals": loader_literals[:LOADER_MAX]}


# --- Putting it together --------------------------------------------------------------------------------------

# --- Text scenes and resources: how the game uses the Spine and FMOD classes ---------------------------------
# Godot's text format (.tscn/.tres) is documented in the Godot manual ("TSCN file format").

SCENE_EXT = (".tscn", ".tres")
SCENE_FILE_MAX = 1 << 20
WATCHED = re.compile(r"^(?:Spine|Fmod)[A-Za-z0-9_]*$")
SECTION = re.compile(r"^\[(\w+)((?:\s+\w+=(?:\"(?:[^\"\\]|\\.)*\"|[^\s\]]+))*)\s*\]\s*$")
ATTR = re.compile(r"(\w+)=(\"(?:[^\"\\]|\\.)*\"|[^\s\]]+)")
PROP = re.compile(r"^([A-Za-z_][A-Za-z0-9_/:.]*) = (.*)$")
REF = re.compile(r"^(Ext|Sub)Resource\(\s*\"([^\"]*)\"\s*\)")
EXAMPLES = 3
EXAMPLE_MAX = 48
SCENE_SAMPLE_CLASSES = (("SpineSprite",), ("SpineBoneNode", "SpineSlotNode"), ("FmodEventEmitter2D",))


def unquote(text):
    if len(text) >= 2 and text[0] == '"' and text[-1] == '"':
        return text[1:-1].replace('\\"', '"').replace("\\\\", "\\")
    return text


def depth_change(text):
    """How much a line opens ( [ { minus how much it closes, outside strings."""
    depth, quoted, escaped = 0, False, False
    for ch in text:
        if quoted:
            if escaped:
                escaped = False
            elif ch == "\\":
                escaped = True
            elif ch == '"':
                quoted = False
        elif ch == '"':
            quoted = True
        elif ch in "([{":
            depth += 1
        elif ch in ")]}":
            depth -= 1
    return depth


def value_kind(value, refs):
    v = value.strip()
    m = REF.match(v)
    if m:
        return "%sResource:%s" % (m.group(1), refs.get((m.group(1), m.group(2)), "?"))
    if v in ("true", "false"):
        return "bool"
    if v == "null":
        return "null"
    if v.startswith('"'):
        return "string"
    if v.startswith('&"'):
        return "StringName"
    if v.startswith("^\""):
        return "NodePath"
    if v.startswith("["):
        return "Array"
    if v.startswith("{"):
        return "Dictionary"
    if re.match(r"^-?(?:\d|\.\d|inf|nan)", v):
        return "float" if re.search(r"[.eE]|inf|nan", v) else "int"
    m = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)(?:\[[^\]]*\])?\(", v)
    return m.group(1) if m else "other"


def parse_text_resource(text):
    """[(section kind, attributes, [(property, value)])] from a .tscn or .tres."""
    sections, current, pending, depth = [], None, None, 0
    for line in text.splitlines():
        if pending is not None:
            pending[1].append(line)
            depth += depth_change(line)
            if depth <= 0:
                current[2].append((pending[0], "\n".join(pending[1])))
                pending, depth = None, 0
            continue
        m = SECTION.match(line)
        if m:
            current = (m.group(1), {k: unquote(v) for k, v in ATTR.findall(m.group(2))}, [])
            sections.append(current)
            continue
        m = PROP.match(line)
        if m and current is not None:
            d = depth_change(m.group(2))
            if d > 0:
                pending, depth = (m.group(1), [m.group(2)]), d
            else:
                current[2].append((m.group(1), m.group(2)))
    return sections


def res_name(path):
    return path[6:] if path.startswith("res://") else path


def node_path(attrs):
    parent = attrs.get("parent")
    name = attrs.get("name", "?")
    if parent is None:
        return "."
    return name if parent == "." else parent + "/" + name


def survey_text(name, text, survey):
    """Adds one file's classes, their properties and signal connections to [survey]; returns the
    watched class names it uses and the res paths of its watched external resources."""
    sections = parse_text_resource(text)
    refs, used, deps, nodes = {}, set(), [], {}
    for kind, attrs, _ in sections:
        if kind in ("ext_resource", "sub_resource") and "id" in attrs:
            refs[("Ext" if kind == "ext_resource" else "Sub", attrs["id"])] = attrs.get("type", "?")
    root = sections[0][1].get("type") if sections and sections[0][0] == "gd_resource" else None
    for kind, attrs, props in sections:
        cls = root if kind == "resource" else attrs.get("type")
        if kind == "node":
            nodes[node_path(attrs)] = cls or ("instance" if "instance" in attrs else "?")
            if cls:
                survey["node_types"][cls] = survey["node_types"].get(cls, 0) + 1
        elif kind in ("sub_resource", "ext_resource", "gd_resource") and cls:
            survey["resource_types"][cls] = survey["resource_types"].get(cls, 0) + 1
        if kind == "ext_resource" and cls and WATCHED.match(cls):
            deps.append(res_name(attrs.get("path", "")))
        if kind == "gd_resource" or not cls or not WATCHED.match(cls):
            continue
        used.add(cls)
        entry = survey["classes"].setdefault(cls, {"count": 0, "files": 0, "as": {}, "props": {}})
        entry["count"] += 1
        entry["as"][kind] = entry["as"].get(kind, 0) + 1
        if kind == "ext_resource":
            e = ext_of(attrs.get("path", ""))
            entry.setdefault("paths", {})[e] = entry.get("paths", {}).get(e, 0) + 1
        for prop, value in props:
            p = entry["props"].setdefault(prop, {"n": 0, "kinds": {}, "eg": []})
            p["n"] += 1
            k = value_kind(value, refs)
            p["kinds"][k] = p["kinds"].get(k, 0) + 1
            short = value.strip()
            if k in ("string", "StringName", "int", "float", "bool", "NodePath", "Vector2", "Color") \
                    and len(short) <= EXAMPLE_MAX and short not in p["eg"] and len(p["eg"]) < EXAMPLES:
                p["eg"].append(short)
    for cls in used:
        survey["classes"][cls]["files"] += 1
    for kind, attrs, _ in sections:
        if kind != "connection":
            continue
        source = nodes.get(attrs.get("from", ""), "?")
        signal = attrs.get("signal", "?")
        if WATCHED.match(source or "") or re.match(r"^(?:animation|before_animation)_", signal):
            key = "%s.%s" % (source, signal)
            survey["signals"][key] = survey["signals"].get(key, 0) + 1
    return used, deps


def imported_path(sources_by_name, path):
    """The imported file a res path stands for, from its .import notes (path="res://.godot/imported/...")."""
    note = sources_by_name.get(path + ".import")
    if note is None or note.size > 65536:
        return None
    m = re.search(r'^path="([^"]+)"', note.read().decode("utf-8", "replace"), re.M)
    return res_name(m.group(1)) if m else None


def closure(start, sources_by_name, deps_of):
    """The scene or resource [start] with the Spine and FMOD resources it reaches: the text resources
    themselves and the imported skeleton and atlas files, never textures."""
    files, todo = [], [start]
    while todo and len(files) < 12:
        name = todo.pop(0)
        if name in files:
            continue
        if name in sources_by_name:
            files.append(name)
            todo += deps_of.get(name, [])
            continue
        target = imported_path(sources_by_name, name)
        if target and target in sources_by_name and target not in files:
            files.append(target)
    return files


def scene_survey(sources):
    survey = {"files": 0, "unreadable": 0, "classes": {}, "signals": {}, "node_types": {}, "resource_types": {}}
    by_name = {s.name: s for s in sources if not s.encrypted}
    uses, deps_of = {}, {}
    for src in sources:
        if src.encrypted or ext_of(src.name) not in SCENE_EXT or src.size > SCENE_FILE_MAX:
            continue
        data = src.read()
        if data[:1] != b"[":
            survey["unreadable"] += 1
            continue
        survey["files"] += 1
        used, deps = survey_text(src.name, data.decode("utf-8", "replace"), survey)
        if used:
            uses[src.name] = used
        if deps:
            deps_of[src.name] = deps
    survey["node_types"] = dict(sorted(survey["node_types"].items(), key=lambda kv: -kv[1])[:150])
    survey["resource_types"] = dict(sorted(survey["resource_types"].items(), key=lambda kv: -kv[1])[:150])
    samples = {}
    for wanted in SCENE_SAMPLE_CLASSES:
        best = None
        for name, used in uses.items():
            if not name.endswith(".tscn") or not all(c in used for c in wanted[:1]):
                continue
            files = closure(name, by_name, deps_of)
            size = sum(by_name[f].size for f in files)
            score = (-sum(c in used for c in wanted), size)
            if best is None or score < best[0]:
                best = (score, files, size)
        if best:
            samples["+".join(wanted)] = {"files": best[1], "bytes": best[2]}
    survey["samples"] = samples
    return survey


# --- Compiled GDScript (.gdc): identifier and string tables, to learn which audio and animation calls the
# game's scripts make. Layout from Godot's own MIT sources (modules/gdscript/gdscript_tokenizer_buffer.cpp).

GDC_MAX = 1 << 20
GDC_IDENTIFIERS = 800
GDC_STRINGS = 300
GDC_STRING_MAX = 160


def zstd_decompress(blob, size):
    try:
        import compression.zstd as z  # Python 3.14+
        return z.decompress(blob)
    except ImportError:
        pass
    try:
        import zstandard  # noqa: F401
        return zstandard.ZstdDecompressor().decompress(blob, max_output_size=size)
    except ImportError:
        pass
    import subprocess
    out = subprocess.run(["zstd", "-dcq"], input=blob, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=30)
    if out.returncode != 0:
        raise ValueError("zstd failed")
    return out.stdout


def gdc_variant(buf, at):
    """(value or None, next offset) for one encoded Variant; None as the offset when the type is not handled."""
    header = struct.unpack_from("<I", buf, at)[0]
    kind, wide = header & 0xFF, bool(header & (1 << 16))
    at += 4
    if kind == 0:
        return None, at
    if kind == 1:
        return bool(struct.unpack_from("<I", buf, at)[0]), at + 4
    if kind in (2, 3):
        return None, at + (8 if wide else 4)
    if kind in (4, 21, 22):  # String, StringName, NodePath (new format starts with a flagged length)
        n = struct.unpack_from("<I", buf, at)[0]
        if kind == 22 and n & 0x80000000:
            return None, None
        text = buf[at + 4:at + 4 + n].decode("utf-8", "replace")
        return text, at + 4 + n + (-n % 4)
    # Fixed-size types: Vector2, Vector2i, Rect2, Rect2i, Vector3, Vector3i, Transform2D, Vector4, Vector4i,
    # Plane, Quaternion, Color. Real-valued ones double in a 64-bit build.
    sizes = {5: 8, 6: 8, 7: 16, 8: 16, 9: 12, 10: 12, 11: 24, 12: 16, 13: 16, 14: 16, 15: 16, 20: 16}
    if kind in sizes:
        return None, at + sizes[kind] * (2 if wide and kind in (5, 7, 9, 11, 12, 14, 15) else 1)
    return None, None


def gdc_tables(raw):
    """{"identifiers": [...], "strings": [...]} from a compiled script, or {"error"}."""
    if raw[:4] != b"GDSC" or len(raw) < 12:
        return {"error": "not GDSC"}
    version, size = struct.unpack_from("<II", raw, 4)
    body = raw[12:] if size == 0 else zstd_decompress(raw[12:], size)
    ids, consts = struct.unpack_from("<II", body, 0)
    at, identifiers = 16, []
    for _ in range(ids):
        n = struct.unpack_from("<I", body, at)[0]
        at += 4
        chars = bytes(b ^ 0xB6 for b in body[at:at + n * 4])
        identifiers.append(chars.decode("utf-32-le", "replace"))
        at += n * 4
    strings = []
    for _ in range(consts):
        value, at = gdc_variant(body, at)
        if at is None:
            break
        if isinstance(value, str) and value and value not in strings:
            strings.append(value[:GDC_STRING_MAX])
    return {"version": version, "identifiers": identifiers[:GDC_IDENTIFIERS], "identifier_count": ids,
            "strings": strings[:GDC_STRINGS], "constant_count": consts}


def gdc_survey(sources):
    out = []
    for src in sources:
        if src.encrypted or ext_of(src.name) != ".gdc" or src.size > GDC_MAX:
            continue
        try:
            entry = gdc_tables(src.read())
        except Exception as error:  # one odd script must not stop the rest
            entry = {"error": "%s: %s" % (type(error).__name__, error)}
        entry["name"] = src.name
        entry["size"] = src.size
        out.append(entry)
    return out


def find_pack(game_dir):
    packs = sorted(Path(game_dir).glob("*.pck"), key=lambda p: -p.stat().st_size)
    if packs:
        return packs[0]
    exes = sorted(Path(game_dir).glob("*.exe"), key=lambda p: -p.stat().st_size)
    return exes[0] if exes else None


def inventory(game_dir):
    game_dir = Path(game_dir)
    report = {"schema": SCHEMA, "game_dir_name": game_dir.name, "made": int(time.time())}
    sources = []
    pack = find_pack(game_dir)
    if pack is not None:
        parsed = read_pack(pack)
        report["pack"] = {k: v for k, v in parsed.items() if k != "files"}
        report["pack"]["name"] = pack.name
        report["pack"]["size"] = pack.stat().st_size
        for name, offset, size, flags in parsed.get("files", []):
            sources.append(Source(name, pack, offset, size, bool(flags & 1)))
    for path in game_dir.rglob("*"):
        if path.is_file() and path != pack:
            sources.append(Source("disk:" + str(path.relative_to(game_dir)), path, 0, path.stat().st_size))
    exts = {}
    for src in sources:
        e = ext_of(src.name)
        n, total = exts.get(e, (0, 0))
        exts[e] = (n + 1, total + src.size)
    report["extensions"] = {e: {"files": n, "bytes": b} for e, (n, b) in sorted(exts.items(), key=lambda kv: -kv[1][1])}
    report["encrypted_files"] = sum(1 for s in sources if s.encrypted)
    report["big_files"] = [{"name": s.name, "size": s.size} for s in sorted(sources, key=lambda s: -s.size)[:BIG_FILES]]
    report["fonts"] = [{"name": s.name, "size": s.size} for s in sources if ext_of(s.name) in FONT_EXT]

    gdext = []
    for src in sources:
        if src.name.lower().endswith(".gdextension") and not src.encrypted:
            gdext.append({"name": src.name, "text": src.read(0, MAX_GDEXT_BYTES).decode("utf-8", "replace")})
    report["gdextensions"] = gdext
    report["native_libraries"] = sorted(s.name for s in sources
                                        if s.name.startswith("disk:") and ext_of(s.name) in (".dll", ".so", ".dylib"))[:400]

    importers = {}
    font_imports = []
    for src in sources:
        if src.name.endswith(".import") and not src.encrypted and src.size < 65536:
            text = src.read().decode("utf-8", "replace")
            m = re.search(r'importer="([^"]+)"', text)
            t = re.search(r'type="([^"]+)"', text)
            key = "%s -> %s" % (m.group(1) if m else "?", t.group(1) if t else "?")
            importers[key] = importers.get(key, 0) + 1
            if m and m.group(1).startswith("font_data"):
                path = re.search(r'^path="([^"]+)"', text, re.M)
                font_imports.append({"import": src.name, "path": path.group(1) if path else None})
    report["importers"] = importers
    report["font_imports"] = font_imports

    skeleton_ext = (".skel", ".skel.bytes", ".spskel", ".spine-json", ".spjson")
    skeletons = []
    for src in sources:
        e = ext_of(src.name)
        if src.encrypted:
            continue
        if e in skeleton_ext or (e == ".json" and b"\"skeleton\"" in src.read(0, 512)):
            skeletons.append(skeleton_info(src))
    report["skeletons"] = skeletons[:MAX_LIST]
    report["skeleton_count"] = len(skeletons)
    report["atlas_count"] = sum(1 for s in sources if ext_of(s.name) in (".atlas", ".atlas.txt", ".spatlas"))

    banks = [bank_info(s) for s in sources if ext_of(s.name) in (".bank", ".strings.bank") and not s.encrypted]
    report["banks"] = banks

    resource_hits = {}
    pattern = re.compile(rb"(?:Spine|Fmod)[A-Z][A-Za-z0-9]{2,40}")
    for src in sources:
        if ext_of(src.name) in (".scn", ".tscn", ".res", ".tres", ".remap") and not src.encrypted and src.size < (8 << 20):
            for m in set(pattern.findall(src.read())):
                name = m.decode()
                resource_hits[name] = resource_hits.get(name, 0) + 1
    report["resource_class_hits"] = dict(sorted(resource_hits.items(), key=lambda kv: -kv[1]))
    report["scene_survey"] = scene_survey(sources)
    report["scripts"] = gdc_survey(sources)

    managed = {}
    for src in sources:
        if src.name.startswith("disk:") and src.name.lower().endswith(".dll") and src.size < (64 << 20):
            base = src.name.rsplit("/", 1)[-1].lower()
            if base.startswith(("system.", "microsoft.", "mscorlib", "netstandard", "windowsbase", "api-ms-")):
                continue
            names = assembly_names(src.path)
            if "error" in names:
                continue
            if base == "sts2.dll" or any(names[k] for k in ("metadata_names", "class_literals", "fmod_paths")):
                managed[src.name] = names
            else:
                managed[src.name] = {"literal_count": names["literal_count"]}
    report["managed"] = managed
    return report


SKELETON_EXT = (".skel", ".skel.bytes", ".spskel", ".spine-json", ".spjson")
ATLAS_EXT = (".atlas", ".atlas.txt", ".spatlas")


def game_sources(game_dir):
    game_dir = Path(game_dir)
    sources = []
    pack = find_pack(game_dir)
    if pack is not None:
        for name, offset, size, flags in read_pack(pack).get("files", []):
            sources.append(Source(name, pack, offset, size, bool(flags & 1)))
    for path in game_dir.rglob("*"):
        if path.is_file() and path != pack:
            sources.append(Source("disk:" + str(path.relative_to(game_dir)), path, 0, path.stat().st_size))
    return sources


IMPORTED = re.compile(r"\.(?:skel|skel\.bytes|atlas|atlas\.txt|json)-[0-9a-f]{32}$")


def stem_key(name):
    base = name.rsplit("/", 1)[-1].lower()
    for e in (".spskel", ".spatlas"):
        if base.endswith(e) and IMPORTED.search(base[:-len(e)]):
            # Godot's imported copy, e.g. .godot/imported/axe_bot.skel-<md5>.spskel pairs with axe_bot.atlas-<md5>.spatlas
            return name.rsplit("/", 1)[0].lower() if "/" in name else "", IMPORTED.sub("", base[:-len(e)])
    for e in SKELETON_EXT + ATLAS_EXT + (".json",):
        if base.endswith(e):
            return name.rsplit("/", 1)[0].lower() if "/" in name else "", base[:-len(e)]
    return None


def unread_skeletons(report):
    """Skeleton names grouped by why the survey could not read them (path or physics constraints, an
    unknown attachment or timeline kind, or a read error at a given stage), so the smallest of each can
    be sampled."""
    groups = {}
    for sk in (report or {}).get("skeletons", []):
        sv = sk.get("survey") or {}
        if sv.get("ok") or not sv.get("stage"):
            continue
        text = "%s %s" % (sv.get("stage", ""), sv.get("error", ""))
        m = re.search(r"(path|physics) (constraints|timelines)|attachment (type|timeline) \d+", text)
        if m:
            key = m.group(0)
        else:
            kind = (sv.get("error") or "").split(":", 1)[0].strip() or "stopped"
            key = "%s: %s" % (sv.get("stage"), kind)
        groups.setdefault(key, []).append(sk.get("name"))
    return groups


def pick_samples(sources, budget=SAMPLE_BUDGET, report=None):
    """The strings bank, the metadata of the smallest bank with audio and of the bank with the most sounds
    (everything before their audio data), the smallest skeleton for each layout the survey could not read,
    the smallest scenes that use the Spine and FMOD nodes with the resources they reach, then a few skeletons of each format (small, middle and large) with their atlases and import notes, all
    within [budget]."""
    usable = [s for s in sources if not s.encrypted and 0 < s.size <= SAMPLE_FILE_MAX]
    skel = {}
    for src in usable:
        e = ext_of(src.name)
        if e in SKELETON_EXT:
            fmt = "json" if e in (".spine-json", ".spjson") else "binary"
        elif e == ".json" and b"\"skeleton\"" in src.read(0, 512):
            fmt = "json"
        else:
            continue
        skel.setdefault(fmt, []).append(src)
    chosen = []
    for fmt in ("binary", "json"):
        group = sorted(skel.get(fmt, []), key=lambda s: s.size)
        if group:
            picks = {0, len(group) // 2, len(group) - 1}
            chosen += [group[i] for i in sorted(picks)]
    by_stem = {}
    for src in usable:
        key = stem_key(src.name)
        if key and ext_of(src.name) in ATLAS_EXT:
            by_stem.setdefault(key, []).append(src)
    imports = {s.name[:-len(".import")]: s for s in usable if s.name.endswith(".import")}
    extra = []
    for src in chosen:
        extra += by_stem.get(stem_key(src.name), [])
        if src.name in imports:
            extra.append(imports[src.name])
    banks = [s for s in usable if ext_of(s.name) in (".bank", ".strings.bank")]
    strings = sorted((b for b in banks if b.name.lower().endswith(".strings.bank")), key=lambda s: s.size)[:1]
    heads = []
    for b in sorted((s for s in sources if not s.encrypted and ext_of(s.name) == ".bank"), key=lambda s: s.size):
        if b in strings:
            continue
        cut = meta_head(b)
        if cut is not None:
            heads.append(cut)
    if len(heads) > 1:
        heads = [heads[0], max(heads[1:], key=lambda h: h.sounds)]
    by_name = {s.name: s for s in usable}
    unread = []
    for _, names in sorted(unread_skeletons(report).items()):
        group = sorted((by_name[n] for n in names if n in by_name), key=lambda s: s.size)
        if group:
            unread.append(group[0])
            unread += by_stem.get(stem_key(group[0].name), [])
    scenes = []
    for group in ((report or {}).get("scene_survey") or {}).get("samples", {}).values():
        scenes += [by_name[n] for n in group.get("files", []) if n in by_name]
    picked, total, seen = [], 0, set()
    for src in strings + heads[:1] + unread + scenes + heads[1:] + chosen + extra:
        if src.name in seen or total + src.size > budget:
            continue
        seen.add(src.name)
        picked.append(src)
        total += src.size
    return picked


class Head:
    """A bank up to the start of its audio data: the event and mixer metadata, the FSB5 header, the
    sample headers and the sample names, without the sounds themselves."""

    def __init__(self, src, length, sounds):
        self.src, self.size, self.encrypted, self.sounds = src, length, False, sounds
        self.name = src.name + ".meta-head"

    def read(self, start=0, length=None):
        length = self.size - start if length is None else min(length, self.size - start)
        return self.src.read(start, length)


def meta_head(bank, limit=HEAD_MAX):
    for f in fsb5_headers(bank, most=1)[:1]:
        length = f["at"] + fsb5_header_size(f["version"]) + f["sample_headers"] + f["name_table"]
        return Head(bank, length, f["samples"]) if length <= limit else None
    return Head(bank, bank.size, 0) if bank.size <= limit else None


def write_samples(picked, out):
    """A zip of the picked files under their own names, with a manifest; written atomically."""
    out.parent.mkdir(parents=True, exist_ok=True)
    tmp = out.with_suffix(".tmp")
    manifest = []
    with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED) as z:
        for i, src in enumerate(picked):
            data = src.read()
            arc = "%02d_%s" % (i, re.sub(r"[^A-Za-z0-9._-]+", "_", src.name.replace("disk:", "disk_"))[-120:])
            z.writestr(arc, data)
            manifest.append({"file": arc, "name": src.name, "size": len(data), "sha256": hashlib.sha256(data).hexdigest()})
        z.writestr("manifest.json", json.dumps({"schema": SCHEMA, "files": manifest}, indent=1))
    tmp.replace(out)
    return manifest


def summary(report):
    versions = {}
    for s in report.get("skeletons", []):
        key = "%s %s" % (s.get("format"), s.get("version"))
        versions[key] = versions.get(key, 0) + 1
    codecs = {}
    for b in report.get("banks", []):
        for f in b.get("fsb5", []):
            codecs[str(f["codec"])] = codecs.get(str(f["codec"]), 0) + f["samples"]
    events = set()
    for b in report.get("banks", []):
        events.update(p for p in b.get("paths", []) if p.startswith("event:/"))
    setups = {}
    for b in report.get("banks", []):
        for f in b.get("fsb5", []):
            for key, n in f.get("vorbis_setups", {}).items():
                setups[key] = setups.get(key, 0) + n
    survey = {"ok": 0, "failed": 0, "fail_stages": {}, "skeletons_with": {}}
    for sk in report.get("skeletons", []):
        sv = sk.get("survey")
        if not sv:
            continue
        if sv.get("ok"):
            survey["ok"] += 1
        else:
            survey["failed"] += 1
            stage = sv.get("stage", "?") + (" " + sv["error"] if sv.get("error") else "")
            survey["fail_stages"][stage[:80]] = survey["fail_stages"].get(stage[:80], 0) + 1
        for key, value in sv.items():
            if isinstance(value, int) and not isinstance(value, bool) and value and key not in (
                    "at", "size", "bones", "slots", "animations", "skins", "bezier_segments", "stepped_segments"):
                survey["skeletons_with"][key] = survey["skeletons_with"].get(key, 0) + 1
    called = set()
    for m in report.get("managed", {}).values():
        called.update(p for p in m.get("fmod_paths", []) if p.startswith("event:/"))
    return {"schema": SCHEMA, "pack": report.get("pack"), "skeletons": report.get("skeleton_count"),
            "skeleton_versions": versions, "atlases": report.get("atlas_count"), "banks": len(report.get("banks", [])),
            "audio_samples_by_codec": codecs,
            "vorbis_setups": dict(sorted(setups.items(), key=lambda kv: -kv[1])[:40]), "bank_events": len(events), "code_events": len(called),
            "skel_survey": survey,
            "gdextensions": [g["name"] for g in report.get("gdextensions", [])],
            "spine_classes_in_scenes": [k for k in report.get("resource_class_hits", {}) if k.startswith("Spine")][:40],
            "fmod_classes_in_scenes": [k for k in report.get("resource_class_hits", {}) if k.startswith("Fmod")][:40],
            "scene_files": (report.get("scene_survey") or {}).get("files"),
            "scripts": len(report.get("scripts") or []),
            "script_errors": sum(1 for g in report.get("scripts") or [] if "error" in g),
            "scene_samples": {k: v.get("bytes") for k, v in ((report.get("scene_survey") or {}).get("samples") or {}).items()},
            "encrypted_files": report.get("encrypted_files")}


def report_lines(report):
    """The report as JSON lines, one short record each, because telemetry withholds any over-long line.
    {"k": key, "v": value} for a plain entry; {"k": key, "i": n, "v": item} for each item of a list, with
    "n" for a mapping's key. When an item is still too long, each of its list fields goes out in parts as
    {"k", "i", "f": field, "p": part, "v": [...]} and the item's remaining fields as one record."""
    def dumps(rec):
        return json.dumps(rec, separators=(",", ":"), sort_keys=True)

    def records(base, item):
        text = dumps(dict(base, v=item))
        if len(text) <= REPORT_LINE_MAX:
            yield text
            return
        if isinstance(item, dict):
            rest = {}
            for field, value in item.items():
                if isinstance(value, (list, dict)) and len(dumps(value)) > REPORT_LINE_MAX // 4:
                    values = list(value.items()) if isinstance(value, dict) else value
                    part, chunk = 0, []
                    for v in values:
                        chunk.append(v)
                        if len(dumps(chunk)) > REPORT_LINE_MAX // 2:
                            yield dumps(dict(base, f=field, p=part, d=isinstance(value, dict), v=chunk))
                            part, chunk = part + 1, []
                    if chunk:
                        yield dumps(dict(base, f=field, p=part, d=isinstance(value, dict), v=chunk))
                else:
                    rest[field] = value
            text = dumps(dict(base, v=rest))
            if len(text) <= REPORT_LINE_MAX:
                yield text
                return
        yield dumps(dict(base, v=dumps(item)[:REPORT_LINE_MAX - 200], cut=True))

    yield dumps({"k": "format", "v": "lines-1"})
    for key, value in report.items():
        if isinstance(value, list):
            for i, item in enumerate(value):
                yield from records({"k": key, "i": i}, item)
        elif isinstance(value, dict) and len(dumps(value)) > REPORT_LINE_MAX:
            for i, (name, item) in enumerate(value.items()):
                yield from records({"k": key, "i": i, "n": name}, item)
        else:
            yield from records({"k": key}, value)


def read_report(text):
    """The report back from report_lines (for tests and for reading telemetry)."""
    report, parts = {}, {}
    for raw in text.splitlines():
        if not raw.strip():
            continue
        rec = json.loads(raw)
        key = rec["k"]
        if key == "format":
            continue
        if "i" not in rec:
            report[key] = rec["v"]
            continue
        slot = parts.setdefault(key, {}).setdefault(rec["i"], {"n": rec.get("n"), "v": None, "f": {}})
        if "f" in rec:
            slot["f"].setdefault(rec["f"], (rec.get("d"), []))[1].extend(rec["v"])
        else:
            slot["v"] = rec["v"]
    for key, items in parts.items():
        built = []
        for i in sorted(items):
            slot = items[i]
            value = slot["v"] if slot["v"] is not None else {}
            for field, (is_dict, chunks) in slot["f"].items():
                value[field] = dict(chunks) if is_dict else chunks
            built.append((slot["n"], value))
        report[key] = {n: v for n, v in built} if built and built[0][0] is not None else [v for _, v in built]
    return report


def emit(report, out=REPORT):
    say(PREFIX + "_SUMMARY " + json.dumps(summary(report), separators=(",", ":"), sort_keys=True)[:4000])
    try:
        out.parent.mkdir(parents=True, exist_ok=True)
        tmp = out.with_suffix(".tmp")
        tmp.write_text("".join(line + "\n" for line in report_lines(report)))
        tmp.replace(out)
    except OSError as error:
        say(PREFIX + "_SUMMARY " + json.dumps({"schema": SCHEMA, "error": "report not written (%s)" % error}))


def stamp(game_dir):
    h = hashlib.sha256()
    for path in sorted(Path(game_dir).glob("*")):
        try:
            st = path.stat()
        except OSError:
            continue
        h.update(("%s %d %d\n" % (path.name, st.st_size, int(st.st_mtime))).encode())
    return h.hexdigest()[:16]


def main(argv=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("--game-dir", required=True)
    parser.add_argument("--no-cache", action="store_true")
    parser.add_argument("--json", help="write the full report here instead (for tests)")
    parser.add_argument("--samples", help="write the sample zip here instead (for tests)")
    args = parser.parse_args(argv)
    if not os.path.isdir(args.game_dir):
        say(PREFIX + "_SUMMARY " + json.dumps({"schema": SCHEMA, "error": "game folder missing"}))
        return 1
    cache = CACHE_DIR / ("native-inventory-v%d-%s.json" % (SCHEMA, stamp(args.game_dir)))
    report = None
    if not args.no_cache:
        try:
            report = json.loads(cache.read_text())
        except (OSError, ValueError):
            report = None
    if report is None:
        started = time.monotonic()
        try:
            report = inventory(args.game_dir)
        except Exception as error:  # a partial answer is still worth sending; never disturb the game
            report = {"schema": SCHEMA, "error": "%s: %s" % (type(error).__name__, error)}
        report["seconds"] = round(time.monotonic() - started, 1)
        if not args.no_cache:
            try:
                CACHE_DIR.mkdir(parents=True, exist_ok=True)
                cache.write_text(json.dumps(report))
            except OSError:
                pass
    emit(report, Path(args.json) if args.json else REPORT)
    samples_out = Path(args.samples) if args.samples else SAMPLES
    kept = CACHE_DIR / ("native-samples-v%d.%d-%s.json" % (SCHEMA, SAMPLES_VERSION, stamp(args.game_dir)))
    try:
        if not args.no_cache and kept.is_file():
            # Sent once per game build: the telemetry bundle takes the zip only in the session that wrote it.
            say(PREFIX + "_SAMPLES " + json.dumps({"already_sent": kept.name}))
        else:
            manifest = write_samples(pick_samples(game_sources(args.game_dir), report=report), samples_out)
            say(PREFIX + "_SAMPLES " + json.dumps({"files": [m["name"] for m in manifest],
                                                     "bytes": sum(m["size"] for m in manifest)})[:4000])
            if not args.no_cache:
                kept.write_text(json.dumps(manifest))
    except Exception as error:  # never disturb the game
        say(PREFIX + "_SAMPLES " + json.dumps({"error": "%s: %s" % (type(error).__name__, error)}))
    return 0


if __name__ == "__main__":
    sys.exit(main())

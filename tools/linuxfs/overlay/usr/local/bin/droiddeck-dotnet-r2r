#!/usr/bin/env python3
"""Precompiles a .NET game's IL-only assemblies to x64 ReadyToRun code, so the runtime JITs less each run and
the code it runs comes from a file that is the same every run.

A ReadyToRun image keeps the assembly's IL and metadata (same MVID), so the runtime falls back to the JIT
for anything the precompiled code does not cover or that it rejects. The compiler is crossgen2 (MIT, from
the Microsoft.NETCore.App.Crossgen2.linux-arm64 package), which runs natively here and targets Windows x64.

  status  GAME_DIR [--log FILE]   what is managed, already ReadyToRun, IL-only, swapped in
  compile GAME_DIR                compile what is missing into the cache (slow; run in the background)
  apply   GAME_DIR --on|--off     swap cached images in, or put every original back

--bubble (compile, apply) compiles the game's own assemblies together, in one version bubble with every
other managed file in the folder (the framework copy a self-contained game ships). Code for the framework's
generics over the game's types (System.Text.Json metadata, async builders, LINQ) can then be precompiled
too; per assembly, crossgen2 has to leave those to the JIT. The framework files themselves are not changed.

GAME_DIR is the folder that holds coreclr.dll. Originals are kept in the cache and every swap is undone by
--off, which only touches files whose content is exactly an image this tool wrote."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import struct
import subprocess
import sys
import time

CROSSGEN = os.environ.get("DROIDDECK_CROSSGEN2", "/usr/local/lib/droiddeck-crossgen2/crossgen2")
CROSSGEN_MAJOR = int(os.environ.get("DROIDDECK_CROSSGEN2_MAJOR", "9"))
CACHE = Path(os.environ.get("DROIDDECK_R2R_CACHE", os.path.expanduser("~/.cache/droiddeck-r2r")))
RTR_SIGNATURE = 0x00525452
COMIMAGE_FLAGS_ILONLY = 0x1
COMPILE_TIMEOUT_S = 1200
# Threads per compile: the game may be running beside it.
PARALLELISM = os.environ.get("DROIDDECK_CROSSGEN2_THREADS", "2")
# Used for the framework when no deps.json lists the runtime pack's files.
FRAMEWORK_PREFIXES = ("System.", "Microsoft.CSharp.", "Microsoft.VisualBasic.", "Microsoft.Win32.")
FRAMEWORK_NAMES = {"System.dll", "mscorlib.dll", "netstandard.dll", "WindowsBase.dll"}


def pe_info(path):
    """None for a file that is not a managed PE image, else {"r2r": bool, "ilonly": bool}."""
    try:
        with open(path, "rb") as f:
            head = f.read(4096)
            if head[:2] != b"MZ":
                return None
            pe = struct.unpack_from("<I", head, 0x3C)[0]
            f.seek(pe)
            header = f.read(24 + 240)
            if header[:4] != b"PE\0\0":
                return None
            sections, optional_size = struct.unpack_from("<H", header, 6)[0], struct.unpack_from("<H", header, 20)[0]
            optional = header[24:24 + optional_size]
            magic = struct.unpack_from("<H", optional, 0)[0]
            directories = {0x10B: 96, 0x20B: 112}.get(magic)
            if directories is None or len(optional) < directories + 15 * 8:
                return None
            clr_rva, clr_size = struct.unpack_from("<II", optional, directories + 14 * 8)
            if not clr_rva:
                return None
            f.seek(pe + 24 + optional_size)
            table = f.read(40 * sections)

            def offset(rva):
                for i in range(sections):
                    size, address, raw_size, raw = struct.unpack_from("<IIII", table, i * 40 + 8)
                    if address <= rva < address + max(size, raw_size):
                        return raw + rva - address
                return None

            f.seek(offset(clr_rva))
            cor = f.read(72)
            flags = struct.unpack_from("<I", cor, 16)[0]
            native_rva = struct.unpack_from("<I", cor, 64)[0]
            r2r = False
            if native_rva and offset(native_rva) is not None:
                f.seek(offset(native_rva))
                r2r = struct.unpack("<I", f.read(4))[0] == RTR_SIGNATURE
            return {"r2r": r2r, "ilonly": bool(flags & COMIMAGE_FLAGS_ILONLY)}
    except (OSError, struct.error, TypeError):
        return None


def runtime_pack(game_dir):
    """(major version, set of framework assembly names) of the .NET runtime the game ships, from its
    deps.json files, else its runtimeconfig.json. The framework already ships with precompiled code and is
    left as it is."""
    major, framework = None, set()
    for deps in sorted(Path(game_dir).glob("*.deps.json")):
        try:
            data = json.loads(deps.read_text(errors="replace"))
        except (OSError, ValueError):
            continue
        for target in data.get("targets", {}).values():
            for key, entry in target.items():
                if key.startswith("runtimepack.Microsoft.NETCore.App.Runtime"):
                    framework.update(Path(name).name for name in entry.get("runtime", {}))
                    match = re.match(r"(\d+)\.", key.split("/")[-1])
                    major = int(match.group(1)) if match else major
    if major is None:
        for config in sorted(Path(game_dir).glob("*.runtimeconfig.json")):
            try:
                options = json.loads(config.read_text(errors="replace")).get("runtimeOptions", {})
            except (OSError, ValueError, AttributeError):
                continue
            listed = options.get("includedFrameworks") or options.get("frameworks") or [options.get("framework") or {}]
            for item in listed:
                match = re.match(r"(\d+)\.", str(item.get("version", ""))) if item.get("name") == "Microsoft.NETCore.App" else None
                major = int(match.group(1)) if match else major
    if not framework:
        framework = {path.name for path in Path(game_dir).glob("*.dll")
                     if path.name in FRAMEWORK_NAMES or path.name.startswith(FRAMEWORK_PREFIXES)}
    return major, framework


def runtime_major(game_dir):
    return runtime_pack(game_dir)[0]


def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def assemblies(game_dir):
    """{name: info} for every managed .dll in the folder."""
    found = {}
    for path in sorted(Path(game_dir).glob("*.dll")):
        info = pe_info(path)
        if info:
            found[path.name] = info
    return found


class Cache:
    def __init__(self, root=CACHE):
        self.root = Path(root)
        self.manifest_path = self.root / "manifest.json"

    def manifest(self):
        try:
            return json.loads(self.manifest_path.read_text())
        except (OSError, ValueError):
            return {}

    def save(self, manifest):
        self.root.mkdir(parents=True, exist_ok=True)
        temp = self.manifest_path.with_suffix(".tmp")
        temp.write_text(json.dumps(manifest, indent=1, sort_keys=True))
        os.replace(temp, self.manifest_path)

    def image(self, il_sha, tag=""):
        return self.root / (il_sha + ("." + tag if tag else "") + ".r2r.dll")

    def original(self, il_sha):
        return self.root / (il_sha + ".il.dll")


def candidates(game_dir, found=None):
    """The game's own IL-only assemblies: the ones crossgen2 can add code to. The runtime's framework
    assemblies are left alone, as most ship precompiled and the rest only forward types."""
    found = assemblies(game_dir) if found is None else found
    framework = runtime_pack(game_dir)[1]
    return [name for name, info in found.items() if info["ilonly"] and not info["r2r"] and name not in framework]


def bubble_tag(game_dir, names, found=None):
    """Names the bubble a set of the game's own assemblies is compiled in: their content plus every other
    managed file it was compiled against (by size and time, so a game update means a new bubble)."""
    game_dir = Path(game_dir)
    found = assemblies(game_dir) if found is None else found
    digest = hashlib.sha256()
    for name in sorted(found):
        path = game_dir / name
        if name in names:
            digest.update(("%s=%s\n" % (name, sha256(path))).encode())
        else:
            st = path.stat()
            digest.update(("%s:%d:%d\n" % (name, st.st_size, st.st_mtime_ns)).encode())
    return "bubble-" + digest.hexdigest()[:16]


def compile_missing(game_dir, cache=None, run=subprocess.run, crossgen=CROSSGEN, log=print, bubble=False):
    """Compiles every candidate whose image is not cached yet. Returns (compiled, failed) names."""
    cache = cache or Cache()
    game_dir = Path(game_dir).resolve()
    major = runtime_major(game_dir)
    if major != CROSSGEN_MAJOR:
        log("r2r: the game's .NET runtime is %s, the compiler is for %d; nothing compiled" % (major, CROSSGEN_MAJOR))
        return [], []
    found = assemblies(game_dir)
    references = [str(game_dir / name) for name in found]
    compiled, failed = [], []
    cache.root.mkdir(parents=True, exist_ok=True)
    lock = open(cache.root / "compile.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lock.close()
        log("r2r: another compile is running; nothing compiled")
        return [], []
    with lock:
        if bubble:
            _compile_bubble(game_dir, candidates(game_dir, found), found, cache, run, crossgen, log, compiled, failed)
        else:
            for name in candidates(game_dir, found):
                _compile_one(game_dir, name, references, cache, run, crossgen, log, compiled, failed)
    return compiled, failed


def _compile_bubble(game_dir, names, found, cache, run, crossgen, log, compiled, failed):
    if not names:
        return
    tag = bubble_tag(game_dir, names, found)
    shas = {name: sha256(game_dir / name) for name in names}
    if all(cache.image(shas[name], tag).exists() for name in names):
        return
    temp = cache.root / (tag + ".tmp")
    shutil.rmtree(temp, ignore_errors=True)
    temp.mkdir(parents=True)
    others = [str(game_dir / name) for name in found if name not in names]
    start = time.monotonic()
    command = ([crossgen] + [str(game_dir / name) for name in names] +
               ["-o", str(temp), "--targetos", "windows", "--targetarch", "x64", "-O", "--parallelism", PARALLELISM,
                "--inputbubble"] + [arg for ref in others for arg in ("--inputbubbleref", ref, "-r", ref)])
    try:
        result = run(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=COMPILE_TIMEOUT_S * 2)
        code, output = result.returncode, (result.stdout or b"").decode(errors="replace").strip().splitlines()
    except (OSError, subprocess.TimeoutExpired) as error:
        code, output = None, [str(error)]
    took = time.monotonic() - start
    infos = {name: pe_info(temp / name) for name in names}
    if code == 0 and all(info and info["r2r"] for info in infos.values()):
        for name in names:
            os.replace(temp / name, cache.image(shas[name], tag))
        compiled.extend(names)
        log("r2r: compiled %d in one bubble with %d others (%.1f MB -> %.1f MB) in %.0f s" % (
            len(names), len(others), sum((game_dir / n).stat().st_size for n in names) / 2**20,
            sum(cache.image(shas[n], tag).stat().st_size for n in names) / 2**20, took))
    else:
        failed.extend(names)
        log("r2r: bubble of %d failed (exit %s) after %.0f s: %s" % (len(names), code, took, output[-1] if output else ""))
    shutil.rmtree(temp, ignore_errors=True)


def _compile_one(game_dir, name, references, cache, run, crossgen, log, compiled, failed):
    source = game_dir / name
    target = cache.image(sha256(source))
    if target.exists():
        return
    temp = target.with_name(target.name + ".tmp")
    start = time.monotonic()
    command = [crossgen, str(source), "-o", str(temp), "--targetos", "windows", "--targetarch", "x64", "-O",
               "--parallelism", PARALLELISM] + [arg for ref in references if ref != str(source) for arg in ("-r", ref)]
    try:
        result = run(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=COMPILE_TIMEOUT_S)
        code, output = result.returncode, (result.stdout or b"").decode(errors="replace").strip().splitlines()
    except (OSError, subprocess.TimeoutExpired) as error:
        code, output = None, [str(error)]
    took = time.monotonic() - start
    info = pe_info(temp) if temp.exists() else None
    if code == 0 and info and info["r2r"]:
        os.replace(temp, target)
        compiled.append(name)
        log("r2r: compiled %s (%.1f MB -> %.1f MB) in %.0f s" % (
            name, source.stat().st_size / 2**20, target.stat().st_size / 2**20, took))
    else:
        if temp.exists():
            temp.unlink()
        failed.append(name)
        log("r2r: %s failed (exit %s) after %.0f s: %s" % (name, code, took, output[-1] if output else ""))


def apply(game_dir, on, cache=None, bubble=False):
    """Swaps cached images in (on) or originals back (off). Returns (swapped, missing) names. Images of the
    other kind (per assembly or bubble) are put back first; a bubble is swapped in whole or not at all."""
    cache = cache or Cache()
    game_dir = Path(game_dir).resolve()
    mode = "bubble" if bubble else "single"
    if on and any(Path(k).parent == game_dir and v.get("mode", "single") != mode for k, v in cache.manifest().items()):
        _restore(game_dir, cache, lambda entry: entry.get("mode", "single") != mode)
    manifest = cache.manifest()
    swapped, missing = [], []
    if on:
        names = candidates(game_dir)
        tag = bubble_tag(game_dir, names) if bubble and names else ""
        shas = {name: sha256(game_dir / name) for name in names}
        missing = [name for name in names if not cache.image(shas[name], tag).exists()]
        for name in names:
            path = game_dir / name
            il_sha = shas[name]
            image = cache.image(il_sha, tag)
            if not image.exists() or (bubble and missing):
                continue
            original = cache.original(il_sha)
            if not original.exists():
                shutil.copyfile(path, original.with_name(original.name + ".tmp"))
                os.replace(original.with_name(original.name + ".tmp"), original)
            temp = path.with_name(path.name + ".droiddeck-r2r")
            shutil.copyfile(image, temp)
            shutil.copystat(path, temp)
            os.replace(temp, path)
            manifest[str(path)] = {"il": il_sha, "r2r": sha256(image), "mode": mode}
            swapped.append(name)
        if on or manifest != cache.manifest():
            cache.save(manifest)
        return swapped, missing
    return _restore(game_dir, cache, lambda entry: True), []


def _restore(game_dir, cache, which):
    manifest = cache.manifest()
    restored = []
    for key, entry in list(manifest.items()):
        path = Path(key)
        if game_dir != path.parent or not which(entry):
            continue
        original = cache.original(entry["il"])
        if path.exists() and original.exists() and sha256(path) == entry["r2r"]:
            temp = path.with_name(path.name + ".droiddeck-r2r")
            shutil.copyfile(original, temp)
            shutil.copystat(path, temp)
            os.replace(temp, path)
            restored.append(path.name)
        del manifest[key]
    if manifest != cache.manifest():
        cache.save(manifest)
    return restored


def status(game_dir, cache=None):
    cache = cache or Cache()
    game_dir = Path(game_dir).resolve()
    found = assemblies(game_dir)
    manifest = cache.manifest()
    ours = {Path(k).name for k, v in manifest.items() if Path(k).parent == game_dir}
    major, framework = runtime_pack(game_dir)
    shipped_r2r = sorted(n for n, i in found.items() if i["r2r"] and n not in ours)
    own = sorted(n for n in found if n not in framework)
    own_r2r = sorted(n for n in own if found[n]["r2r"] and n not in ours)
    il_only = sorted(n for n in own if found[n]["ilonly"] and not found[n]["r2r"])
    mixed = sorted(n for n, i in found.items() if not i["ilonly"] and not i["r2r"])

    def size(names):
        return sum((Path(game_dir) / n).stat().st_size for n in names) / 2**20

    modes = sorted({v.get("mode", "single") for k, v in manifest.items() if Path(k).parent == game_dir})
    lines = ["runtime_major=%s compiler_major=%d managed=%d framework=%d" % (major, CROSSGEN_MAJOR, len(found), len(framework)),
             "precompiled=%d (%.1f MB); the game's own: %s" % (len(shipped_r2r), size(shipped_r2r), " ".join(own_r2r) or "none"),
             "game_il_only=%d (%.1f MB): %s" % (len(il_only), size(il_only), " ".join(il_only)),
             "swapped_in=%d: %s%s" % (len(ours), " ".join(sorted(ours)), " (%s)" % ",".join(modes) if modes else "")]
    if mixed:
        lines.append("mixed_mode=%d: %s" % (len(mixed), " ".join(mixed)))
    return "\n".join(lines) + "\n"


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("action", choices=("status", "compile", "apply"))
    parser.add_argument("game_dir")
    switch = parser.add_mutually_exclusive_group()
    switch.add_argument("--on", action="store_true")
    switch.add_argument("--off", action="store_true")
    parser.add_argument("--bubble", action="store_true", help="one version bubble with the framework copy")
    parser.add_argument("--log", help="append messages to this file as well")
    args = parser.parse_args(argv)

    def log(text):
        print(text, file=sys.stderr)
        if args.log:
            with open(args.log, "a") as f:
                f.write(text + "\n")

    if args.action == "status":
        log(status(args.game_dir).rstrip())
    elif args.action == "compile":
        compiled, failed = compile_missing(args.game_dir, log=log, bubble=args.bubble)
        log("r2r: compile done, %d compiled, %d failed" % (len(compiled), len(failed)))
        return 1 if failed else 0
    else:
        if not (args.on or args.off):
            parser.error("apply needs --on or --off")
        swapped, missing = apply(args.game_dir, args.on, bubble=args.bubble)
        log("r2r: %s %d (%s)%s" % ("swapped in" if args.on else "restored", len(swapped), " ".join(swapped),
                                  "; not compiled yet: " + " ".join(missing) if missing else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/python3
"""Start-up and warm-up settings for one Proton game launch, and the lines that show them in the session log.

Loaded by droiddeck-game-env. Every line it prints starts with "droiddeck-game-env: warmup:".
docs/research/startup-and-warmup.md explains each setting and how to check it on a device.
"""
import mmap
import os
import re
import shutil
import sys
import time
from pathlib import Path

PREFIX = "droiddeck-game-env: warmup: "

# Slay the Spire 2. FEX's disk cache is on for it unless DROIDDECK_FEX_DISKCACHE=0.
FEX_DISK_CACHE_GAMES = frozenset(("2868840",))
FEX_DISK_CACHE_SINCE = 2609
FEX_DLL = "files/lib/wine/aarch64-windows/libarm64ecfex.dll"
FEX_VERSION = re.compile(rb"FEX-(\d{4})(?:\.\d+)?(?:-\d+-g[0-9a-f]{6,40})?")
CACHE_DIR = "droiddeck-fex-cache"
# DROIDDECK_EXP_FEX_CACHE_KEEP=1: FEX keeps one cache folder per disk-cache format (DiskCache/<hash>/) and deletes
# every other folder at start. Stock FEX (format 42 in FEX-2611) and Kestrel's (44) differ, so each switch threw
# the other build's cache away (301.5 MB to 0 on Nov 14). With the switch on, FEX deletes nothing and this keeps
# the folders of the KEEP_BUILDS builds used last, dropping older ones and any past KEEP_MB in all.
KEEP_BUILDS = 2
KEEP_MB = 1536
SCAN_LIMIT = 5000

# Values for DROIDDECK_DOTNET_WARMUP. A DOTNET_ or COMPlus_ variable already set keeps its value.
# W^X is not here: the app's defaults already set DOTNET_EnableWriteXorExecute=0 for every game.
DOTNET_PROFILES = {
    # No instrumented tier: one JIT pass and one FEX translation fewer per hot method.
    "pgo-off": {"DOTNET_TieredPGO": "0"},
    # Also JIT methods with loops fully at once (no OSR) and start counting calls at once.
    "lean": {
        "DOTNET_TieredPGO": "0",
        "DOTNET_TC_QuickJitForLoops": "0",
        "DOTNET_TC_CallCountingDelayMs": "0",
    },
    # Optimised code at the first call: the slowest start, no tier-up later in play.
    "single-tier": {"DOTNET_TieredCompilation": "0"},
}
OFF = ("", "0", "off", "none", "default")
# Used when DROIDDECK_DOTNET_WARMUP is unset; set it to off for the runtime's defaults.
DEFAULT_PROFILE = "pgo-off"


def say(message):
    print(PREFIX + message, file=sys.stderr, flush=True)


def process_age_ms(stat_path="/proc/self/stat", uptime_path="/proc/uptime"):
    """Milliseconds since this process started, interpreter start-up included."""
    try:
        with open(stat_path) as f:
            fields = f.read().rsplit(")", 1)[1].split()
        with open(uptime_path) as f:
            uptime = float(f.read().split()[0])
        started = int(fields[19]) / os.sysconf("SC_CLK_TCK")
    except (OSError, ValueError, IndexError):
        return None
    return max(0, int((uptime - started) * 1000))


class Timer:
    def __init__(self):
        self.phases = []

    def time(self, name, function, *args, **kwargs):
        start = time.monotonic()
        try:
            return function(*args, **kwargs)
        finally:
            self.phases.append((name, int((time.monotonic() - start) * 1000)))

    def report(self, app_id, age_ms=None):
        age = process_age_ms() if age_ms is None else age_ms
        parts = ", ".join("%s %d ms" % phase for phase in self.phases)
        say("launch prep for app %s: %s ms before Proton starts%s" % (
            app_id or "-", "?" if age is None else age, " (" + parts + ")" if parts else ""))


def dotnet_profile(files, env):
    """The DOTNET_ variables a .NET (CoreCLR) game gets for DROIDDECK_DOTNET_WARMUP, and a note."""
    if "coreclr.dll" not in files:
        return {}, None
    unset = "DROIDDECK_DOTNET_WARMUP" not in env
    name = DEFAULT_PROFILE if unset else env["DROIDDECK_DOTNET_WARMUP"].strip().lower()
    if name in OFF:
        return {}, None
    profile = DOTNET_PROFILES.get(name)
    if profile is None:
        return {}, ".NET profile %r unknown (choices: %s); runtime defaults kept" % (name, ", ".join(sorted(DOTNET_PROFILES)))
    chosen, kept = {}, []
    for key, value in profile.items():
        knob = key[len("DOTNET_"):]
        if key in env or "COMPlus_" + knob in env:
            kept.append(key)
        else:
            chosen[key] = value
    note = ".NET profile %s%s: %s" % (name, " (default)" if unset else "", " ".join("%s=%s" % item for item in sorted(chosen.items())) or "nothing to set")
    if kept:
        note += " (already set, kept: %s)" % " ".join(sorted(kept))
    return chosen, note


def fex_version(proton):
    """The FEX release (FEX-YYMM...) in this Proton's ARM64EC FEX library, or None."""
    path = Path(proton).parent / FEX_DLL
    try:
        with open(path, "rb") as f, mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ) as data:
            found = FEX_VERSION.search(data)
            return bytes(found.group(0)).decode("ascii") if found else None
    except (OSError, ValueError):
        return None


def fex_release(version):
    found = version and re.match(r"FEX-(\d{4})", version)
    return int(found.group(1)) if found else None


def windows_path(path):
    return "Z:" + str(path).replace("/", "\\") + "\\"


def z_drive_is_root(prefix):
    link = Path(prefix) / "pfx/dosdevices/z:"
    try:
        return os.readlink(link).rstrip("/") == ""
    except FileNotFoundError:
        # Proton maps Z: to / when it makes the prefix on this launch.
        return not (Path(prefix) / "pfx").exists()
    except OSError:
        return False


def tree_size(root, limit=SCAN_LIMIT):
    count = size = 0
    for top, dirs, files in os.walk(root):
        for name in files:
            try:
                size += os.lstat(os.path.join(top, name)).st_size
            except OSError:
                continue
            count += 1
            if count >= limit:
                return count, size, True
    return count, size, False


def keep_recent_buckets(root, builds=KEEP_BUILDS, limit_mb=KEEP_MB):
    """Deletes FEX disk-cache folders (one per cache format and machine) beyond the `builds` used last, and older
    ones past `limit_mb` in all; the newest always stays. Returns a line for the log, or None."""
    buckets = []
    try:
        entries = [entry for entry in os.scandir(root) if entry.is_dir(follow_symlinks=False)]
    except OSError:
        return None
    for entry in entries:
        newest = entry.stat(follow_symlinks=False).st_mtime
        size = 0
        for top, _, files in os.walk(entry.path):
            for name in files:
                try:
                    info = os.lstat(os.path.join(top, name))
                except OSError:
                    continue
                newest = max(newest, info.st_mtime)
                size += info.st_size
        buckets.append((newest, size, entry.name, entry.path))
    buckets.sort(reverse=True)
    kept, dropped, total = [], [], 0
    for index, (_, size, name, path) in enumerate(buckets):
        if index == 0 or (index < builds and total + size <= limit_mb * 1048576):
            kept.append("%s %.1f MB" % (name, size / 1048576))
            total += size
        else:
            shutil.rmtree(path, ignore_errors=True)
            dropped.append("%s %.1f MB" % (name, size / 1048576))
    if len(buckets) < 2 and not dropped:
        return None
    line = "FEX disk cache folders kept: " + ", ".join(kept)
    if dropped:
        line += "; deleted: " + ", ".join(dropped)
    return line


def describe(count, size, partial):
    return "%d file%s, %.1f MB%s" % (count, "" if count == 1 else "s", size / 1048576, "+" if partial else "")


def fex_disk_cache(app_id, prefix, proton, env):
    """FEX's persistent code cache (FEX-2609 and later): the variables to set and the lines to log."""
    setting = env.get("DROIDDECK_FEX_DISKCACHE", "").strip()
    if setting == "0" or (setting != "1" and app_id not in FEX_DISK_CACHE_GAMES):
        if setting == "0" and app_id in FEX_DISK_CACHE_GAMES:
            return {}, ["FEX disk cache off for app %s (DROIDDECK_FEX_DISKCACHE=0)" % app_id]
        return {}, []
    version = fex_version(proton)
    release = fex_release(version)
    notes = []
    if release is not None and release < FEX_DISK_CACHE_SINCE:
        return {}, ["FEX disk cache not set: this Proton's FEX is %s, the cache came in FEX-%d" % (version, FEX_DISK_CACHE_SINCE)]
    chosen = {}
    if "FEX_DISKCACHE" not in env:
        chosen["FEX_DISKCACHE"] = "1"
    elif env["FEX_DISKCACHE"] != "1":
        return {}, ["FEX disk cache left off: FEX_DISKCACHE=%s is set for this game" % env["FEX_DISKCACHE"]]
    where = None
    if "FEX_APP_CACHE_LOCATION" in env:
        notes.append("FEX cache folder from FEX_APP_CACHE_LOCATION=%s" % env["FEX_APP_CACHE_LOCATION"])
    elif prefix and z_drive_is_root(prefix):
        where = Path(prefix) / CACHE_DIR
        try:
            where.mkdir(exist_ok=True)
            chosen["FEX_APP_CACHE_LOCATION"] = windows_path(where)
        except OSError as error:
            notes.append("FEX cache folder %s not made (%s); FEX picks its own" % (where, error))
            where = None
    else:
        notes.append("the prefix's Z: drive is not /, so FEX keeps its cache in its own folder")
    if env.get("DROIDDECK_EXP_FEX_CACHE_KEEP") == "1":
        if "FEX_DISKCACHEPRUNESTALEENTRIES" not in env:
            chosen["FEX_DISKCACHEPRUNESTALEENTRIES"] = "0"
        if where is not None and (where / "DiskCache").is_dir():
            line = keep_recent_buckets(where / "DiskCache")
            if line:
                notes.append(line)
    state = "no cache yet"
    if where is not None and (where / "DiskCache").is_dir():
        state = describe(*tree_size(where / "DiskCache"))
    notes.insert(0, "FEX disk cache on for app %s (%s, %s%s)" % (
        app_id, version or "FEX version not found", state, ", folder " + str(where) if where is not None else ""))
    return chosen, notes


# DROIDDECK_EXP_PE_ALIGN=1: Wine maps an .exe's section straight from the file only when the section starts at a
# multiple of 4096 bytes in the file; otherwise it reads the whole section into anonymous memory at load
# (dlls/ntdll/unix/virtual.c, map_file_into_view). Godot exports with the .pck embedded put the pack in a section
# at a 512-byte offset, so Wine copies hundreds of MB that Godot never reads through memory (it reads the pack
# through the file), and the copy ends up in swap. With the switch on, the game runs from a copy of its .exe with
# every section at a 4096-byte offset (made once, remade when the original changes); then the section is
# file-backed. docs/research/wine-pe-section-copy.md.
PE_PAGE = 0x1000
PE_ALIGN_MIN_BYTES = 64 << 20
PE_ALIGN_DIR = ".droiddeck-aligned"
PE_ALIGN_SPARE_BYTES = 512 << 20


def _up(value, align=PE_PAGE):
    return (value + align - 1) & ~(align - 1)


def pe_layout(path):
    """Header facts of a PE file: (header bytes, size of headers, sections as (header offset, raw offset, raw
    size, rva, virtual size)), the file offsets of the COFF symbol table, certificate table and debug directory
    entries' data pointers, or None if it is not a PE file."""
    import struct
    with open(path, "rb") as f:
        head = f.read(4096)
        if head[:2] != b"MZ" or len(head) < 0x40:
            return None
        pe = struct.unpack_from("<I", head, 0x3C)[0]
        f.seek(0)
        head = f.read(max(4096, pe + 4096))
        if head[pe:pe + 4] != b"PE\0\0":
            return None
        count = struct.unpack_from("<H", head, pe + 6)[0]
        opt_size = struct.unpack_from("<H", head, pe + 20)[0]
        opt = pe + 24
        size_of_headers = struct.unpack_from("<I", head, opt + 60)[0]
        f.seek(0)
        head = f.read(max(size_of_headers, opt + opt_size + 40 * count))
    return head, pe, opt, opt_size, count


def pe_needs_align(path, min_bytes=PE_ALIGN_MIN_BYTES):
    """True when the file is at least min_bytes and a section of 1 MB or more starts at a file offset Wine cannot
    map."""
    import struct
    try:
        if os.path.getsize(path) < min_bytes:
            return False
        layout = pe_layout(path)
    except OSError:
        return False
    if layout is None:
        return False
    head, pe, opt, opt_size, count = layout
    for i in range(count):
        raw_size, raw_ptr = struct.unpack_from("<II", head, opt + opt_size + 40 * i + 16)
        if raw_size >= 1 << 20 and raw_ptr % PE_PAGE:
            return True
    return False


def pe_section_lines(path, min_bytes=PE_ALIGN_MIN_BYTES):
    """One log line per section of a large .exe, from its headers only: name, file offset, size, offset modulo
    4096 and whether it is the last section in the file. Empty for files under min_bytes or not PE."""
    import struct
    try:
        size = os.path.getsize(path)
        if size < min_bytes:
            return []
        layout = pe_layout(path)
    except OSError:
        return []
    if layout is None:
        return []
    head, pe, opt, opt_size, count = layout
    rows = []
    for i in range(count):
        at = opt + opt_size + 40 * i
        name = head[at:at + 8].rstrip(b"\0").decode("ascii", "replace")
        raw_size, raw_ptr = struct.unpack_from("<II", head, at + 16)
        rows.append((raw_ptr, raw_size, name))
    last = max((r for r in rows if r[0] and r[1]), default=None)
    file_align = struct.unpack_from("<I", head, opt + 36)[0]
    lines = ["%s: %.0f MB, %d sections, FileAlignment %#x" % (os.path.basename(path), size / 1048576, count, file_align)]
    for raw_ptr, raw_size, name in rows:
        lines.append("%s section %s: offset %#x size %d (%.1f MB) offset%%4096 %d%s" % (
            os.path.basename(path), name or "?", raw_ptr, raw_size, raw_size / 1048576, raw_ptr % PE_PAGE,
            " last" if (raw_ptr, raw_size, name) == last else ""))
    return lines


def pe_align_copy(src, dst):
    """Writes a copy of the PE file src to dst with every section at a 4096-byte file offset, reading the file
    in pieces. Section sizes stay; the gaps before sections grow. The last section and whatever follows it
    (Godot's pck trailer, which Godot finds from the end of the file; a symbol table; a signature) stay together
    at the end, and file offsets that point into moved data (symbol table, certificate table, debug directory
    data) move with it. The checksum is cleared."""
    import struct
    head, pe, opt, opt_size, count = pe_layout(src)
    total = os.path.getsize(src)
    magic = struct.unpack_from("<H", head, opt)[0]
    dirs_at = opt + (112 if magic == 0x20B else 96)
    entries = struct.unpack_from("<I", head, dirs_at - 4)[0]
    sections_at = opt + opt_size
    old_headers = struct.unpack_from("<I", head, opt + 60)[0]
    out = bytearray(head[:old_headers])
    out += b"\0" * (_up(old_headers) - len(out))
    struct.pack_into("<I", out, opt + 60, len(out))
    struct.pack_into("<I", out, opt + 36, PE_PAGE)
    struct.pack_into("<I", out, opt + 64, 0)
    sections = []
    for i in range(count):
        at = sections_at + 40 * i
        vsize, rva, raw_size, raw_ptr = struct.unpack_from("<IIII", head, at + 8)
        sections.append((at, raw_ptr, raw_size, rva, vsize))
    moves = []  # (old start, old end, new start)
    position, end = len(out), old_headers
    for at, raw_ptr, raw_size, _, _ in sorted(sections, key=lambda s: s[1]):
        if not raw_ptr or not raw_size:
            continue
        if raw_ptr < end or raw_ptr + raw_size > total:
            raise ValueError("sections overlap or run past the end of the file")
        position = _up(position)
        struct.pack_into("<I", out, at + 20, position)
        moves.append((raw_ptr, raw_ptr + raw_size, position))
        position += raw_size
        end = raw_ptr + raw_size
    moves.append((end, total, position))

    def new_offset(old):
        for start, stop, to in moves:
            if start <= old < stop or old == stop == total:
                return to + old - start
        return old

    def rva_to_offset(rva):
        for _, raw_ptr, raw_size, va, vsize in sections:
            if va <= rva < va + max(vsize, raw_size) and rva - va < raw_size:
                return raw_ptr + rva - va
        return None

    patches = {}  # new file offset -> 4-byte value, for offsets past the headers
    symbols = struct.unpack_from("<I", head, pe + 12)[0]
    if symbols:
        struct.pack_into("<I", out, pe + 12, new_offset(symbols))
    if entries > 4:
        cert_at, cert_size = struct.unpack_from("<II", head, dirs_at + 32)
        if cert_size:
            struct.pack_into("<I", out, dirs_at + 32, new_offset(cert_at))
    with open(src, "rb") as f:
        if entries > 6:
            debug_rva, debug_size = struct.unpack_from("<II", head, dirs_at + 48)
            debug_at = rva_to_offset(debug_rva) if debug_size else None
            if debug_at is not None:
                f.seek(debug_at)
                table = f.read(debug_size)
                for i in range(len(table) // 28):
                    old = struct.unpack_from("<I", table, 28 * i + 24)[0]
                    if old:
                        patches[new_offset(debug_at + 28 * i + 24)] = new_offset(old)
        tmp = dst + ".tmp"
        with open(tmp, "wb") as w:
            w.write(out)
            for start, stop, to in moves:
                w.seek(to)
                f.seek(start)
                left = stop - start
                while left:
                    chunk = f.read(min(left, 8 << 20))
                    if not chunk:
                        raise ValueError("file shorter than its headers say")
                    w.write(chunk)
                    left -= len(chunk)
            for at, value in patches.items():
                w.seek(at)
                w.write(struct.pack("<I", value))
            w.truncate(position + total - end)
        os.replace(tmp, dst)


def pe_aligned_exe(exe, min_bytes=PE_ALIGN_MIN_BYTES, statvfs=os.statvfs):
    """The path to launch instead of exe, made or remade as needed, and a line for the log; (None, line or None)
    when the original stays. The copy keeps the original's name, in a folder PE_ALIGN_DIR beside it that links to
    everything else in the game's folder, so the game finds its data and DLLs and its process keeps its name."""
    if not pe_needs_align(exe, min_bytes):
        return None, None
    folder, name = os.path.split(os.path.abspath(exe))
    where = os.path.join(folder, PE_ALIGN_DIR)
    copy, stamp_path = os.path.join(where, name), os.path.join(where, name + ".src")
    info = os.stat(exe)
    stamp = "%d %d\n" % (info.st_size, info.st_mtime_ns)
    try:
        os.makedirs(where, exist_ok=True)
        link_siblings(folder, where, name)
        with open(stamp_path) as f:
            same = f.read() == stamp
        if same and os.path.getsize(copy) >= info.st_size:
            return copy, "aligned copy of %s in use (%.0f MB)" % (name, info.st_size / 1048576)
    except OSError:
        pass
    try:
        free = statvfs(folder)
        have, need = free.f_bavail * free.f_frsize, info.st_size + PE_ALIGN_SPARE_BYTES
        if have < need:
            return None, "aligned copy of %s not made: too little free space (%.0f MB free, %.0f MB needed)" % (
                name, have / 1048576, need / 1048576)
        started = time.monotonic()
        pe_align_copy(exe, copy)
        with open(stamp_path, "w") as f:
            f.write(stamp)
    except (OSError, ValueError) as error:
        for path in (copy + ".tmp", stamp_path):
            try:
                os.unlink(path)
            except OSError:
                pass
        return None, "aligned copy of %s not made (%s)" % (name, error)
    return copy, "aligned copy of %s made in %.1f s (%.0f MB)" % (name, time.monotonic() - started, info.st_size / 1048576)


def link_siblings(folder, where, name):
    """Links every entry of folder but name and where itself into where, and drops links whose target is gone."""
    keep = {name, name + ".src", name + ".tmp"}
    for entry in os.listdir(folder):
        if entry in (name, PE_ALIGN_DIR):
            continue
        link = os.path.join(where, entry)
        keep.add(entry)
        if not os.path.lexists(link):
            os.symlink(os.path.join("..", entry), link)
    for entry in os.listdir(where):
        if entry not in keep and os.path.islink(os.path.join(where, entry)):
            os.unlink(os.path.join(where, entry))


GODOT_PIPELINES = ("*/vulkan/pipelines.*.cache", "Godot/app_userdata/*/vulkan/pipelines.*.cache")
GODOT_SHADERS = ("*/shader_cache", "Godot/app_userdata/*/shader_cache")


def godot_caches(prefix):
    """Godot's own Vulkan pipeline cache and SPIR-V shader cache in the prefix, as one line."""
    roaming = Path(prefix) / "pfx/drive_c/users/steamuser/AppData/Roaming"
    if not roaming.is_dir():
        return None
    pipelines = []
    for pattern in GODOT_PIPELINES:
        for path in roaming.glob(pattern):
            try:
                pipelines.append("%s %d KB" % (path.relative_to(roaming), path.stat().st_size // 1024))
            except OSError:
                continue
    shaders = []
    for pattern in GODOT_SHADERS:
        for path in roaming.glob(pattern):
            if path.is_dir():
                shaders.append("%s %s" % (path.relative_to(roaming), describe(*tree_size(path))))
    return "Godot caches: pipelines %s; shaders %s" % ("; ".join(sorted(pipelines)) or "none",
                                                       "; ".join(sorted(shaders)) or "none")


def wine_update_pending(prefix, proton):
    """A line when Wine will run wineboot --update in this prefix: Proton keeps .update-timestamp
    equal to wine.inf's mtime so that it does not, and a different value means it will."""
    stamp = Path(prefix) / "pfx/.update-timestamp"
    inf = Path(proton).parent / "files/share/wine/wine.inf"
    try:
        recorded = stamp.read_text().strip()
        mtime = int(inf.stat().st_mtime)
    except (OSError, ValueError):
        return None
    if recorded == "disable" or recorded == str(mtime):
        return None
    return "Wine will update this prefix (wineboot) before the game: .update-timestamp %s, wine.inf %d" % (recorded or "empty", mtime)


def apply(command, env, app_id, prefix, files):
    """Settings for a waitforexitandrun launch. Returns the environment to start Proton with."""
    if len(command) < 3 or not app_id:
        return env
    result = dict(env)
    chosen, note = dotnet_profile(files, env)
    result.update(chosen)
    if note:
        say(note)
    chosen, notes = fex_disk_cache(app_id, prefix, command[0], env)
    result.update(chosen)
    for line in notes:
        say(line)
    if prefix:
        line = wine_update_pending(prefix, command[0])
        if line:
            say(line)
        if command[2] and (Path(command[2]).stem.lower() + ".pck" in files or "godotsharp.dll" in files):
            line = godot_caches(prefix)
            if line:
                say(line)
    return result

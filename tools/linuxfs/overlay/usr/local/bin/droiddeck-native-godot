#!/usr/bin/env python3
"""Run a Windows Godot 4 C# game on Kestrel's own linux-arm64 engine, skipping Wine and FEX.

The game's managed code (its own DLLs) is portable IL, so it can run on a linux-arm64 .NET runtime.
This tool builds a launch folder next to our engine binary:

    <launch>/<engine>                          our Godot 4.5.1 linux-arm64 mono template
    <launch>/data_<asm>_linuxbsd_arm64/        the "kit" (linux-arm64 .NET runtime + stock GodotSharp)
                                               plus the game's own managed DLLs, hardlinked from the game
                                               folder (they never leave the device)

and starts the engine on the game's pack. Game files stay where Steam put them; nothing is uploaded.

`run` watches the engine for its first frames: it asks Godot to print its frame rate (--print-fps), whose
first "Project FPS" line comes a few seconds into the main loop, and logs "first frame" when it does. If none
comes within FIRST_FRAME_S of the engine's start (timed after any fetch), or the engine exits before one,
the engine did not start: `run` kills it and exits with DID_NOT_START (86), so the caller can fall back.
After the first frame the engine's own exit code passes through. Frame-rate lines are thinned to one a minute.

The engine and kit come as one component (`--component DIR`, or `--fetch` for the pinned release on
the fork, cached under ~/.cache/droiddeck/native/<tag>/):

    godot                  the engine
    kit/                   kit.json + the linux-arm64 data folder of a stock C# export

Steam: the game's Steamworks.NET talks to the real Steam client in the session through Valve's own linux-arm64
libsteam_api.so, downloaded on the device from the public Steamworks.NET NuGet package (STEAM_API, sha256
pinned) and placed as libsteam_api64.so, the name a Windows build asks for. A component with
steam-bridge/libsteam_api64.so (Cedar approved it, 2026-11-15) puts that bridge there instead and Valve's library
beside it as libsteam_api.so: the bridge defines the interface accessors Steamworks.NET calls at SteamAPI.Init.
A version the game asks for that Valve's library shares goes through unchanged; an older one gets the real
client's interface in the library's own version (the layout its flat functions use; Cedar, 2026-11-15, on the
game's "Steam failed to initialize": "Don't ask just do"); GameSearch and MusicRemote, whose accessors and
functions Valve dropped, go to GetISteamGenericInterface, with a placeholder if the client serves neither.
Init, the user, ownership, licences and tickets all resolve in Valve's library. Nothing fakes Steam: an older component that carries a stubs/
folder (a no-op Steamworks stand-in, up to native-engine-38) is refused.

`check` is a dry run for the phone, off the launch path: it composes into --out, checks the launch folder is
one the engine can start (the game's assembly there, every game assembly loadable-shaped, deps.json and
runtimeconfig.json written, the engine in place) and records pass/fail with the component tag and a fingerprint
of the game's data folder (names, sizes, mtimes) in ~/.cache/droiddeck/native/check/<name>.json, logging one
"check pass|fail" line. Exit 0 on pass, 1 on fail. droiddeck-game-env skips the native path while a fresh
result for the same game files, component and converter says fail.

Usage:
  droiddeck-native-godot compose|run|check --game-dir DIR (--fetch | --component DIR | --kit DIR --engine FILE)
                                           --out DIR [--exe NAME] [--name NAME] [-- ENGINE ARGS...]
"""
import argparse
import ctypes.util
import hashlib
import json
import os
import re
import shutil
import signal
import struct
import subprocess
import sys
import tempfile
import threading
import time
import urllib.request

# The published component. Built by .github/workflows/native-engine-build.yml (publish=true).
COMPONENT = {"tag": "native-engine-65",
             "url": "https://github.com/renxida/DroidDeck/releases/download/native-engine-65/native-engine.tar.zst",
             "sha256": "409dce6fc579032ca1c744f3832bf359705b8b6dd73739bf9f1165c4dd824daa"}
# The component layout this wrapper understands. A release declares its own in component.json; CI's resolver
# (tools/native-engine/resolve_component.py) only pins releases whose api matches.
COMPONENT_API = 1
# The build writes the newest gated engine release it found here (next to this file in the guest:
# /usr/local/share/droiddeck/native-engine.json), so a published engine reaches the app with no one copying its
# tag. COMPONENT above is the fallback when the file is missing or unusable.
PIN_FILE = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "share", "droiddeck",
                        "native-engine.json")
COMPONENT_URL = re.compile(r"https://github\.com/renxida/DroidDeck/releases/download/(native-engine-\d+)/native-engine\.tar\.zst")


def pinned_component(path=PIN_FILE, fallback=None):
    """The component the build pinned in PIN_FILE, or fallback (COMPONENT) when there is none or it is unusable."""
    fallback = COMPONENT if fallback is None else fallback
    try:
        with open(path, encoding="utf-8") as f:
            pin = json.load(f)
    except (OSError, ValueError):
        return fallback
    if not isinstance(pin, dict):
        return fallback
    url = COMPONENT_URL.fullmatch(str(pin.get("url", "")))
    if (pin.get("api") != COMPONENT_API or not url or url.group(1) != pin.get("tag")
            or not re.fullmatch(r"[0-9a-f]{64}", str(pin.get("sha256", "")))):
        return fallback
    return {"tag": pin["tag"], "url": pin["url"], "sha256": pin["sha256"]}


COMPONENT = pinned_component()
# Valve's linux-arm64 Steamworks library, as packaged by Steamworks.NET on nuget.org (Steamworks SDK 1.63+).
STEAM_API = {"package": "Steamworks.NET.AnyCPU 2026.165.3",
             "url": "https://api.nuget.org/v3-flatcontainer/steamworks.net.anycpu/2026.165.3/"
                    "steamworks.net.anycpu.2026.165.3.nupkg",
             "sha256": "254b06a1d88ee7fe3a47ca107c3ca3fb13b0d81a0cde4b4efd872467d682f2db",

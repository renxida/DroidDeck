       "sha256": "1f090fc45429292ae21f9199d5b956ad3570c38a7778ea4085258641727eefaf",
       "version": "72.1.0.3",
       "members": {"libicudata.so.72.1.0.3": "900d44dddc886bfb22c926f3e11d875c734ff59bd603efe7f790d24ebff7a78e",

+// SPDX-License-Identifier: MIT
+#pragma once
+
+// Config NameWindowsMemory (seconds, 0 = off): every that many seconds a FEX-internal thread walks the process's
+// committed Windows private memory and names its Linux mappings by owner (PR_SET_VMA_ANON_NAME), so /proc/<pid>/smaps
+// can say what the anonymous memory is: [anon:win:heap] (Windows heaps: Wine's RtlHeap, which Godot, the .NET runtime
+// and Wine malloc from), win:stack (thread stacks), win:exec (executable: .NET JIT code and stubs), win:gc (inside a
+// reservation of 16 GB or more: the .NET regions GC heap), win:big (other reservations of 256 MB or more),
+// win:private (the rest). FEX's own named memory is never relabelled.
+namespace FEX::Windows::MemoryNames {
+void ProcessInit();
+// At the start of every thread's init, before FEX's locks: starts the worker with the process's second thread.
+void ThreadInit();
+} // namespace FEX::Windows::MemoryNames

+// Every range FEX names for itself, coalesced and sorted by begin, so NameWindowsMemory never relabels FEX's memory.
+// A fixed array: recording must not allocate, because FEX's allocator names the memory it maps through VirtualName and
+// would come back in here (with the lock held). When full, the two closest neighbours are merged into one range.
+namespace {
+  struct FEXRange {
+    uint64_t Begin, End;
+  };
+  constexpr size_t MaxFEXNamed = 4096;
+  SRWLOCK FEXNamedLock = SRWLOCK_INIT;
+  FEXRange FEXNamed[MaxFEXNamed];
+  size_t FEXNamedCount;
+
+  // First index whose Begin is greater than Value.
+  size_t UpperBound(uint64_t Value) {
+    size_t Lo = 0, Hi = FEXNamedCount;
+    while (Lo < Hi) {
+      size_t Mid = (Lo + Hi) / 2;
+      if (FEXNamed[Mid].Begin <= Value) {
+        Lo = Mid + 1;
+      } else {
+        Hi = Mid;
+      }
+    }
+    return Lo;
+  }
+
+  void RecordFEXNamed(uint64_t Begin, uint64_t End) {
+    AcquireSRWLockExclusive(&FEXNamedLock);
+    size_t First = UpperBound(Begin);
+    if (First > 0 && FEXNamed[First - 1].End >= Begin) {
+      --First;
+    }
+    size_t Last = First; // One past the last range that touches [Begin, End].
+    while (Last < FEXNamedCount && FEXNamed[Last].Begin <= End) {
+      ++Last;
+    }
+    if (Last > First) {
+      Begin = std::min(Begin, FEXNamed[First].Begin);
+      End = std::max(End, FEXNamed[Last - 1].End);
+    }
+    if (Last == First && FEXNamedCount == MaxFEXNamed) {
+      // Full: merge the pair with the smallest gap to make room.
+      size_t Best = 0;
+      for (size_t i = 1; i + 1 < FEXNamedCount; ++i) {
+        if (FEXNamed[i + 1].Begin - FEXNamed[i].End < FEXNamed[Best + 1].Begin - FEXNamed[Best].End) {
+          Best = i;
+        }
+      }
+      FEXNamed[Best].End = FEXNamed[Best + 1].End;
+      memmove(&FEXNamed[Best + 1], &FEXNamed[Best + 2], (FEXNamedCount - Best - 2) * sizeof(FEXRange));
+      --FEXNamedCount;
+      ReleaseSRWLockExclusive(&FEXNamedLock);
+      RecordFEXNamed(Begin, End);
+      return;
+    }
+    // Replace [First, Last) with the one merged range.
+    const size_t Tail = FEXNamedCount - Last;
+    const size_t NewLast = First + 1;
+    memmove(&FEXNamed[NewLast], &FEXNamed[Last], Tail * sizeof(FEXRange));
+    FEXNamed[First] = {Begin, End};
+    FEXNamedCount = NewLast + Tail;
+    ReleaseSRWLockExclusive(&FEXNamedLock);
+  }
+} // namespace
+
+bool OverlapsFEXNamed(uint64_t Begin, uint64_t End) {
+  AcquireSRWLockShared(&FEXNamedLock);
+  const size_t i = [&] {
+    // Last range whose Begin is below End.
+    size_t Lo = 0, Hi = FEXNamedCount;
+    while (Lo < Hi) {
+      size_t Mid = (Lo + Hi) / 2;
+      if (FEXNamed[Mid].Begin < End) {
+        Lo = Mid + 1;
+      } else {
+        Hi = Mid;
+      }
+    }
+    return Lo;
+  }();
+  const bool Overlaps = i > 0 && FEXNamed[i - 1].End > Begin;
+  ReleaseSRWLockShared(&FEXNamedLock);
+  return Overlaps;
+}
+
+bool TryVirtualName(const char* Name, const void* Ptr, size_t Size) {
+  if (!SupportsVirtualName || !Available()) {
+    return false;
+  }
+  FEXUnixLib_SetVMAName Args {
+    .Addr = Ptr,
+    .Size = Size,
+    .Name = Name,
+  };
+  return Call(FEXUnixLibFunctions::SetVMAName, &Args) == STATUS_SUCCESS;
+}
+
 void VirtualName(const char* Name, const void* Ptr, size_t Size) {
+  if (Ptr && Size) {
+    RecordFEXNamed(reinterpret_cast<uint64_t>(Ptr), reinterpret_cast<uint64_t>(Ptr) + Size);
+  }
   if (!SupportsVirtualName || !Available()) {
     return;
   }

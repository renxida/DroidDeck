new file mode 100644
index 0000000..261b49d
--- /dev/null
+++ b/Source/Windows/ARM64EC/MemoryNames.cpp
@@ -0,0 +1,242 @@
+// SPDX-License-Identifier: MIT
+#include "ARM64EC/MemoryNames.h"
+#include "Windows/Common/FEXUnixLib.h"
+
+#include <FEXCore/Config/Config.h>
+#include <FEXCore/Utils/LogManager.h>
+#include <FEXCore/Utils/Threads.h>
+#include <FEXCore/fextl/map.h>
+#include <FEXCore/fextl/memory.h>
+#include <FEXCore/fextl/set.h>
+#include <FEXCore/fextl/vector.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+
+#include <windef.h>
+#include <winbase.h>
+#include <winternl.h>
+#include <winnt.h>
+#include <memoryapi.h>
+#include <sysinfoapi.h>
+
+namespace FEX::Windows::MemoryNames {
+namespace {
+  uint32_t IntervalS {};
+  fextl::unique_ptr<FEXCore::Threads::Thread> Worker;
+  // What the last pass named: region base -> (size, label), so an unchanged region isn't renamed every pass.
+  fextl::map<uint64_t, std::pair<uint64_t, const char*>> Named;
+
+  constexpr uint64_t GiB = 1ULL << 30;
+  constexpr uint64_t MiB = 1ULL << 20;
+
+  // Wine's heap (dlls/ntdll/heap.c since Wine 8, win64 layout): magic 'HEAP' at 0xc0, its subheap list at 0x90 and
+  // large-block list at 0xa0, each a doubly linked struct list { next, prev } whose nodes sit inside the subheap or
+  // the large block's own allocation. Checked against the magic before use; any other layout only labels the heap's
+  // first allocation.
+  constexpr size_t HeapSubheapList = 0x90;
+  constexpr size_t HeapLargeList = 0xa0;
+  constexpr size_t HeapMagicOffset = 0xc0;
+  constexpr uint32_t HeapMagic = 'H' | ('E' << 8) | ('A' << 16) | ('P' << 24);
+  constexpr size_t MaxListWalk = 1 << 16;
+
+  uint64_t AllocationBase(const void* Ptr) {
+    MEMORY_BASIC_INFORMATION Info {};
+    if (!Ptr || !VirtualQuery(Ptr, &Info, sizeof(Info)) || Info.State != MEM_COMMIT) {
+      return 0;
+    }
+    return reinterpret_cast<uint64_t>(Info.AllocationBase);
+  }
+
+  void WalkList(const uint8_t* Head, fextl::set<uint64_t>& Bases) {
+    struct Link {
+      Link* Next;
+      Link* Prev;
+    };
+    auto* HeadLink = reinterpret_cast<const Link*>(Head);
+    const Link* It = HeadLink->Next;
+    for (size_t i = 0; It && It != HeadLink && i < MaxListWalk; ++i) {
+      const uint64_t Base = AllocationBase(It);
+      if (!Base) {
+        break;
+      }
+      Bases.insert(Base);
+      It = It->Next;
+    }
+  }
+
+  // Allocation bases of every Windows heap's memory: the heap itself, its other subheaps and its large blocks.
+  // ntdll calls only: this DLL is loaded before kernelbase, and importing from kernelbase makes the loader map and
+  // initialize it while the emulator itself is still loading (Wine crashes or hangs at process start).
+  fextl::set<uint64_t> HeapBases() {
+    fextl::set<uint64_t> Bases;
+    fextl::vector<HANDLE> Heaps(256);
+    ULONG Count = RtlGetProcessHeaps(Heaps.size(), Heaps.data());
+    if (Count > Heaps.size()) {
+      Heaps.resize(Count + 16);
+      Count = RtlGetProcessHeaps(Heaps.size(), Heaps.data());
+    }
+    Heaps.resize(std::min<size_t>(Count, Heaps.size()));
+    for (HANDLE Heap : Heaps) {
+      const uint64_t Base = AllocationBase(Heap);
+      if (!Base) {
+        continue;
+      }
+      Bases.insert(Base);
+      const auto* Bytes = reinterpret_cast<const uint8_t*>(Heap);
+      uint32_t Magic {};
+      memcpy(&Magic, Bytes + HeapMagicOffset, sizeof(Magic));
+      if (Magic != HeapMagic || !RtlLockHeap(Heap)) {
+        continue;
+      }
+      WalkList(Bytes + HeapSubheapList, Bases);
+      WalkList(Bytes + HeapLargeList, Bases);
+      RtlUnlockHeap(Heap);
+    }
+    return Bases;
+  }
+
+  struct Region {
+    uint64_t Base, Size, Alloc;
+    DWORD State, Type, Protect;
+  };
+
+  struct Allocation {
+    uint64_t End {};
+    bool Guard {};
+  };
+
+  const char* Label(const Region& R, const Allocation& A, const fextl::set<uint64_t>& Heaps) {
+    if (Heaps.contains(R.Alloc)) {
+      return "win:heap";
+    }
+    if (A.Guard) {
+      return "win:stack";
+    }
+    if (R.Protect & (PAGE_EXECUTE | PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY)) {
+      return "win:exec";
+    }
+    const uint64_t Span = A.End - R.Alloc;
+    if (Span >= 16 * GiB) {
+      return "win:gc";
+    }
+    if (Span >= 256 * MiB) {
+      return "win:big";
+    }
+    return "win:private";
+  }
+
+  struct PassStats {
+    size_t Regions, Calls, Failed;
+    double Ms;
+  };
+
+  PassStats Pass() {
+    const auto Began = std::chrono::steady_clock::now();
+    const auto Heaps = HeapBases();
+
+    SYSTEM_INFO Sys {};
+    GetSystemInfo(&Sys);
+    fextl::vector<Region> Regions;
+    fextl::map<uint64_t, Allocation> Allocs;
+    auto Addr = reinterpret_cast<uint64_t>(Sys.lpMinimumApplicationAddress);
+    const auto Max = reinterpret_cast<uint64_t>(Sys.lpMaximumApplicationAddress);
+    while (Addr < Max) {
+      MEMORY_BASIC_INFORMATION Info {};
+      if (!VirtualQuery(reinterpret_cast<void*>(Addr), &Info, sizeof(Info)) || !Info.RegionSize) {
+        break;
+      }
+      const auto Base = reinterpret_cast<uint64_t>(Info.BaseAddress);
+      const auto Alloc = reinterpret_cast<uint64_t>(Info.AllocationBase);
+      if (Info.State != MEM_FREE && Info.Type == MEM_PRIVATE) {
+        auto& A = Allocs[Alloc];
+        A.End = std::max(A.End, Base + Info.RegionSize);
+        A.Guard |= (Info.Protect & PAGE_GUARD) != 0;
+        if (Info.State == MEM_COMMIT) {
+          Regions.push_back({Base, Info.RegionSize, Alloc, Info.State, Info.Type, Info.Protect});
+        }
+      }
+      Addr = Base + Info.RegionSize;
+    }
+
+    PassStats Stats {Regions.size(), 0, 0, 0};
+    fextl::map<uint64_t, std::pair<uint64_t, const char*>> Now;
+    // Adjacent regions with the same label are named in one call.
+    uint64_t RunBase {}, RunEnd {};
+    const char* RunLabel {};
+    auto Flush = [&] {
+      if (!RunLabel) {
+        return;
+      }
+      Now[RunBase] = {RunEnd - RunBase, RunLabel};
+      auto Old = Named.find(RunBase);
+      if (Old == Named.end() || Old->second.first != RunEnd - RunBase || Old->second.second != RunLabel) {
+        ++Stats.Calls;
+        if (!UnixLib::TryVirtualName(RunLabel, reinterpret_cast<void*>(RunBase), RunEnd - RunBase)) {
+          ++Stats.Failed;
+        }
+      }
+      RunLabel = nullptr;
+    };
+    for (const auto& R : Regions) {
+      const uint64_t End = R.Base + R.Size;
+      if (UnixLib::OverlapsFEXNamed(R.Base, End)) {
+        Flush();
+        continue;
+      }
+      const char* L = Label(R, Allocs[R.Alloc], Heaps);
+      if (RunLabel && (L != RunLabel || R.Base != RunEnd)) {
+        Flush();
+      }
+      if (!RunLabel) {
+        RunBase = R.Base;
+        RunLabel = L;
+      }
+      RunEnd = End;
+    }
+    Flush();
+    Named = std::move(Now);
+    Stats.Ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - Began).count();
+    return Stats;
+  }
+
+  // The first pass waits at least this long, so process start (loader, runtime init, the first frames) is never
+  // walked or named.
+  constexpr uint32_t FirstPassMinS = 30;
+
+  void* WorkerMain(void*) {
+    for (uint64_t N = 0;; ++N) {
+      const uint32_t WaitS = N == 0 ? std::max(IntervalS, FirstPassMinS) : IntervalS;
+      LARGE_INTEGER Delay {.QuadPart = -int64_t(WaitS) * 10'000'000LL};
+      NtDelayExecution(FALSE, &Delay);
+      const auto S = Pass();
+      if (N < 3 || N % 10 == 0) {
+        LogMan::Msg::IFmt("NameWindowsMemory: {} committed private regions, {} named, {} refused, {:.1f} ms", S.Regions, S.Calls,
+                          S.Failed, S.Ms);
+      }
+    }
+    return nullptr;
+  }
+} // namespace
+
+void ProcessInit() {
+  FEX_CONFIG_OPT(NameWindowsMemory, NAMEWINDOWSMEMORY);
+  if (UnixLib::Available()) {
+    IntervalS = NameWindowsMemory();
+  }
+}
+
+// The worker is never created during process init (Wine is still setting up the ARM64EC process and a thread created
+// then can hang it at start), only once a second thread initializes, and outside FEX's locks.
+void ThreadInit() {
+  static std::atomic<uint32_t> Inits {};
+  static std::atomic<bool> Started {};
+  if (!IntervalS || Inits.fetch_add(1) == 0 || Started.exchange(true)) {
+    return;
+  }
+  Worker = FEXCore::Threads::Thread::Create(WorkerMain, nullptr, {.LowPriority = true, .Internal = true}, "FEX memory names");
+}
+} // namespace FEX::Windows::MemoryNames

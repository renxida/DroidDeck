+// Every range FEX names for itself, coalesced (begin -> end), so NameWindowsMemory never relabels FEX's memory.
+static std::mutex FEXNamedMutex;
+static std::map<uint64_t, uint64_t> FEXNamed;
+
+static void RecordFEXNamed(uint64_t Begin, uint64_t End) {
+  std::scoped_lock Lock(FEXNamedMutex);
+  auto it = FEXNamed.upper_bound(Begin);
+  if (it != FEXNamed.begin() && std::prev(it)->second >= Begin) {
+    --it;
+    Begin = it->first;
+    End = std::max(End, it->second);
+    it = FEXNamed.erase(it);
+  }
+  while (it != FEXNamed.end() && it->first <= End) {
+    End = std::max(End, it->second);
+    it = FEXNamed.erase(it);
+  }
+  FEXNamed.emplace(Begin, End);
+}
+
+bool OverlapsFEXNamed(uint64_t Begin, uint64_t End) {
+  std::scoped_lock Lock(FEXNamedMutex);
+  auto it = FEXNamed.lower_bound(End);
+  return it != FEXNamed.begin() && std::prev(it)->second > Begin;
+}
+
+bool TryVirtualName(const char* Name, const void* Ptr, size_t Size) {
+  if (!SupportsVirtualName || !Available()) {
+    return false;
+  }
+  FEXUnixLib_SetVMAName Args {
+    .Addr = Ptr,
+    .Size = Size,
+    .Name = Name,
+  };
+  return Call(FEXUnixLibFunctions::SetVMAName, &Args) == STATUS_SUCCESS;
+}
+
 void VirtualName(const char* Name, const void* Ptr, size_t Size) {
+  if (Ptr && Size) {
+    RecordFEXNamed(reinterpret_cast<uint64_t>(Ptr), reinterpret_cast<uint64_t>(Ptr) + Size);
+  }
   if (!SupportsVirtualName || !Available()) {
     return;
   }

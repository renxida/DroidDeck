From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 13 Nov 2026 03:45:38 +0000
Subject: [PATCH 1/3] Emit the vector TSO half barrier whenever an op is TSO

Vector LoadMemTSO/StoreMemTSO only exist when vector TSO is on or volatile
metadata forces TSO, so gate the DMB on the op, not the global flag. Without
this, forced vector ranges silently lose their ordering.
---
 FEXCore/Source/Interface/Core/JIT/MemoryOps.cpp | 12 ++++--------
 1 file changed, 4 insertions(+), 8 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/JIT/MemoryOps.cpp b/FEXCore/Source/Interface/Core/JIT/MemoryOps.cpp
index d7b716c..08c84d7 100644
--- a/FEXCore/Source/Interface/Core/JIT/MemoryOps.cpp
+++ b/FEXCore/Source/Interface/Core/JIT/MemoryOps.cpp
@@ -845,10 +845,8 @@ DEF_OP(LoadMemTSO) {
     }
     default: LOGMAN_MSG_A_FMT("Unhandled LoadMemTSO size: {}", OpSize); break;
     }
-    if (CTX->IsVectorAtomicTSOEnabled()) {
-      // Half-barrier.
-      dmb(ARMEmitter::BarrierScope::ISHLD);
-    }
+    // Vector loads only become LoadMemTSO when vector TSO is on or volatile metadata forces TSO.
+    dmb(ARMEmitter::BarrierScope::ISHLD);
   }
 }
 
@@ -1838,10 +1836,8 @@ DEF_OP(StoreMemTSO) {
       }
     }
   } else {
-    if (CTX->IsVectorAtomicTSOEnabled()) {
-      // Half-Barrier.
-      dmb(ARMEmitter::BarrierScope::ISH);
-    }
+    // Vector stores only become StoreMemTSO when vector TSO is on or volatile metadata forces TSO.
+    dmb(ARMEmitter::BarrierScope::ISH);
     const auto Src = GetVReg(Op->Value);
     const auto MemSrc = GenerateMemOperand(OpSize, MemReg, Op->Offset, Op->OffsetType, Op->OffsetScale);
     switch (OpSize) {

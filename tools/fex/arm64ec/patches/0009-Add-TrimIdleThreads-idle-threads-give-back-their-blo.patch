+// Config TrimIdleThreads (seconds, 0 = off). A thread that has used no CPU time for that long gets its per-thread block
+// caches emptied and is moved onto the newest code buffer. A thread only gives up an old code buffer when it next
+// compiles, so threads that sit in waits (thread pools, loaders that finished) otherwise keep every buffer they ever
+// used alive, along with an L1 of up to 16 MB each, all of it cold and pushed to swap. Uses the same suspend as
+// ThreadTerm: once NtGetContextThread returns the thread is outside the JIT and holds no JIT locks.
+namespace IdleTrim {
+  uint32_t IntervalS {};
+  fextl::unique_ptr<FEXCore::Threads::Thread> Worker;
+
+  struct Seen {
+    uint64_t CPUTime;
+    bool Trimmed;
+  };
+  // Worker thread only.
+  fextl::map<DWORD, Seen> LastPass;
+
+  struct PassStats {
+    size_t Threads, Idle, Trimmed, Skipped, Moved, BuffersFreed;
+    double Ms;
+  };
+
+  PassStats Pass() {
+    const auto Began = std::chrono::steady_clock::now();
+    PassStats Stats {};
+    const DWORD Self = GetCurrentThreadId();
+    fextl::map<DWORD, Seen> Now;
+    fextl::vector<FEXCore::Context::TrimmedThreadState> Keep;
+    fextl::vector<FEXCore::Core::InternalThreadState*> Trimmed;
+
+    std::scoped_lock Lock(ThreadCreationMutex);
+    // Nothing may be allocated or freed while a thread is suspended (it may hold an allocator lock), so reserve first.
+    Keep.reserve(Threads.size());
+    Trimmed.reserve(Threads.size());
+    Stats.Threads = Threads.size();
+    for (const auto& [TID, Thread] : Threads) {
+      if (TID == Self) {
+        continue;
+      }
+      // ntdll calls only: this DLL loads before kernelbase and must not import from it.
+      HANDLE Handle {};
+      OBJECT_ATTRIBUTES Attr {.Length = sizeof(Attr)};
+      CLIENT_ID Client {.UniqueThread = reinterpret_cast<HANDLE>(static_cast<uintptr_t>(TID))};
+      if (!NT_SUCCESS(NtOpenThread(&Handle, THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, &Attr, &Client))) {
+        continue;
+      }
+      KERNEL_USER_TIMES Times {};
+      if (!NT_SUCCESS(NtQueryInformationThread(Handle, ThreadTimes, &Times, sizeof(Times), nullptr))) {
+        NtClose(Handle);
+        continue;
+      }
+      const uint64_t CPUTime = Times.KernelTime.QuadPart + Times.UserTime.QuadPart;
+      const auto Last = LastPass.find(TID);
+      const bool Idle = Last != LastPass.end() && Last->second.CPUTime == CPUTime;
+      const bool AlreadyTrimmed = Idle && Last->second.Trimmed;
+      Now[TID] = {CPUTime, AlreadyTrimmed};
+      if (!Idle || AlreadyTrimmed) {
+        NtClose(Handle);
+        continue;
+      }
+      ++Stats.Idle;
+
+      bool Done = false;
+      Keep.emplace_back();
+      if (NT_SUCCESS(NtSuspendThread(Handle, nullptr))) {
+        CONTEXT TmpContext {};
+        TmpContext.ContextFlags = CONTEXT_CONTROL;
+        // Waits for the thread to be suspended, as in ThreadTerm.
+        NtGetContextThread(Handle, &TmpContext);
+        const auto [Err, CPUArea] = GetThreadCPUArea(Handle);
+        if (!Err && !CPUArea.Area->InSimulation && CPUArea.ThreadState() == Thread) {
+          Done = CTX->TrimSuspendedThread(Thread, Keep.back());
+        }
+        NtResumeThread(Handle, nullptr);
+      }
+      NtClose(Handle);
+      if (Done) {
+        ++Stats.Trimmed;
+        Stats.Moved += Keep.back().OldCodeBuffer != nullptr;
+        Now[TID].Trimmed = true;
+        Trimmed.push_back(Thread);
+      } else {
+        ++Stats.Skipped;
+      }
+    }
+
+    for (auto* Thread : Trimmed) {
+      CTX->FinishTrimmedThread(Thread);
+    }
+    for (auto& K : Keep) {
+      Stats.BuffersFreed += K.OldCodeBuffer && K.OldCodeBuffer.use_count() == 1;
+    }
+    Keep.clear();
+    LastPass = std::move(Now);
+    Stats.Ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - Began).count();
+    return Stats;
+  }
+
+  // The first pass waits at least this long, so no thread is suspended during process start.
+  constexpr uint32_t FirstPassMinS = 30;
+
+  void* WorkerMain(void*) {
+    for (uint64_t N = 0;; ++N) {
+      const uint32_t WaitS = N == 0 ? std::max(IntervalS, FirstPassMinS) : IntervalS;
+      LARGE_INTEGER Delay {.QuadPart = -int64_t(WaitS) * 10'000'000LL};
+      NtDelayExecution(FALSE, &Delay);
+      const auto S = Pass();
+      if (S.Trimmed || S.Skipped || N < 3 || N % 10 == 0) {
+        LogMan::Msg::IFmt("TrimIdleThreads: {} threads, {} newly idle, {} trimmed, {} skipped, {} moved to the newest code buffer, "
+                          "{} old code buffers freed, {:.1f} ms",
+                          S.Threads, S.Idle, S.Trimmed, S.Skipped, S.Moved, S.BuffersFreed, S.Ms);
+      }
+    }
+    return nullptr;
+  }
+
+  void ProcessInit() {
+    FEX_CONFIG_OPT(TrimIdleThreads, TRIMIDLETHREADS);
+    IntervalS = TrimIdleThreads();
+  }
+
+  // The worker is never created during process init, only once a second thread initializes, and outside FEX's locks.
+  void ThreadInit() {
+    static std::atomic<uint32_t> Inits {};
+    static std::atomic<bool> Started {};
+    if (!IntervalS || Inits.fetch_add(1) == 0 || Started.exchange(true)) {
+      return;
+    }
+    Worker = FEXCore::Threads::Thread::Create(WorkerMain, nullptr, {.LowPriority = true, .Internal = true}, "FEX idle trim");
+  }
+} // namespace IdleTrim

+bool ContextImpl::TrimSuspendedThread(FEXCore::Core::InternalThreadState* Thread, TrimmedThreadState& Keep) {
+  if (!Thread->CPUBackend || !Thread->LookupCache || !Thread->LookupCache->Shared ||
+      Thread->CurrentFrame->SignalHandlerRefCounter != 0 || Thread->CPUBackend->HasSignalHandlerCodeBuffers()) {
+    return false;
+  }
+  // Hold off invalidations: they touch other threads' caches and read their current map.
+  if (!CodeInvalidationMutex.try_lock()) {
+    return false;
+  }
+  // The thread's current map lives in its current code buffer, which stays alive in Keep until after the unlock.
+  const bool Trimmed = Thread->LookupCache->Shared->TryWithWriteLock([&](const LookupCacheWriteLockToken& lk) {
+    Thread->LookupCache->TrimLocked(Thread, lk);
+    auto Latest = GetLatest();
+    auto* LatestMap = Latest->LookupCache.get();
+    if (Thread->LookupCache->Shared != LatestMap) {
+      Keep.OldCodeBuffer = Thread->CPUBackend->MoveToCodeBuffer(std::move(Latest));
+      Thread->LookupCache->Shared = LatestMap;
+    }
+    // Return addresses into the old buffer must not be predicted any more.
+    Allocator::VirtualDontNeed(Thread->CallRetStackBase, FEXCore::Core::InternalThreadState::CALLRET_STACK_SIZE);
+  });
+  CodeInvalidationMutex.unlock();
+  return Trimmed;
+}
+
+void ContextImpl::FinishTrimmedThread(FEXCore::Core::InternalThreadState* Thread) {
+  Thread->LookupCache->ReleaseTrimmed();
+}
+
 void ContextImpl::InvalidateThreadCachedCodeRange(FEXCore::Core::InternalThreadState* Thread, uint64_t Start, uint64_t Length) {

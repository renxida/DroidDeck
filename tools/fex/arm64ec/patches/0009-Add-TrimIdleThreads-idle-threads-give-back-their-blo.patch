     L1PointerMask = MIN_L1_ENTRIES - 1;
@@ -102,6 +103,26 @@ void LookupCache::ClearThreadLocalCaches(const LookupCacheWriteLockToken&) {
   CachedCodePages.clear();
 }
 
+void LookupCache::TrimLocked(FEXCore::Core::InternalThreadState* Thread, const LookupCacheWriteLockToken&) {
+  FEXCore::Allocator::VirtualDontNeed(reinterpret_cast<void*>(PagePointer), TotalCacheSize, false);
+  AllocateOffset = 0;
+  // Swapping two maps with the same stateless allocator moves no nodes, so this neither allocates nor frees.
+  TrimmedCachedCodePages.swap(CachedCodePages);
+  if (DynamicL1Cache() && CurrentL1Entries != InitialL1Entries) {
+    CurrentL1Entries = InitialL1Entries;
+    L1PointerMask = CurrentL1Entries - 1;
+    Thread->CurrentFrame->State.L1Mask = GetScaledL1PointerMask();
+  }
+}
+
+void LookupCache::ReleaseTrimmed() {
+  TrimmedCachedCodePages.clear();
+  // Decommitting replaces the mappings, which drops their names.
+  FEXCore::Allocator::VirtualName("FEXMem_Lookup", reinterpret_cast<void*>(PagePointer),
+                                  VirtualMemSize / FEXCore::Utils::FEX_PAGE_SIZE * 8 + CODE_SIZE);
+  FEXCore::Allocator::VirtualName("FEXMem_Lookup_L1", reinterpret_cast<void*>(L1Pointer), MAX_L1_SIZE);
+}
+
 void LookupCache::ClearCache(const LookupCacheWriteLockToken& lk) {
   // Clear L1 and L2 by clearing the full cache.
   ClearThreadLocalCaches(lk);

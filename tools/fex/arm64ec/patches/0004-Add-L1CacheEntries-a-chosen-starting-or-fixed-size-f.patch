From b7f5bde5d105ca5d3b8b96b95646cff903f7d4be Mon Sep 17 00:00:00 2001
From: Kestrel <kestrel@users.noreply.github.com>
Date: Fri, 13 Nov 2026 05:08:21 +0000
Subject: [PATCH] Add L1CacheEntries: a chosen starting or fixed size for the
 JIT L1 cache

The dynamic L1 starts at 8k entries and grows one doubling per second of misses, flushing
on each resize; the fixed L1 is 1M entries (16 MB per thread, touched as used). This lets a
middle size be picked: fixed, or as the dynamic cache's starting point.
---
 FEXCore/Source/Interface/Config/Config.json.in | 10 ++++++++++
 FEXCore/Source/Interface/Core/LookupCache.cpp  |  9 ++++++++-
 FEXCore/Source/Interface/Core/LookupCache.h    |  1 +
 3 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/FEXCore/Source/Interface/Config/Config.json.in b/FEXCore/Source/Interface/Config/Config.json.in
index 126e7a7..b951382 100644
--- a/FEXCore/Source/Interface/Config/Config.json.in
+++ b/FEXCore/Source/Interface/Config/Config.json.in
@@ -350,6 +350,16 @@
           "Can potentially introduce more stutters."
         ]
       },
+      "L1CacheEntries": {
+        "Type": "uint64",
+        "Default": "0",
+        "AffectsCodeGen": "false",
+        "Desc": [
+          "Starting size of FEXCore's per-thread JIT L1 cache, in entries of 16 bytes (a power of two",
+          "between 8192 and 1048576). 0 keeps the default: the minimum when DynamicL1Cache is on,",
+          "the maximum when it is off. With DynamicL1Cache off this is the fixed size."
+        ]
+      },
       "DynamicL1CacheIncreaseCountHeuristic": {
         "Type": "uint64",
         "Default": "250",
diff --git a/FEXCore/Source/Interface/Core/LookupCache.cpp b/FEXCore/Source/Interface/Core/LookupCache.cpp
index 0b23030..133bc28 100644
--- a/FEXCore/Source/Interface/Core/LookupCache.cpp
+++ b/FEXCore/Source/Interface/Core/LookupCache.cpp
@@ -7,6 +7,9 @@ $end_info$
 */
 
 #include <FEXCore/Utils/Allocator.h>
+
+#include <algorithm>
+#include <bit>
 #include <FEXCore/Utils/LogManager.h>
 #include <FEXCore/HLE/SyscallHandler.h>
 
@@ -61,7 +64,11 @@ LookupCache::LookupCache(FEXCore::Context::ContextImpl* CTX)
 
   VirtualMemSize = ctx->Config.VirtualMemSize;
 
-  if (DynamicL1Cache()) {
+  if (const uint64_t Entries = L1CacheEntries()) {
+    // A chosen starting (or, with DynamicL1Cache off, fixed) size: clamped and rounded down to a power of two.
+    CurrentL1Entries = std::bit_floor(std::clamp<uint64_t>(Entries, MIN_L1_ENTRIES, MAX_L1_ENTRIES));
+    L1PointerMask = CurrentL1Entries - 1;
+  } else if (DynamicL1Cache()) {
     // Start at minimum size when dynamic.
     L1PointerMask = MIN_L1_ENTRIES - 1;
   } else {
diff --git a/FEXCore/Source/Interface/Core/LookupCache.h b/FEXCore/Source/Interface/Core/LookupCache.h
index 391d485..eb2ce0f 100644
--- a/FEXCore/Source/Interface/Core/LookupCache.h
+++ b/FEXCore/Source/Interface/Core/LookupCache.h
@@ -482,6 +482,7 @@ private:
   FEX_CONFIG_OPT(DynamicL1CacheDecreaseCountHeuristic, DYNAMICL1CACHEDECREASECOUNTHEURISTIC);
 
   FEX_CONFIG_OPT(DynamicL1Cache, DYNAMICL1CACHE);
+  FEX_CONFIG_OPT(L1CacheEntries, L1CACHEENTRIES);
   FEX_CONFIG_OPT(DisableL2Cache, DISABLEL2CACHE);
 };
 } // namespace FEXCore
-- 

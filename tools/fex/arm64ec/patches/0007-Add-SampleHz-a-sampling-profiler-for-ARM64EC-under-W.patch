+namespace FEX::Windows::Sampler {
+namespace {
+  constexpr uint32_t MainRows = 200;
+  constexpr uint32_t RestRows = 50;
+  constexpr uint32_t ThreadRows = 8;
+  constexpr uint64_t FlushIntervalMs = 60000;
+
+  uint32_t Hz {};
+  FEXSampleRecord* Ring {};
+  uint64_t* Head {};
+  uint64_t* HandlerTicks {};
+  uint64_t Capacity {};
+  uint32_t PID {};
+  std::atomic<bool> AggregatorStarted {};
+  fextl::unique_ptr<FEXCore::Threads::Thread> Aggregator;
+
+  std::mutex HandlesMutex;
+  fextl::unordered_map<FEXCore::Core::InternalThreadState*, void*> Handles;
+
+  bool SafeRead(uint64_t Address, void* Dest, size_t Size) {
+    FEXUnixLib_SamplerRead Args {.Address = Address, .Dest = Dest, .Size = Size};
+    return UnixLib::Call(FEXUnixLibFunctions::SamplerRead, &Args) == 0;
+  }
+
+  uint64_t TimerFrequency() {
+    uint64_t F;
+    asm volatile("mrs %0, cntfrq_el0" : "=r"(F));
+    return F ? F : 1;
+  }
+
+  uint64_t UnixTimeMs() {
+    LARGE_INTEGER T {};
+    NtQuerySystemTime(&T);
+    return (T.QuadPart - 116444736000000000LL) / 10000;
+  }
+
+  uint64_t OwnCPUTimeUs() {
+    KERNEL_USER_TIMES Times {};
+    if (NtQueryInformationThread(NtCurrentThread(), ThreadTimes, &Times, sizeof(Times), nullptr)) {
+      return 0;
+    }
+    return (Times.KernelTime.QuadPart + Times.UserTime.QuadPart) / 10;
+  }
+
+  // Where a sample was: in the thread's current translated block (JIT, exact guest instruction), elsewhere with a
+  // known last block (Out: FEX itself, a native ARM64EC DLL, Wine's unix side; guest = that block's entry), or with
+  // no block decodable (None: guest = the thread's last synced RIP).
+  enum class Kind : uint8_t { JIT, Out, None };
+
+  struct Key {
+    uint32_t TID;
+    Kind K;
+    uint64_t Guest;
+    uint64_t Host;
+    bool operator==(const Key&) const = default;
+  };
+  struct KeyHash {
+    size_t operator()(const Key& k) const {
+      uint64_t h = k.Guest * 0x9E3779B97F4A7C15ull ^ (k.Host + 0x632BE59BD9B4E019ull) * 0xC2B2AE3D27D4EB4Full;
+      return size_t(h ^ (uint64_t(k.TID) << 8) ^ uint64_t(k.K));
+    }
+  };
+  struct DecodeKey {
+    uint64_t Header, PC;
+    bool operator==(const DecodeKey&) const = default;
+  };
+  struct DecodeKeyHash {
+    size_t operator()(const DecodeKey& k) const {
+      return size_t(k.Header * 0x9E3779B97F4A7C15ull ^ k.PC * 0xC2B2AE3D27D4EB4Full);
+    }
+  };
+  struct Decoded {
+    uint64_t Guest;
+    Kind K;
+  };
+
+  struct Module {
+    fextl::string Name; // Empty: not an image.
+    uint64_t Base {};
+    bool Executable {};
+    fextl::vector<std::pair<uint32_t, fextl::string>> Exports; // Sorted by RVA.
+  };
+
+  std::mutex AggMutex;
+  uint64_t Tail {};
+  uint64_t Lost {};
+  uint64_t MinuteIndex {};
+  uint64_t LastHandlerTicks {};
+  uint64_t LastOwnUs {};
+  bool WroteHeader {};
+  fextl::unordered_map<Key, uint32_t, KeyHash> Counts;
+  fextl::unordered_map<DecodeKey, Decoded, DecodeKeyHash> DecodeCache;
+  fextl::unordered_map<uint64_t, fextl::unique_ptr<Module>> Modules;
+  Module NotAnImage;
+  Module NotAnImageExec;
+
+  void ParseExports(Module& M) {
+    IMAGE_DOS_HEADER Dos;
+    if (!SafeRead(M.Base, &Dos, sizeof(Dos)) || Dos.e_magic != IMAGE_DOS_SIGNATURE) {
+      return;
+    }
+    IMAGE_NT_HEADERS64 Nt;
+    if (!SafeRead(M.Base + Dos.e_lfanew, &Nt, sizeof(Nt)) || Nt.Signature != IMAGE_NT_SIGNATURE ||
+        Nt.OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR64_MAGIC) {
+      return;
+    }
+    const auto& Dir = Nt.OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT];
+    IMAGE_EXPORT_DIRECTORY Exp;
+    if (!Dir.VirtualAddress || !SafeRead(M.Base + Dir.VirtualAddress, &Exp, sizeof(Exp))) {
+      return;
+    }
+    const uint32_t Names = std::min<uint32_t>(Exp.NumberOfNames, 30000);
+    const uint32_t Functions = std::min<uint32_t>(Exp.NumberOfFunctions, 65536);
+    fextl::vector<uint32_t> NameRVAs(Names), FunctionRVAs(Functions);
+    fextl::vector<uint16_t> Ordinals(Names);
+    if (!Names || !SafeRead(M.Base + Exp.AddressOfNames, NameRVAs.data(), Names * 4) ||
+        !SafeRead(M.Base + Exp.AddressOfNameOrdinals, Ordinals.data(), Names * 2) ||
+        !SafeRead(M.Base + Exp.AddressOfFunctions, FunctionRVAs.data(), Functions * 4)) {
+      return;
+    }
+    M.Exports.reserve(Names);
+    for (uint32_t i = 0; i < Names; ++i) {
+      if (Ordinals[i] >= Functions) {
+        continue;
+      }
+      const uint32_t RVA = FunctionRVAs[Ordinals[i]];
+      if (RVA >= Dir.VirtualAddress && RVA < Dir.VirtualAddress + Dir.Size) {
+        continue; // Forwarder string, not code.
+      }
+      char Buf[128] {};
+      if (!SafeRead(M.Base + NameRVAs[i], Buf, sizeof(Buf) - 1) && !SafeRead(M.Base + NameRVAs[i], Buf, 32)) {
+        continue;
+      }
+      Buf[sizeof(Buf) - 1] = 0;
+      M.Exports.emplace_back(RVA, fextl::string(Buf));
+    }
+    std::sort(M.Exports.begin(), M.Exports.end(), [](const auto& a, const auto& b) { return a.first < b.first; });
+  }
+
+  const Module* FindModule(uint64_t Address) {
+    MEMORY_BASIC_INFORMATION Info {};
+    if (!Address || NtQueryVirtualMemory(NtCurrentProcess(), reinterpret_cast<void*>(Address), MemoryBasicInformation, &Info, sizeof(Info), nullptr)) {
+      return &NotAnImage;
+    }
+    if (Info.Type != MEM_IMAGE) {
+      constexpr DWORD Exec = PAGE_EXECUTE | PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY;
+      return (Info.Protect & Exec) ? &NotAnImageExec : &NotAnImage;
+    }
+    const uint64_t Base = reinterpret_cast<uint64_t>(Info.AllocationBase);
+    if (auto it = Modules.find(Base); it != Modules.end()) {
+      return it->second.get();
+    }
+    auto M = fextl::make_unique<Module>();
+    M->Base = Base;
+    M->Name = fextl::string(FEX::Windows::BaseName(FEX::Windows::GetSectionFilePath(Base)));
+    for (auto& c : M->Name) {
+      if (c == ',' || c == '\n' || c == '"') {
+        c = '_';
+      }
+    }
+    if (M->Name.empty()) {
+      M->Name = "image";
+    }
+    ParseExports(*M);
+    return Modules.emplace(Base, std::move(M)).first->second.get();
+  }
+
+  // module, offset, symbol
+  void Describe(fextl::string& Out, uint64_t Address, const Module* M) {
+    if (!Address) {
+      Out += ",,,";
+      return;
+    }
+    if (M->Name.empty()) {
+      Out += fextl::fmt::format(",anon,0x{:x},", Address);
+      return;
+    }
+    const uint64_t RVA = Address - M->Base;
+    Out += fextl::fmt::format(",{},0x{:x},", M->Name, RVA);
+    auto it = std::upper_bound(M->Exports.begin(), M->Exports.end(), RVA, [](uint64_t v, const auto& e) { return v < e.first; });
+    if (it != M->Exports.begin()) {
+      --it;
+      if (RVA - it->first < 0x100000) {
+        Out += fextl::fmt::format("{}+0x{:x}", it->second, RVA - it->first);
+      }
+    }
+  }
+
+  const char* KindName(Kind K, const Module* HostModule) {
+    if (K == Kind::JIT) {
+      return "jit";
+    }
+    if (!HostModule->Name.empty()) {
+      return HostModule->Name == "libarm64ecfex.dll" ? "fex" : "native";
+    }
+    return HostModule == &NotAnImageExec ? "jit-other" : "host";
+  }
+
+  void Account(const FEXSampleRecord& R) {
+    Decoded D {R.RIP, Kind::None};
+    if (R.BlockHeader) {
+      DecodeKey DK {R.BlockHeader, R.PC};
+      if (auto it = DecodeCache.find(DK); it != DecodeCache.end()) {
+        D = it->second;
+      } else {
+        uint64_t Guest {};
+        bool InBlock {};
+        if (FEXCore::Context::Context::DecodeSampledRIP(R.BlockHeader, R.PC, SafeRead, &Guest, &InBlock)) {
+          D = {Guest, InBlock ? Kind::JIT : Kind::Out};
+        }
+        if (DecodeCache.size() < 500000) {
+          DecodeCache.emplace(DK, D);
+        }
+      }
+    }
+    ++Counts[Key {R.TID, D.K, D.Guest, D.K == Kind::JIT ? 0 : R.PC}];
+  }
+
+  void Drain() {
+    const uint64_t H = __atomic_load_n(Head, __ATOMIC_ACQUIRE);
+    if (H - Tail > Capacity) {
+      Lost += H - Tail - Capacity;
+      Tail = H - Capacity;
+    }
+    while (Tail < H) {
+      const auto& Slot = Ring[Tail & (Capacity - 1)];
+      const uint64_t Seq = __atomic_load_n(&Slot.Seq, __ATOMIC_ACQUIRE);
+      if (Seq != Tail + 1) {
+        if (Seq > Tail + 1) {
+          ++Lost; // Overwritten by a newer lap.
+          ++Tail;
+          continue;
+        }
+        break; // Still being written.
+      }
+      FEXSampleRecord Copy = Slot;
+      __atomic_thread_fence(__ATOMIC_ACQUIRE);
+      if (__atomic_load_n(&Slot.Seq, __ATOMIC_RELAXED) != Seq) {
+        ++Lost;
+      } else {
+        Account(Copy);
+      }
+      ++Tail;
+    }
+  }
+
+  struct Row {
+    Kind K;
+    uint64_t Guest, Host;
+    uint32_t Count;
+  };
+
+  void TopRows(fextl::string& Out, const fextl::unordered_map<Key, uint32_t, KeyHash>& From, bool Main, uint32_t BusiestTID, uint32_t Limit,
+               uint64_t Minute, uint64_t Now) {
+    fextl::unordered_map<Key, uint32_t, KeyHash> Merged;
+    uint64_t Total = 0;
+    for (const auto& [k, n] : From) {
+      if ((k.TID == BusiestTID) != Main) {
+        continue;
+      }
+      Total += n;
+      Merged[Key {0, k.K, k.Guest, k.Host}] += n;
+    }
+    fextl::vector<Row> Rows;
+    Rows.reserve(Merged.size());
+    for (const auto& [k, n] : Merged) {
+      Rows.push_back({k.K, k.Guest, k.Host, n});
+    }
+    const size_t Keep = std::min<size_t>(Limit, Rows.size());
+    std::partial_sort(Rows.begin(), Rows.begin() + Keep, Rows.end(), [](const Row& a, const Row& b) { return a.Count > b.Count; });
+    for (size_t i = 0; i < Keep; ++i) {
+      const auto& r = Rows[i];
+      const Module* HostModule = r.K == Kind::JIT ? &NotAnImage : FindModule(r.Host);
+      Out += fextl::fmt::format("{},{},{},{},{},{},{},{:.4f},{}", Minute, Now, PID, Main ? "main" : "rest", Main ? BusiestTID : 0, i + 1,
+                                r.Count, double(r.Count) / double(Total ? Total : 1), KindName(r.K, HostModule));
+      Describe(Out, r.Guest, FindModule(r.Guest));
+      if (r.K == Kind::JIT) {
+        Out += ",,,";
+      } else {
+        Describe(Out, r.Host, HostModule);
+      }
+      Out += '\n';
+    }
+  }
+
+  void Flush() {
+    const uint64_t Now = UnixTimeMs();
+    fextl::string Out;
+    if (!WroteHeader) {
+      Out += "minute,t_unix_ms,pid,scope,tid,rank,samples,share,kind,guest_module,guest_offset,guest_symbol,host_module,host_offset,"
+             "host_symbol\n";
+      WroteHeader = true;
+    }
+    fextl::unordered_map<uint32_t, uint64_t> PerThread;
+    uint64_t Total = 0;
+    for (const auto& [k, n] : Counts) {
+      PerThread[k.TID] += n;
+      Total += n;
+    }
+    fextl::vector<std::pair<uint32_t, uint64_t>> Threads(PerThread.begin(), PerThread.end());
+    std::sort(Threads.begin(), Threads.end(), [](const auto& a, const auto& b) { return a.second > b.second; });
+    const uint32_t Busiest = Threads.empty() ? 0 : Threads[0].first;
+    for (size_t i = 0; i < Threads.size() && i < ThreadRows; ++i) {
+      Out += fextl::fmt::format("{},{},{},thread,{},{},{},{:.4f},,,,,,,\n", MinuteIndex, Now, PID, Threads[i].first, i + 1, Threads[i].second,
+                                double(Threads[i].second) / double(Total ? Total : 1));
+    }
+    if (Total) {
+      TopRows(Out, Counts, true, Busiest, MainRows, MinuteIndex, Now);
+      TopRows(Out, Counts, false, Busiest, RestRows, MinuteIndex, Now);
+    }
+    // Meta rows: kind names a counter, samples holds its value.
+    const uint64_t Ticks = __atomic_load_n(HandlerTicks, __ATOMIC_RELAXED);
+    const uint64_t HandlerUs = (Ticks - LastHandlerTicks) * 1000000 / TimerFrequency();
+    LastHandlerTicks = Ticks;
+    const uint64_t OwnUs = OwnCPUTimeUs();
+    const auto Meta = [&](const char* Name, uint64_t Value) {
+      Out += fextl::fmt::format("{},{},{},meta,0,0,{},,{},,,,,,\n", MinuteIndex, Now, PID, Value, Name);
+    };
+    Meta("hz", Hz);
+    Meta("samples", Total);
+    Meta("lost", Lost);
+    Meta("handler_us", HandlerUs);
+    Meta("aggregator_us", OwnUs - LastOwnUs);
+    LastOwnUs = OwnUs;
+    Lost = 0;
+
+    FEXUnixLib_SamplerWrite Args {.Data = Out.data(), .Size = Out.size()};
+    UnixLib::Call(FEXUnixLibFunctions::SamplerWrite, &Args);
+    Counts.clear();
+    DecodeCache.clear();
+    if (Modules.size() > 2048) {
+      Modules.clear();
+    }
+    ++MinuteIndex;
+  }
+
+  void* AggregatorMain(void*) {
+    uint64_t Elapsed = 0;
+    LastOwnUs = OwnCPUTimeUs();
+    for (;;) {
+      LARGE_INTEGER Delay {.QuadPart = -100 * 10000LL}; // 100 ms
+      NtDelayExecution(FALSE, &Delay);
+      std::scoped_lock Lock(AggMutex);
+      Drain();
+      Elapsed += 100;
+      if (Elapsed >= FlushIntervalMs) {
+        Elapsed = 0;
+        Flush();
+      }
+    }
+    return nullptr;
+  }
+} // namespace
+
+void ProcessInit() {
+  FEX_CONFIG_OPT(SampleHz, SAMPLEHZ);
+  Hz = SampleHz();
+  if (!Hz || !UnixLib::Available()) {
+    return;
+  }
+  FEXUnixLib_SamplerStart Args {
+    .Hz = Hz,
+    .FrameOffsetBlockHeader = uint32_t(offsetof(FEXCore::Core::CpuStateFrame, State) + offsetof(FEXCore::Core::CPUState, InlineJITBlockHeader)),
+    .FrameOffsetRIP = uint32_t(offsetof(FEXCore::Core::CpuStateFrame, State) + offsetof(FEXCore::Core::CPUState, rip)),
+  };
+  if (UnixLib::Call(FEXUnixLibFunctions::SamplerStart, &Args) || !Args.Ring || !Args.Capacity) {
+    LogMan::Msg::IFmt("Sampler: not available");
+    Hz = 0;
+    return;
+  }
+  Ring = Args.Ring;
+  Head = Args.Head;
+  HandlerTicks = Args.HandlerTicks;
+  Capacity = Args.Capacity;
+  PID = UnixLib::GetPID();
+}
+
+void ThreadInit(FEXCore::Core::InternalThreadState* Thread) {
+  if (!Ring) {
+    return;
+  }
+  FEXUnixLib_SamplerThread Args {.Frame = Thread->CurrentFrame};
+  if (UnixLib::Call(FEXUnixLibFunctions::SamplerThreadStart, &Args) == 0) {
+    std::scoped_lock Lock(HandlesMutex);
+    Handles[Thread] = Args.Handle;
+  }
+  if (!AggregatorStarted.exchange(true)) {
+    Aggregator = FEXCore::Threads::Thread::Create(AggregatorMain, nullptr, {.LowPriority = false, .Internal = true}, "FEX sampler");
+  }
+}
+
+void ThreadTerm(FEXCore::Core::InternalThreadState* Thread) {
+  if (!Ring) {
+    return;
+  }
+  void* Handle {};
+  {
+    std::scoped_lock Lock(HandlesMutex);
+    auto it = Handles.find(Thread);
+    if (it == Handles.end()) {
+      return;
+    }
+    Handle = it->second;
+    Handles.erase(it);
+  }
+  FEXUnixLib_SamplerThread Args {.Frame = Thread->CurrentFrame, .Handle = Handle};
+  UnixLib::Call(FEXUnixLibFunctions::SamplerThreadStop, &Args);
+}
+
+void ProcessTerm() {
+  if (!Ring) {
+    return;
+  }
+  std::unique_lock Lock(AggMutex, std::try_to_lock);
+  if (!Lock.owns_lock()) {
+    return;
+  }
+  Drain();
+  Flush();
+}
+} // namespace FEX::Windows::Sampler

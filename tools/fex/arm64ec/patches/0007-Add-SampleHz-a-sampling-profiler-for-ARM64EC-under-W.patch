+bool Context::DecodeSampledRIP(uint64_t BlockHeader, uint64_t HostPC, SampleReadFn Read, uint64_t* GuestRIP, bool* InBlock) {
+  *InBlock = false;
+  CPU::CPUBackend::JITCodeHeader Header {};
+  CPU::CPUBackend::JITCodeTail Tail {};
+  if (!BlockHeader || !Read(BlockHeader, &Header, sizeof(Header)) || !Read(BlockHeader + Header.OffsetToBlockTail, &Tail, sizeof(Tail))) {
+    return false;
+  }
+  *GuestRIP = Tail.RIP;
+  if (HostPC < BlockHeader || HostPC >= BlockHeader + Tail.Size) {
+    return true;
+  }
+  *InBlock = true;
+
+  // RIP entries, as in RestoreRIPFromHostPC; zero padding keeps the last decode inside the buffer.
+  constexpr size_t MaxEntryBytes = 4096;
+  constexpr size_t Pad = 32;
+  uint8_t Entries[MaxEntryBytes + Pad] {};
+  const uint64_t EntriesAddr = BlockHeader + Header.OffsetToBlockTail + Tail.OffsetToRIPEntries;
+  size_t Want = std::min<size_t>(MaxEntryBytes, size_t {Tail.NumberOfRIPEntries} * 17);
+  while (Want && !Read(EntriesAddr, Entries, Want)) {
+    Want /= 2;
+  }
+  if (!Want) {
+    return true;
+  }
+  const uint8_t* Ptr = Entries;
+  uint64_t StartingHostPC = BlockHeader;
+  uint64_t StartingGuestRIP = Tail.RIP;
+  for (uint32_t i = 0; i < Tail.NumberOfRIPEntries && Ptr < Entries + Want; ++i) {
+    auto Offset = FEXCore::Utils::vl64pair::Decode(Ptr);
+    Ptr += Offset.Size;
+    if (HostPC < StartingHostPC + Offset.IntegerARMPC) {
+      break;
+    }
+    StartingHostPC += Offset.IntegerARMPC;
+    StartingGuestRIP += Offset.IntegerX86RIP;
+  }
+  *GuestRIP = StartingGuestRIP;
+  return true;
+}

+// Sampling profiler (config SampleHz). Each emulated thread gets a timer on its own CPU time that sends SIGPROF;
+// the handler records where the thread was into a shared ring that the PE side drains and symbolizes.
+struct FEXSampleRecord {
+  uint64_t Seq; // Index + 1 once the record is complete.
+  uint64_t PC;  // Host PC at the signal.
+  uint64_t BlockHeader; // The thread's CPUState::InlineJITBlockHeader: the last translated block it entered.
+  uint64_t RIP;         // The thread's CPUState::rip.
+  uint32_t TID;         // Linux TID.
+  uint32_t Flags;
+};
+static_assert(sizeof(FEXSampleRecord) == 40);
+
+struct FEXUnixLib_SamplerStart {
+  uint32_t Hz;
+  uint32_t FrameOffsetBlockHeader; // Offsets into CpuStateFrame.
+  uint32_t FrameOffsetRIP;
+  uint32_t Capacity; // Out: records in the ring (a power of two).
+  FEXSampleRecord* Ring; // Out.
+  uint64_t* Head;        // Out: records written so far.
+  uint64_t* HandlerTicks; // Out: generic-timer ticks spent in the signal handler.
+};
+static_assert(sizeof(FEXUnixLib_SamplerStart) == 40);
+
+struct FEXUnixLib_SamplerThread {
+  void* Frame;  // SamplerThreadStart: the calling thread's CpuStateFrame.
+  void* Handle; // Out from SamplerThreadStart, in to SamplerThreadStop.
+};
+static_assert(sizeof(FEXUnixLib_SamplerThread) == 16);
+
+struct FEXUnixLib_SamplerWrite {
+  const char* Data;
+  uint64_t Size;
+};
+static_assert(sizeof(FEXUnixLib_SamplerWrite) == 16);
+
+// Copies memory that may have been unmapped since it was sampled; fails instead of faulting.
+struct FEXUnixLib_SamplerRead {
+  uint64_t Address;
+  void* Dest;
+  uint64_t Size;
+};
+static_assert(sizeof(FEXUnixLib_SamplerRead) == 24);
diff --git a/Source/Windows/UnixLib/Sampler.h b/Source/Windows/UnixLib/Sampler.h
new file mode 100644
index 0000000..22e3ca0
--- /dev/null
+++ b/Source/Windows/UnixLib/Sampler.h
@@ -0,0 +1,219 @@
+// SPDX-License-Identifier: MIT
+// Unix side of FEX's sampling profiler: per-thread CPU-time timers deliver SIGPROF to the thread that used the time,
+// and the handler records the interrupted PC plus the thread's last translated block into a lock-free ring.
+// Header-only so a host test can build the same handler.
+#pragma once
+#include <atomic>
+#include <cerrno>
+#include <csignal>
+#include <cstdint>
+#include <cstring>
+#include <ctime>
+#include <fcntl.h>
+#include <string>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <ucontext.h>
+#include <unistd.h>
+
+#include "FEXUnixLib.h"
+
+namespace FEXSampler {
+struct ThreadSlot {
+  std::atomic<uint32_t> InUse;
+  uint32_t TID;
+  const uint8_t* volatile Frame;
+  timer_t Timer;
+};
+
+static constexpr size_t MaxThreads = 4096;
+static constexpr uint32_t RingLog2 = 16; // 64k records, 2.5 MB
+static ThreadSlot Slots[MaxThreads];
+static FEXSampleRecord* Ring;
+static uint64_t Mask;
+static std::atomic<uint64_t> Head;
+static std::atomic<uint64_t> HandlerTicks;
+static uint32_t OffHeader, OffRIP;
+static long IntervalNs;
+static struct sigaction Previous;
+
+static inline uint64_t Ticks() {
+#if defined(__aarch64__)
+  uint64_t V;
+  asm volatile("mrs %0, cntvct_el0" : "=r"(V));
+  return V;
+#else
+  timespec T;
+  clock_gettime(CLOCK_MONOTONIC, &T);
+  return uint64_t(T.tv_sec) * 1000000000ull + T.tv_nsec;
+#endif
+}
+
+static inline uint64_t ContextPC(void* UC) {
+  auto Context = reinterpret_cast<ucontext_t*>(UC);
+#if defined(__aarch64__)
+  return Context->uc_mcontext.pc;
+#elif defined(__x86_64__)
+  return Context->uc_mcontext.gregs[REG_RIP];
+#else
+  return 0;
+#endif
+}
+
+static void OnSignal(int Signal, siginfo_t* Info, void* UC) {
+  auto Slot = reinterpret_cast<ThreadSlot*>(Info->si_value.sival_ptr);
+  if (Info->si_code != SI_TIMER || Slot < Slots || Slot >= Slots + MaxThreads || !Ring) {
+    // Not ours: pass it on to whoever had SIGPROF before.
+    if ((Previous.sa_flags & SA_SIGINFO) && Previous.sa_sigaction) {
+      Previous.sa_sigaction(Signal, Info, UC);
+    } else if (Previous.sa_handler != SIG_DFL && Previous.sa_handler != SIG_IGN && Previous.sa_handler) {
+      Previous.sa_handler(Signal);
+    }
+    return;
+  }
+  const uint64_t Start = Ticks();
+  const uint64_t Index = Head.fetch_add(1, std::memory_order_relaxed);
+  auto& R = Ring[Index & Mask];
+  // Mark the slot as being rewritten first, so a reader that copies it mid-write sees the sequence change.
+  __atomic_store_n(&R.Seq, 0, __ATOMIC_RELAXED);
+  __atomic_thread_fence(__ATOMIC_RELEASE);
+  R.PC = ContextPC(UC);
+  R.TID = Slot->TID;
+  R.Flags = 0;
+  const uint8_t* Frame = __atomic_load_n(&Slot->Frame, __ATOMIC_ACQUIRE);
+  R.BlockHeader = Frame ? __atomic_load_n(reinterpret_cast<const uint64_t*>(Frame + OffHeader), __ATOMIC_RELAXED) : 0;
+  R.RIP = Frame ? __atomic_load_n(reinterpret_cast<const uint64_t*>(Frame + OffRIP), __ATOMIC_RELAXED) : 0;
+  __atomic_store_n(&R.Seq, Index + 1, __ATOMIC_RELEASE);
+  HandlerTicks.fetch_add(Ticks() - Start, std::memory_order_relaxed);
+}
+
+static inline bool Start(FEXUnixLib_SamplerStart* Args) {
+  if (!Ring) {
+    if (Args->Hz == 0 || Args->Hz > 10000) {
+      return false;
+    }
+    const size_t Bytes = sizeof(FEXSampleRecord) << RingLog2;
+    void* Mem = mmap(nullptr, Bytes, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (Mem == MAP_FAILED) {
+      return false;
+    }
+    OffHeader = Args->FrameOffsetBlockHeader;
+    OffRIP = Args->FrameOffsetRIP;
+    IntervalNs = 1000000000L / Args->Hz;
+    Mask = (1ull << RingLog2) - 1;
+    struct sigaction Action {};
+    Action.sa_sigaction = OnSignal;
+    Action.sa_flags = SA_SIGINFO | SA_RESTART | SA_ONSTACK;
+    sigemptyset(&Action.sa_mask);
+    if (sigaction(SIGPROF, &Action, &Previous) != 0) {
+      munmap(Mem, Bytes);
+      return false;
+    }
+    Ring = reinterpret_cast<FEXSampleRecord*>(Mem);
+  }
+  Args->Capacity = uint32_t(Mask + 1);
+  Args->Ring = Ring;
+  Args->Head = reinterpret_cast<uint64_t*>(&Head);
+  Args->HandlerTicks = reinterpret_cast<uint64_t*>(&HandlerTicks);
+  return true;
+}
+
+// Runs on the thread to sample: its timer counts that thread's CPU time only.
+static inline ThreadSlot* StartThread(const void* Frame) {
+  if (!Ring) {
+    return nullptr;
+  }
+  for (auto& Slot : Slots) {
+    uint32_t Free = 0;
+    if (!Slot.InUse.compare_exchange_strong(Free, 1)) {
+      continue;
+    }
+    Slot.TID = uint32_t(syscall(SYS_gettid));
+    Slot.Frame = reinterpret_cast<const uint8_t*>(Frame);
+    struct sigevent Event {};
+    Event.sigev_notify = SIGEV_THREAD_ID;
+    Event.sigev_signo = SIGPROF;
+    Event.sigev_value.sival_ptr = &Slot;
+#ifdef sigev_notify_thread_id
+    Event.sigev_notify_thread_id = Slot.TID;
+#else
+    Event._sigev_un._tid = Slot.TID;
+#endif
+    if (timer_create(CLOCK_THREAD_CPUTIME_ID, &Event, &Slot.Timer) != 0) {
+      Slot.Frame = nullptr;
+      Slot.InUse.store(0);
+      return nullptr;
+    }
+    // Start at a per-thread offset into the period so threads created together don't sample in lockstep.
+    struct itimerspec Spec {};
+    Spec.it_interval.tv_nsec = IntervalNs % 1000000000L;
+    Spec.it_interval.tv_sec = IntervalNs / 1000000000L;
+    Spec.it_value.tv_nsec = 1 + (Slot.TID * 7919L) % IntervalNs;
+    timer_settime(Slot.Timer, 0, &Spec, nullptr);
+    return &Slot;
+  }
+  return nullptr;
+}
+
+static inline void StopThread(ThreadSlot* Slot) {
+  if (Slot < Slots || Slot >= Slots + MaxThreads || !Slot->InUse.load()) {
+    return;
+  }
+  timer_delete(Slot->Timer);
+  __atomic_store_n(&Slot->Frame, nullptr, __ATOMIC_RELEASE);
+  Slot->InUse.store(0);
+}
+
+// A write() from a bad address fails with EFAULT instead of faulting, so a pipe makes a safe memcpy from any
+// syscall-only sandbox. Called from one thread at a time (the PE side's sampler thread).
+static int ReadPipe[2] = {-1, -1};
+static inline bool SafeRead(uint64_t Address, void* Dest, size_t Size) {
+  if (ReadPipe[0] < 0 && pipe2(ReadPipe, O_CLOEXEC | O_NONBLOCK) != 0) {
+    ReadPipe[0] = ReadPipe[1] = -1;
+    return false;
+  }
+  auto Out = reinterpret_cast<uint8_t*>(Dest);
+  while (Size) {
+    const size_t Chunk = Size < 4096 ? Size : 4096;
+    ssize_t N = write(ReadPipe[1], reinterpret_cast<const void*>(Address), Chunk);
+    if (N <= 0) {
+      return false;
+    }
+    ssize_t Got = 0;
+    while (Got < N) {
+      ssize_t R = read(ReadPipe[0], Out + Got, size_t(N - Got));
+      if (R <= 0) {
+        return false;
+      }
+      Got += R;
+    }
+    Out += N;
+    Address += uint64_t(N);
+    Size -= size_t(N);
+  }
+  return true;
+}
+
+static inline bool Write(const char* Data, size_t Size) {
+  const std::string Name = "/dev/shm/fex-" + std::to_string(getpid()) + "-samples.csv";
+  int FD = open(Name.c_str(), O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0666);
+  if (FD < 0) {
+    return false;
+  }
+  bool OK = true;
+  while (Size) {
+    ssize_t N = write(FD, Data, Size);
+    if (N < 0 && errno == EINTR) {
+      continue;
+    }
+    if (N <= 0) {
+      OK = false;
+      break;
+    }
+    Data += N;
+    Size -= size_t(N);
+  }
+  close(FD);
+  return OK;
+}
+} // namespace FEXSampler

+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef HYBRIS_HANDLE_MAP_H
+#define HYBRIS_HANDLE_MAP_H
+#include <stdint.h>
+#include <stdlib.h>
+
+/* Open-addressed index from a Vulkan handle to its compat record, kept beside
+ * the owning list so hot recording hooks need not walk every live object.
+ * Callers serialize all access with the lock that guards the list. A removed
+ * entry keeps its key with a null value until the next rehash. If memory runs
+ * out the map marks itself broken and callers walk their list from then on. */
+struct hybris_handle_map {
+    uint64_t *keys;
+    void **values;
+    uint32_t capacity, used, count;
+    int broken;
+};
+
+static inline uint64_t hybris_handle_key(const void *handle) { return (uint64_t)(uintptr_t)handle; }
+
+static inline uint32_t hybris_handle_slot(uint64_t key, uint32_t mask)
+{
+    key ^= key >> 33;
+    key *= 0xff51afd7ed558ccdull;
+    key ^= key >> 33;
+    return (uint32_t)key & mask;
+}
+
+static inline void *hybris_handle_map_get(const struct hybris_handle_map *map, uint64_t key)
+{
+    if (!map->capacity || !key) return NULL;
+    uint32_t mask = map->capacity - 1;
+    for (uint32_t i = hybris_handle_slot(key, mask);; i = (i + 1) & mask) {
+        if (!map->keys[i]) return NULL;
+        if (map->keys[i] == key) return map->values[i];
+    }
+}
+
+static inline int hybris_handle_map_rehash(struct hybris_handle_map *map, uint32_t capacity)
+{
+    uint64_t *keys = calloc(capacity, sizeof(*keys));
+    void **values = calloc(capacity, sizeof(*values));
+    if (!keys || !values) { free(keys); free(values); return 0; }
+    for (uint32_t i = 0; i < map->capacity; ++i) {
+        if (!map->keys[i] || !map->values[i]) continue;
+        uint32_t slot = hybris_handle_slot(map->keys[i], capacity - 1);
+        while (keys[slot]) slot = (slot + 1) & (capacity - 1);
+        keys[slot] = map->keys[i];
+        values[slot] = map->values[i];
+    }
+    free(map->keys);
+    free(map->values);
+    map->keys = keys;
+    map->values = values;
+    map->capacity = capacity;
+    map->used = map->count;
+    return 1;
+}
+
+static inline void hybris_handle_map_put(struct hybris_handle_map *map, uint64_t key, void *value)
+{
+    if (map->broken || !key || !value) return;
+    if ((uint64_t)(map->used + 1) * 4 > (uint64_t)map->capacity * 3) {
+        uint32_t capacity = map->capacity ? map->capacity : 64;
+        while ((uint64_t)(map->count + 1) * 2 > capacity && capacity < (1u << 30)) capacity *= 2;
+        if (!hybris_handle_map_rehash(map, capacity)) { map->broken = 1; return; }
+    }
+    uint32_t mask = map->capacity - 1, tombstone = UINT32_MAX;
+    for (uint32_t i = hybris_handle_slot(key, mask);; i = (i + 1) & mask) {
+        if (map->keys[i] == key) {
+            if (!map->values[i]) ++map->count;
+            map->values[i] = value;
+            return;
+        }
+        if (!map->keys[i]) {
+            if (tombstone != UINT32_MAX) i = tombstone;
+            else ++map->used;
+            map->keys[i] = key;
+            map->values[i] = value;
+            ++map->count;
+            return;
+        }
+        if (!map->values[i] && tombstone == UINT32_MAX) tombstone = i;
+    }
+}
+
+static inline void hybris_handle_map_remove(struct hybris_handle_map *map, uint64_t key)
+{
+    if (map->broken || !map->capacity || !key) return;
+    uint32_t mask = map->capacity - 1;
+    for (uint32_t i = hybris_handle_slot(key, mask); map->keys[i]; i = (i + 1) & mask)
+        if (map->keys[i] == key) {
+            if (map->values[i]) --map->count;
+            map->values[i] = NULL;
+            return;
+        }
+}
+
+static inline void hybris_handle_map_free(struct hybris_handle_map *map)
+{
+    free(map->keys);
+    free(map->values);
+    *map = (struct hybris_handle_map){0};
+}
+#endif

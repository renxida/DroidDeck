+void CVulkanTexture::invalidateMappedData()
+{
+	if ( m_vkNonCoherentMemory == VK_NULL_HANDLE )
+		return;
+	VkMappedMemoryRange range = {
+		.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE,
+		.memory = m_vkNonCoherentMemory,
+		.offset = 0,
+		.size = VK_WHOLE_SIZE,
+	};
+	VkResult res = g_device.vk.InvalidateMappedMemoryRanges( g_device.device(), 1, &range );
+	if ( res != VK_SUCCESS )
+		vk_errorf( res, "vkInvalidateMappedMemoryRanges failed" );
+}

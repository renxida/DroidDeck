--- /dev/null
+++ b/src/mappable_memory_type.hpp
@@ -0,0 +1,32 @@
+#pragma once
+#include <vulkan/vulkan_core.h>
+#include <cstdint>
+
+namespace gamescope
+{
+// A mappable texture asks for HOST_VISIBLE|HOST_COHERENT|HOST_CACHED. When no type has all three,
+// drop HOST_CACHED, then HOST_COHERENT (the reader must then invalidate the mapping). Returns the
+// type index, or -1; *pChosen gets the properties that were matched.
+inline int32_t MappableMemoryTypeFallback( const VkPhysicalDeviceMemoryProperties &memory,
+    VkMemoryPropertyFlags properties, uint32_t typeBits, VkMemoryPropertyFlags *pChosen )
+{
+    if ( !( properties & VK_MEMORY_PROPERTY_HOST_CACHED_BIT ) )
+        return -1;
+    auto find = [&]( VkMemoryPropertyFlags wanted ) -> int32_t
+    {
+        for ( uint32_t i = 0; i < memory.memoryTypeCount; i++ )
+        {
+            if ( ( typeBits & ( 1u << i ) ) && ( memory.memoryTypes[ i ].propertyFlags & wanted ) == wanted )
+            {
+                *pChosen = wanted;
+                return int32_t( i );
+            }
+        }
+        return -1;
+    };
+    int32_t nType = find( properties & ~VK_MEMORY_PROPERTY_HOST_CACHED_BIT );
+    if ( nType < 0 && ( properties & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT ) )
+        nType = find( properties & ~VK_MEMORY_PROPERTY_HOST_COHERENT_BIT );
+    return nType;
+}
+}

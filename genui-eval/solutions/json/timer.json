{"state":{"left":180,"running":false},
 "view":{"type":"column","children":[
  {"type":"text","style":"title","value":"Tea timer"},
  {"type":"timer","running":"=running","every":1000,"do":[{"set":{"left":"=max(0,left-1)"}},{"set":{"running":"=running&&left>0"}}]},
  {"type":"card","style":{"alignItems":"center","padding":"28px 14px"},"children":[
    {"type":"text","style":"big","id":"time","value":"{{fmt.dur(left)}}","style":{"fontSize":"56px"}},
    {"type":"progress","value":"=left/180","style":{"width":"100%"}}]},
  {"type":"row","children":[
    {"type":"button","id":"start","label":"=running?'Pause':(left===0?'Done':(left<180?'Resume':'Start'))","disabled":"=left===0","action":{"toggle":"running"},"style":{"flex":"1"}},
    {"type":"button","id":"reset","variant":"ghost","label":"Reset","action":{"set":{"left":180,"running":false}},"style":{"flex":"1"}}]}]}}
